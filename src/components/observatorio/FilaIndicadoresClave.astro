---
/**
 * FilaIndicadoresClave — Fila de 4 indicadores clave agrupados por ritmo de
 * publicación ("Cada mes" o "Cada año") sobre un eje de tiempo compartido
 * (spec 008, contrato sección 1).
 */
import IndicadorClaveCard from "./IndicadorClaveCard.astro";
import type { FilaIndicadores } from "../../lib/observatorio/home";

interface Props {
  fila: FilaIndicadores;
}

const { fila } = Astro.props;
const tituloId = `fila-${fila.ritmo}-titulo`;
---

<section
  class="fila-kpi"
  data-fila-indicadores={fila.ritmo}
  aria-labelledby={tituloId}
>
  <header class="fila-kpi__head">
    <h3 class="fila-kpi__titulo" id={tituloId}>{fila.titulo}</h3>
    <p class="fila-kpi__ventana">{fila.ventanaTexto}</p>
    {fila.ritmo === "mensual" && (
      <p class="fila-kpi__pista" data-kpi-pista hidden>
        Recorre un gráfico ←/→ y toda la fila lee la misma fecha
      </p>
    )}
  </header>

  <div class="fila-kpi__grilla">
    {fila.indicadores.map((ind) => (
      <IndicadorClaveCard indicador={ind} />
    ))}
  </div>
</section>

<style>
  .fila-kpi {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .fila-kpi + .fila-kpi {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .fila-kpi__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .fila-kpi__titulo {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .fila-kpi__ventana {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .fila-kpi__pista {
    margin: 0 0 0 auto;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .fila-kpi__pista[hidden] {
    display: none;
  }

  .fila-kpi__grilla {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 1024px) {
    .fila-kpi__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fila-kpi__pista {
      margin-left: 0;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .fila-kpi__grilla {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
