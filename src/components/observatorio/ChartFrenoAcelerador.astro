---
import type { SerieFila } from "../../lib/observatorio/types";
import { baseLayout, periodoToISODate } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  serie: SerieFila[];
}

const { serie } = Astro.props;

const data = serie.filter((r) => r.inflacion_anual !== null && r.tasa_interes !== null);

const x = data.map((r) => periodoToISODate(r.periodo));
const inflacionVal = data.map((r) => r.inflacion_anual as number);
const tasaVal = data.map((r) => r.tasa_interes as number);

// Enfoque del script Python: usar max/min para nunca tener nulls
const tasaRestrictiva = data.map((r) => Math.max(r.tasa_interes!, r.inflacion_anual!));
const tasaExpansiva = data.map((r) => Math.min(r.tasa_interes!, r.inflacion_anual!));

const traces = [
  // ── Traza base invisible: inflación (línea de referencia para tonexty) ──
  {
    x,
    y: inflacionVal,
    mode: "lines",
    line: { width: 0 },
    showlegend: false,
    hoverinfo: "skip" as const,
  },
  // ── Sombreado ROJO: Tasa > Inflación (Política Contractiva / Freno) ──
  {
    name: "Tasa > Inflación (freno, tasa real positiva)",
    x,
    y: tasaRestrictiva,
    mode: "lines",
    fill: "tonexty" as const,
    fillcolor: "rgba(214, 39, 40, 0.25)",
    line: { width: 0 },
    hoverinfo: "skip" as const,
  },
  // ── Reset de base: otra inflación invisible ──
  {
    x,
    y: inflacionVal,
    mode: "lines",
    line: { width: 0 },
    showlegend: false,
    hoverinfo: "skip" as const,
  },
  // ── Sombreado VERDE: Inflación > Tasa (Política Expansiva / Acelerador) ──
  {
    name: "Inflación > Tasa (acelerador, tasa real negativa)",
    x,
    y: tasaExpansiva,
    mode: "lines",
    fill: "tonexty" as const,
    fillcolor: "rgba(0, 180, 80, 0.25)",
    line: { width: 0 },
    hoverinfo: "skip" as const,
  },
  // ── Líneas principales ENCIMA de los sombreados ──
  {
    name: "Tasa BanRep",
    x,
    y: tasaVal,
    mode: "lines",
    line: { color: "#2563eb", width: 2.2, shape: "hv" },
    hovertemplate: "<b>%{x|%b %Y}</b><br>Tasa BanRep: %{y:.2f}%<extra></extra>",
  },
  {
    name: "Inflación anual",
    x,
    y: inflacionVal,
    mode: "lines",
    line: { color: "#dc2626", width: 2.2 },
    hovertemplate: "<b>%{x|%b %Y}</b><br>Inflación anual: %{y:.2f}%<extra></extra>",
  },
];

const layout = baseLayout({
  margin: { l: 48, r: 24, t: 16, b: 48 },
  showlegend: true,
  legend: {
    orientation: "h",
    yanchor: "bottom",
    y: 1.04,
    xanchor: "left",
    x: 0,
    font: { size: 11 },
    bgcolor: "rgba(0,0,0,0)",
  },
  hovermode: "x unified",
});
---

<ChartContainer
  titulo="¿Está el Banco frenando o acelerando la economía?"
  pregunta="Cuando la tasa BanRep supera a la inflación anual, hay tasa real positiva (freno). Cuando la inflación supera a la tasa, hay tasa real negativa (acelerador)."
  fuenteTexto="Cálculo propio sobre DANE (IPC) y Banco de la República (TPM)"
>
  <PlotlyChart
    id="freno-acelerador"
    traces={traces}
    layout={layout}
    height={460}
    ariaLabel="Evolución comparada de la inflación anual y la tasa de intervención BanRep, con áreas coloreadas indicando freno o acelerador monetario"
  />

  <div class="freno-callout" slot="footer-extra">
    <div class="freno-callout__legend">
      <span class="freno-callout__swatch freno-callout__swatch--freno" aria-hidden="true"></span>
      <span class="freno-callout__label">Freno: <strong>tasa real positiva</strong></span>
    </div>
    <div class="freno-callout__legend">
      <span class="freno-callout__swatch freno-callout__swatch--acelerador" aria-hidden="true"></span>
      <span class="freno-callout__label">Acelerador: <strong>tasa real negativa</strong></span>
    </div>
  </div>
</ChartContainer>

<style>
  .freno-callout {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .freno-callout__legend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .freno-callout__swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .freno-callout__swatch--freno {
    background: rgba(214, 39, 40, 0.35);
    border: 1px solid rgba(214, 39, 40, 0.5);
  }

  .freno-callout__swatch--acelerador {
    background: rgba(0, 180, 80, 0.35);
    border: 1px solid rgba(0, 180, 80, 0.5);
  }

  .freno-callout__label strong {
    color: var(--color-text-secondary);
    font-weight: 600;
  }
</style>
