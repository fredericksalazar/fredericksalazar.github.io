---
import type { EmpleoSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  serie: EmpleoSerieFila[];
  embedded?: boolean;
}

const { serie, embedded = false } = Astro.props;

const filtered = serie.filter((r) => r.periodo >= "2000-01");
const tgp = extractSerie(filtered, "tgp");
const to = extractSerie(filtered, "to");

const brecha = tgp.y.map((v, i) =>
  v !== null && to.y[i] !== null ? v - to.y[i] : null,
);

// Filtrar pares x,y sin nulls
const pares = tgp.x.map((x, i) => ({ x, y: brecha[i] })).filter((p) => p.y !== null);

const traces = [
  {
    name: "Brecha laboral",
    x: pares.map((p) => p.x),
    y: pares.map((p) => p.y),
    type: "bar" as const,
    marker: {
      color: pares.map((p) => (p.y! > 10 ? "#dc2626" : p.y! > 8 ? "#f59e0b" : "#2563eb")),
      line: { color: "rgba(0,0,0,0.05)", width: 0.5 },
    },
    hovertemplate: "<b>%{x|%b %Y}</b><br>Brecha TGP − TO: %{y:.2f} pp<extra></extra>",
  },
];

const layout = baseLayout({
  showlegend: false,
  margin: { l: 48, r: 24, t: 16, b: 40 },
  hovermode: "x" as const,
});
---

<ChartContainer
  titulo="Brecha laboral (TGP − TO)"
  pregunta="Diferencia entre participación y ocupación. Una brecha alta indica que mucha gente busca trabajo pero no lo encuentra. Colores: azul = baja (<8 pp), ámbar = media (8-10 pp), rojo = alta (>10 pp)."
  fuenteTexto="Cálculo propio sobre DANE — GEIH"
  embedded={embedded}
>
  <PlotlyChart
    id="brecha-laboral"
    traces={traces}
    layout={layout}
    height={380}
    ariaLabel="Brecha entre TGP y Tasa de Ocupación mensual"
  />
</ChartContainer>
