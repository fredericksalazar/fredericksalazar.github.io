---
import type { Fuente } from "../../lib/observatorio/types";
import { formatFechaActualizacion } from "../../lib/observatorio/formatters";

interface Definicion {
  titulo: string;
  texto: string;
}

interface Props {
  fuentes: Fuente[];
  ultimaActualizacion: string;
  definiciones?: Definicion[];
  cobertura?: string;
}

const { fuentes, ultimaActualizacion, definiciones = [], cobertura } = Astro.props;
const fechaActualizacion = formatFechaActualizacion(ultimaActualizacion);
const anioCita = ultimaActualizacion.slice(0, 4);
const citaSugerida = `Salazar, F. (${anioCita}). Observatorio de Datos de Colombia. Recuperado de https://fredericksalazar.github.io/observatorio/ (Licencia CC BY 4.0).`;
---

<footer class="dashboard-footer" aria-label="Metodología y fuentes">
  <div class="dashboard-footer__inner">
    <div class="dashboard-footer__cell">
      <p class="dashboard-footer__label">Definiciones</p>
      {definiciones.length > 0 ? (
        definiciones.map((d) => (
          <p class="dashboard-footer__text">
            <strong>{d.titulo}</strong> &mdash; {d.texto}
          </p>
        ))
      ) : (
        <p class="dashboard-footer__text">—</p>
      )}
    </div>

    <div class="dashboard-footer__cell">
      <p class="dashboard-footer__label">Fuentes oficiales</p>
      <ul class="dashboard-footer__sources">
        {fuentes.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener noreferrer">
              {f.indicador} · {f.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="dashboard-footer__cell">
      <p class="dashboard-footer__label">Trazabilidad</p>
      <p class="dashboard-footer__text">
        Datos versionados y actualizados automáticamente cada mes. <br>
        Última corrida del pipeline: <strong>{fechaActualizacion}</strong>
      </p>
      {cobertura && (
        <p class="dashboard-footer__text" style="margin-top:0.5rem">
          Cobertura: {cobertura}
        </p>
      )}
    </div>
  </div>

  <div class="dashboard-footer__citation">
    <div class="dashboard-footer__citation-main">
      <span class="dashboard-footer__license">CC BY 4.0</span>
      <p class="dashboard-footer__citation-text">
        <strong>Cómo citar:</strong> <span data-citation-text>{citaSugerida}</span>
      </p>
    </div>
    <button
      type="button"
      class="dashboard-footer__copy-btn"
      data-copy-citation={citaSugerida}
      aria-label="Copiar cita sugerida al portapapeles"
    >
      <span data-copy-label>Copiar cita</span>
    </button>
  </div>
</footer>

<script>
  function initCitationCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-citation]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copyCitation;
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        if (!text || !label) return;
        try {
          await navigator.clipboard.writeText(text);
          label.textContent = "Cita copiada ✓";
          btn.classList.add("is-copied");
          setTimeout(() => {
            label.textContent = "Copiar cita";
            btn.classList.remove("is-copied");
          }, 2200);
        } catch {
          label.textContent = "CC BY 4.0";
        }
      });
    });
  }

  initCitationCopy();
  document.addEventListener("astro:page-load", initCitationCopy);
</script>

<style>
  .dashboard-footer {
    margin-top: 1.5rem;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .dashboard-footer__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 880px) {
    .dashboard-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .dashboard-footer__label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.4rem;
  }

  .dashboard-footer__text {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    margin: 0 0 0.4rem;
    line-height: 1.5;
  }
  .dashboard-footer__text:last-child {
    margin-bottom: 0;
  }

  .dashboard-footer__sources {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dashboard-footer__sources li {
    font-size: 0.82rem;
    margin-bottom: 0.3rem;
    line-height: 1.45;
  }

  .dashboard-footer__sources a,
  .dashboard-footer__link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .dashboard-footer__sources a:hover,
  .dashboard-footer__link:hover {
    text-decoration: underline;
  }

  .dashboard-footer__citation {
    margin-top: 1.5rem;
    padding: 0.9rem 1.25rem;
    background: var(--color-sidebar);
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .dashboard-footer__citation-main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-width: 0;
  }

  .dashboard-footer__license {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--color-active-bg);
    border: 1px solid rgba(37, 99, 235, 0.22);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .dashboard-footer__citation-text {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .dashboard-footer__copy-btn {
    appearance: none;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid rgba(37, 99, 235, 0.25);
    color: var(--color-accent);
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .dashboard-footer__copy-btn:hover {
    background: var(--color-active-bg);
    border-color: var(--color-accent);
  }

  .dashboard-footer__copy-btn.is-copied {
    background: rgba(22, 163, 74, 0.1);
    border-color: rgba(22, 163, 74, 0.4);
    color: #15803d;
  }
</style>
