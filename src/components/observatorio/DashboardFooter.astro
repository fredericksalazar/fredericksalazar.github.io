---
import type { Fuente } from "../../lib/observatorio/types";
import { formatFechaActualizacion } from "../../lib/observatorio/formatters";

interface Definicion {
  titulo: string;
  texto: string;
}

interface Props {
  fuentes: Fuente[];
  ultimaActualizacion: string;
  definiciones?: Definicion[];
  cobertura?: string;
}

const { fuentes, ultimaActualizacion, definiciones = [], cobertura } = Astro.props;
const fechaActualizacion = formatFechaActualizacion(ultimaActualizacion);
---

<footer class="dashboard-footer" aria-label="Metodología y fuentes">
  <div class="dashboard-footer__inner">
    <div class="dashboard-footer__cell">
      <p class="dashboard-footer__label">Definiciones</p>
      {definiciones.length > 0 ? (
        definiciones.map((d) => (
          <p class="dashboard-footer__text">
            <strong>{d.titulo}</strong> &mdash; {d.texto}
          </p>
        ))
      ) : (
        <p class="dashboard-footer__text">—</p>
      )}
    </div>

    <div class="dashboard-footer__cell">
      <p class="dashboard-footer__label">Fuentes oficiales</p>
      <ul class="dashboard-footer__sources">
        {fuentes.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener noreferrer">
              {f.indicador} · {f.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="dashboard-footer__cell">
      <p class="dashboard-footer__label">Trazabilidad</p>
      <p class="dashboard-footer__text">
        Datos versionados y actualizados automáticamente cada mes. <br>
        Última corrida del pipeline: <strong>{fechaActualizacion}</strong>
      </p>
      {cobertura && (
        <p class="dashboard-footer__text" style="margin-top:0.5rem">
          Cobertura: {cobertura}
        </p>
      )}
    </div>
  </div>
</footer>

<style>
  .dashboard-footer {
    margin-top: 1.5rem;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .dashboard-footer__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 880px) {
    .dashboard-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .dashboard-footer__label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.4rem;
  }

  .dashboard-footer__text {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    margin: 0 0 0.4rem;
    line-height: 1.5;
  }
  .dashboard-footer__text:last-child {
    margin-bottom: 0;
  }

  .dashboard-footer__sources {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dashboard-footer__sources li {
    font-size: 0.82rem;
    margin-bottom: 0.3rem;
    line-height: 1.45;
  }

  .dashboard-footer__sources a,
  .dashboard-footer__link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .dashboard-footer__sources a:hover,
  .dashboard-footer__link:hover {
    text-decoration: underline;
  }
</style>
