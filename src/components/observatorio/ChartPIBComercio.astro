---
import type { PIBSerieFila, ComercioSerieFila } from "../../lib/observatorio/types";
import { baseLayout, periodoToISODate } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  seriePIB: PIBSerieFila[];
  serieComercio: ComercioSerieFila[];
  embedded?: boolean;
}
const { seriePIB, serieComercio, embedded = false } = Astro.props;

const mapExp: Record<string, number | null> = {};
for (const r of serieComercio) {
  mapExp[r.periodo] = typeof r.exportaciones === "number" ? r.exportaciones : null;
}

const data = seriePIB.filter((r) => typeof r.pib_total === "number");
const x = data.map((r) => periodoToISODate(r.periodo));
const pib = data.map((r) => r.pib_total as number);
const exp = data.map((r) => mapExp[r.periodo] ?? null);

const traces = [
  {
    name: "PIB total",
    x, y: pib,
    mode: "lines",
    line: { color: "#2563eb", width: 2.2 },
    fill: "tozeroy",
    fillcolor: "rgba(37,99,235,0.05)",
    yaxis: "y",
    hovertemplate: "<b>%{x|%Y}</b><br>PIB: <b>%{y:,.1f} mil M USD</b><extra></extra>",
  },
  {
    name: "Exportaciones (% PIB)",
    x, y: exp,
    mode: "lines",
    line: { color: "#16a34a", width: 2.2, dash: "solid" },
    yaxis: "y2",
    hovertemplate: "<b>%{x|%Y}</b><br>Exportaciones: <b>%{y:.1f}%</b> del PIB<extra></extra>",
  },
];

const layout = baseLayout({
  margin: { l: 56, r: 56, t: 24, b: 40 },
  showlegend: true,
  legend: { orientation: "h", yanchor: "bottom", y: 1.04, xanchor: "left", x: 0, font: { size: 11 }, bgcolor: "rgba(0,0,0,0)" },
  hovermode: "x unified",
  yaxis: {
    title: { text: "PIB (mil M USD)", font: { size: 11, color: "#2563eb" } },
    showgrid: true, gridcolor: "rgba(208,215,220,0.4)", zeroline: false,
    tickfont: { size: 11, color: "#2563eb" }, ticksuffix: "",
    automargin: true,
  },
  yaxis2: {
    title: { text: "Exportaciones (% PIB)", font: { size: 11, color: "#16a34a" } },
    overlaying: "y", side: "right",
    showgrid: false, zeroline: false,
    tickfont: { size: 11, color: "#16a34a" }, ticksuffix: "%",
    automargin: true,
  },
  shapes: [
    { type: "rect", xref: "x", yref: "paper", x0: "2007-01-01", x1: "2014-12-31", y0: 0, y1: 1, fillcolor: "rgba(234,179,8,0.06)", line: { width: 0 }, layer: "below" },
  ],
  annotations: [
    { x: "2011-01-01", y: 1.02, xref: "x", yref: "paper", text: "Boom petrolero", showarrow: false, font: { size: 10, color: "#a16207" } },
    { x: "2020-12-01", y: 270.35, xref: "x", yref: "y", text: "COVID", showarrow: true, arrowhead: 2, arrowcolor: "#dc2626", ax: 30, ay: 30, font: { size: 10, color: "#dc2626" } },
  ],
});
---

<ChartContainer
  titulo="PIB total y peso de las exportaciones"
  pregunta="Las exportaciones representan entre 13% y 22% del PIB. Cuando caen los precios de commodities, cae el PIB en USD."
  fuenteTexto="Banco Mundial — WDI · DANE" embedded={embedded}>
  <PlotlyChart id="pib-comercio" traces={traces} layout={layout} height={440}
    ariaLabel="PIB total y exportaciones como porcentaje del PIB, 1960-2024" />
</ChartContainer>
