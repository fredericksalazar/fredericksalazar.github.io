---
interface Props {
  id: string;
  traces: unknown[];
  layout: Record<string, unknown>;
  config?: Record<string, unknown>;
  height?: number;
  ariaLabel?: string;
}

const {
  id,
  traces,
  layout,
  config = { responsive: true, displayModeBar: false, locale: "es" },
  height = 360,
  ariaLabel,
} = Astro.props;

const dataPayload = JSON.stringify({ traces, layout, config });
---

<div
  class="plotly-chart"
  data-chart-id={id}
  role="img"
  aria-label={ariaLabel ?? `Gráfico ${id}`}
>
  <div id={`chart-${id}`} class="plotly-chart__canvas" style={`height: ${height}px;`}></div>
  <script type="application/json" data-chart-data={id} set:html={dataPayload}></script>
</div>

<style>
  .plotly-chart {
    width: 100%;
  }
  .plotly-chart__canvas {
    width: 100%;
  }
</style>

<script>
  function initPlotlyChart(el: Element) {
    const chartId = el.getAttribute("data-chart-id");
    if (!chartId) return;
    const target = document.getElementById(`chart-${chartId}`);
    const dataScript = el.querySelector(`[data-chart-data="${chartId}"]`);
    if (!target || !dataScript || target.dataset.rendered === "true") return;

    let payload: { traces: unknown[]; layout: Record<string, unknown>; config: Record<string, unknown> };
    try {
      payload = JSON.parse(dataScript.textContent ?? "{}");
    } catch {
      return;
    }

    // @ts-expect-error Plotly is loaded from CDN
    if (typeof window.Plotly === "undefined") {
      window.addEventListener("plotly:loaded", () => initPlotlyChart(el), { once: true });
      return;
    }

    target.dataset.rendered = "true";
    // @ts-expect-error Plotly global from CDN
    window.Plotly.newPlot(target, payload.traces, payload.layout, payload.config);
  }

  function initAll() {
    document.querySelectorAll(".plotly-chart").forEach(initPlotlyChart);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }

  document.addEventListener("astro:page-load", initAll);
</script>
