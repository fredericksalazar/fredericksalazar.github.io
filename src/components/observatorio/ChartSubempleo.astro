---
import type { EmpleoSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  serie: EmpleoSerieFila[];
  embedded?: boolean;
}

const { serie, embedded = false } = Astro.props;

const filtered = serie.filter((r) => r.periodo >= "2000-01");
const { x, y } = extractSerie(filtered, "subempleo");

const traces = [
  {
    name: "Tasa de subempleo",
    x,
    y,
    mode: "lines",
    line: { color: "#2563eb", width: 2.2 },
    fill: "tozeroy",
    fillcolor: "rgba(37, 99, 235, 0.06)",
    hovertemplate: "<b>%{x|%b %Y}</b><br>Subempleo: %{y:.2f}%<extra></extra>",
  },
];

const layout = baseLayout();
---

<ChartContainer
  titulo="Tasa de subempleo"
  pregunta="Porcentaje de ocupados que trabajan menos horas de las que quisieran. Un indicador adelantado: el subempleo suele anticipar cambios en el desempleo."
  fuenteTexto="DANE — Gran Encuesta Integrada de Hogares (GEIH)"
  embedded={embedded}
>
  <PlotlyChart
    id="subempleo"
    traces={traces}
    layout={layout}
    height={340}
    ariaLabel="Tasa de subempleo mensual en Colombia"
  />
</ChartContainer>
