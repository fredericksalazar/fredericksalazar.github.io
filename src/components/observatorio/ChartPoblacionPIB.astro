---
import type { PIBSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props { serie: PIBSerieFila[]; embedded?: boolean; }
const { serie, embedded = false } = Astro.props;
const { x: x1, y: y1 } = extractSerie(serie, "poblacion");
const { x: x2, y: y2 } = extractSerie(serie, "pib_percapita");

const traces = [
  { name: "Población", x: x1, y: y1, mode: "lines", line: { color: "#2563eb", width: 2.2 }, yaxis: "y", hovertemplate: "<b>%{x|%Y}</b><br>Población: %{y:,.0f}<extra></extra>" },
  { name: "PIB per cápita", x: x2, y: y2, mode: "lines", line: { color: "#16a34a", width: 2.2, dash: "dash" }, yaxis: "y2", hovertemplate: "<b>%{x|%Y}</b><br>PIB per cápita: %{y:,.0f} USD<extra></extra>" },
];

const layout = baseLayout({
  showlegend: true, legend: { orientation: "h", yanchor: "bottom", y: 1.04, xanchor: "left", x: 0, font: { size: 11 }, bgcolor: "rgba(0,0,0,0)" },
  yaxis2: { overlaying: "y", side: "right", showgrid: false, tickfont: { size: 11, color: "#16a34a" }, automargin: true },
});
---

<ChartContainer titulo="Población y PIB per cápita" pregunta="La población crece de forma estable mientras el PIB per cápita refleja los ciclos económicos. Eje izquierdo: población, eje derecho: PIB per cápita USD."
  fuenteTexto="Banco Mundial — WDI" embedded={embedded}>
  <PlotlyChart id="pib-poblacion" traces={traces} layout={layout} height={360} ariaLabel="Población y PIB per cápita de Colombia" />
</ChartContainer>
