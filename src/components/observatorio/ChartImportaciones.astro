---
import type { ComercioSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  serie: ComercioSerieFila[];
  embedded?: boolean;
}

const { serie, embedded = false } = Astro.props;
const { x, y } = extractSerie(serie, "importaciones");

const traces = [
  {
    name: "Importaciones",
    x,
    y,
    mode: "lines",
    line: { color: "#64748b", width: 2.2 },
    fill: "tozeroy",
    fillcolor: "rgba(100, 116, 139, 0.06)",
    hovertemplate: "<b>%{x|%Y}</b><br>Importaciones: %{y:.2f}% PIB<extra></extra>",
  },
];

const layout = baseLayout();
---

<ChartContainer
  titulo="Importaciones (% PIB)"
  pregunta="¿Qué porcentaje del PIB representan las importaciones colombianas?"
  fuenteTexto="Banco Mundial — World Development Indicators"
  embedded={embedded}
>
  <PlotlyChart id="comercio-impo" traces={traces} layout={layout} height={340}
    ariaLabel="Importaciones de Colombia como porcentaje del PIB" />
</ChartContainer>
