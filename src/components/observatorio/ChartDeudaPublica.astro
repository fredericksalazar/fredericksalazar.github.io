---
import type { PIBSerieFila } from "../../lib/observatorio/types";
import { baseLayout, periodoToISODate } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props { serie: PIBSerieFila[]; embedded?: boolean; }
const { serie, embedded = false } = Astro.props;

const data = serie.filter((r) => typeof r.deuda_publica === "number" && r.deuda_publica > 0);
const x = data.map((r) => periodoToISODate(r.periodo));
const y = data.map((r) => r.deuda_publica as number);

const firstX = x[0];
const lastX = x[x.length - 1];

const traces = [{
  name: "Deuda pública",
  x, y,
  mode: "lines",
  line: { color: "#1e293b", width: 2.4 },
  fill: "tozeroy",
  fillcolor: "rgba(30,41,59,0.06)",
  hovertemplate: "<b>%{x|%Y}</b><br>Deuda pública: <b>%{y:.1f}%</b> del PIB<extra></extra>",
}];

const banda = (y0: number, y1: number, color: string) => ({
  type: "rect" as const,
  xref: "paper" as const,
  yref: "y" as const,
  x0: 0, x1: 1,
  y0, y1,
  fillcolor: color,
  line: { width: 0 },
  layer: "below" as const,
});

const anotPico = {
  x: "2020-12-01",
  y: 91.16,
  xref: "x" as const,
  yref: "y" as const,
  text: "Pandemia<br><b>91.2%</b>",
  showarrow: true,
  arrowhead: 2,
  arrowcolor: "#dc2626",
  ax: -40, ay: -30,
  font: { size: 11, color: "#dc2626" },
  bgcolor: "rgba(255,255,255,0.85)",
  bordercolor: "rgba(220,38,38,0.4)",
  borderwidth: 1,
  borderpad: 4,
};

const layout = baseLayout({
  margin: { l: 48, r: 24, t: 16, b: 40 },
  showlegend: false,
  hovermode: "x" as const,
  yaxis: {
    showgrid: true,
    gridcolor: "rgba(208, 215, 220, 0.4)",
    zeroline: false,
    tickfont: { size: 11, color: "#636c76" },
    ticksuffix: "%",
    automargin: true,
    range: [0, 100],
  },
  shapes: [
    banda(0, 40, "rgba(34,197,94,0.10)"),
    banda(40, 60, "rgba(234,179,8,0.10)"),
    banda(60, 100, "rgba(220,38,38,0.10)"),
  ],
  annotations: [anotPico],
});
---

<ChartContainer
  titulo="Deuda pública como % del PIB"
  pregunta="Del 17% en 2000 al 91% en 2020 durante la pandemia. Las bandas marcan los umbrales clásicos de sostenibilidad fiscal para mercados emergentes."
  fuenteTexto="Banco Mundial — WDI · Umbrales FMI" embedded={embedded}>
  <PlotlyChart id="deuda-publica" traces={traces} layout={layout} height={420}
    ariaLabel="Evolución de la deuda pública de Colombia como porcentaje del PIB, con bandas de sostenibilidad fiscal" />
  <div class="banda-leyenda" slot="footer-extra">
    <span class="banda-chip"><span class="banda-dot banda-dot--low"></span>&lt;40% sostenibilidad sólida</span>
    <span class="banda-chip"><span class="banda-dot banda-dot--mid"></span>40-60% atención</span>
    <span class="banda-chip"><span class="banda-dot banda-dot--high"></span>&gt;60% riesgo</span>
  </div>
</ChartContainer>

<style>
  .banda-leyenda{display:flex;flex-wrap:wrap;gap:.5rem .85rem;font-size:.72rem;color:var(--color-text-muted)}
  .banda-chip{display:inline-flex;align-items:center;gap:.35rem}
  .banda-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
  .banda-dot--low{background:rgba(34,197,94,0.35);border:1px solid rgba(34,197,94,0.5)}
  .banda-dot--mid{background:rgba(234,179,8,0.35);border:1px solid rgba(234,179,8,0.55)}
  .banda-dot--high{background:rgba(220,38,38,0.35);border:1px solid rgba(220,38,38,0.5)}
</style>
