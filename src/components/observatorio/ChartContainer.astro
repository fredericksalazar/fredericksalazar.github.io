---
import type { Fuente } from "../../lib/observatorio/types";

interface Props {
  titulo: string;
  pregunta?: string;
  fuente?: Fuente;
  fuenteTexto?: string;
  embedded?: boolean;
}

const { titulo, pregunta, fuente, fuenteTexto, embedded = false } = Astro.props;
---

{embedded ? (
  <div class="chart-embedded" data-chart-root>
    <div class="chart-embedded__extra">
      <slot name="header-extra" />
    </div>
    <slot />
    <div class="chart-state chart-state--error" data-chart-error>
      <p class="chart-state__message" data-chart-error-message>No se pudo cargar el gráfico.</p>
      <button type="button" class="chart-state__retry" data-chart-retry>Reintentar</button>
    </div>
  </div>
) : (
<article class="chart-card" data-chart-root>
  <header class="chart-card__header">
    <div class="chart-card__header-row">
      <div class="chart-card__header-text">
        <h3 class="chart-card__title">{titulo}</h3>
        {pregunta && <p class="chart-card__question">{pregunta}</p>}
      </div>
      <slot name="header-extra" />
    </div>
  </header>

  <div class="chart-card__body">
    <slot />
    <div class="chart-state chart-state--error" data-chart-error>
      <p class="chart-state__message" data-chart-error-message>No se pudo cargar el gráfico.</p>
      <button type="button" class="chart-state__retry" data-chart-retry>Reintentar</button>
    </div>
  </div>

  <footer class="chart-card__footer">
    {fuente ? (
      <span class="chart-card__source">
        Fuente:
        <a href={fuente.url} target="_blank" rel="noopener noreferrer">
          {fuente.nombre}
        </a>
      </span>
    ) : fuenteTexto ? (
      <span class="chart-card__source">{fuenteTexto}</span>
    ) : null}
    <slot name="footer-extra" />
  </footer>
</article>
)}

<style>
  .chart-embedded {
    width: 100%;
    position: relative;
  }

  .chart-embedded__extra {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.5rem;
  }

  .chart-embedded__extra:empty {
    display: none;
  }

  .chart-card {
    background: var(--color-sidebar);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .chart-card:hover {
    border-color: rgba(37, 99, 235, 0.3);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .chart-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chart-card__header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .chart-card__header-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }

  .chart-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .chart-card__question {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .chart-card__body {
    flex: 1;
    min-height: 0;
    position: relative;
  }

  .chart-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-border);
  }

  .chart-card__source {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .chart-card__source a {
    color: var(--color-accent);
    text-decoration: none;
    margin-left: 0.25rem;
  }

  .chart-card__source a:hover {
    text-decoration: underline;
  }

  /* Estados ── loading skeleton (CSS-only sobre canvas con aria-busy) */
  :global([data-chart-root][data-state="loading"] .plotly-chart__canvas) {
    background-image: linear-gradient(
      90deg,
      rgba(208, 215, 220, 0.18) 0%,
      rgba(208, 215, 220, 0.32) 50%,
      rgba(208, 215, 220, 0.18) 100%
    );
    background-size: 200% 100%;
    animation: chart-skeleton 1.4s ease-in-out infinite;
    border-radius: 8px;
  }

  @keyframes chart-skeleton {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .chart-state {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1rem;
  }

  :global([data-chart-root][data-state="error"]) .chart-state--error {
    display: flex;
  }

  :global([data-chart-root][data-state="error"]) .plotly-chart__canvas {
    display: none;
  }

  .chart-state__message {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .chart-state__retry {
    appearance: none;
    border: 1px solid var(--color-border);
    background: white;
    color: var(--color-text-primary);
    font-size: 0.78rem;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .chart-state__retry:hover {
    border-color: rgba(37, 99, 235, 0.4);
    background: rgba(37, 99, 235, 0.04);
  }
</style>
