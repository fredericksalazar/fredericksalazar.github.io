---
import { baseLayout } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  matriz: Record<string, Record<string, number | null>>;
  titulo: string;
  pregunta: string;
  chartId: string;
  embedded?: boolean;
}

const { matriz, titulo, pregunta, chartId, embedded = false } = Astro.props;

const years = Object.keys(matriz).sort();
const grupos = ["agropecuarios", "combustibles", "manufacturas", "otros"];
const groupLabels: Record<string, string> = {
  agropecuarios: "Agropecuarios",
  combustibles: "Combustibles",
  manufacturas: "Manufacturas",
  otros: "Otros sectores",
};
const groupColors: Record<string, string> = {
  agropecuarios: "#16a34a",
  combustibles: "#f59e0b",
  manufacturas: "#2563eb",
  otros: "#64748b",
};

const traces = grupos.map((g) => ({
  name: groupLabels[g],
  x: years,
  y: years.map((y) => matriz[y]?.[g] ?? null),
  type: "bar" as const,
  marker: { color: groupColors[g] },
  hovertemplate: `<b>%{x}</b><br>${groupLabels[g]}: %{y:,.0f} mil USD<extra></extra>`,
}));

const layout = baseLayout({
  barmode: "stack" as const,
  showlegend: true,
  legend: { orientation: "h", yanchor: "bottom", y: 1.04, xanchor: "left", x: 0, font: { size: 11 }, bgcolor: "rgba(0,0,0,0)" },
  margin: { l: 48, r: 24, t: 16, b: 40 },
  hovermode: "x" as const,
});
---

<ChartContainer titulo={titulo} pregunta={pregunta}
  fuenteTexto="DANE — Comercio Internacional · Grupos OMC (CUCI Rev.3) · Miles de dólares"
  embedded={embedded}
>
  <PlotlyChart id={chartId} traces={traces} layout={layout} height={420}
    ariaLabel={titulo} />
</ChartContainer>
