---
import type { ComercioSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  serie: ComercioSerieFila[];
  embedded?: boolean;
}

const { serie, embedded = false } = Astro.props;
const { x, y } = extractSerie(serie, "exportaciones");

const traces = [
  {
    name: "Exportaciones",
    x,
    y,
    mode: "lines",
    line: { color: "#2563eb", width: 2.2 },
    fill: "tozeroy",
    fillcolor: "rgba(37, 99, 235, 0.06)",
    hovertemplate: "<b>%{x|%Y}</b><br>Exportaciones: %{y:.2f}% PIB<extra></extra>",
  },
];

const layout = baseLayout();
---

<ChartContainer
  titulo="Exportaciones (% PIB)"
  pregunta="¿Qué porcentaje del PIB representan las exportaciones colombianas?"
  fuenteTexto="Banco Mundial — World Development Indicators"
  embedded={embedded}
>
  <PlotlyChart id="comercio-expo" traces={traces} layout={layout} height={340}
    ariaLabel="Exportaciones de Colombia como porcentaje del PIB" />
</ChartContainer>
