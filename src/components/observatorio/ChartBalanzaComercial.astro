---
import type { ComercioSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props {
  serie: ComercioSerieFila[];
  embedded?: boolean;
}

const { serie, embedded = false } = Astro.props;
const { x, y } = extractSerie(serie, "balanza_comercial");

const barColors = y.map((v) =>
  v !== null ? (v >= 0 ? "#16a34a" : "#dc2626") : "#cbd5e1",
);

const traces = [
  {
    name: "Balanza comercial",
    x,
    y,
    type: "bar" as const,
    marker: {
      color: barColors,
      line: { color: "rgba(0,0,0,0.05)", width: 0.5 },
    },
    hovertemplate: "<b>%{x|%Y}</b><br>Balanza: %{y:.2f}% PIB<extra></extra>",
  },
];

const layout = baseLayout({
  showlegend: false,
  margin: { l: 48, r: 24, t: 16, b: 40 },
  hovermode: "x" as const,
  shapes: [
    {
      type: "line", xref: "paper", x0: 0, x1: 1,
      yref: "y", y0: 0, y1: 0,
      line: { color: "#1f2328", width: 1.5, dash: "solid" },
    },
  ],
});
---

<ChartContainer
  titulo="Balanza comercial (% PIB)"
  pregunta="Déficit o superávit comercial. Verde = superávit, rojo = déficit. La línea en 0 marca el equilibrio."
  fuenteTexto="Banco Mundial — World Development Indicators"
  embedded={embedded}
>
  <PlotlyChart id="comercio-balanza" traces={traces} layout={layout} height={380}
    ariaLabel="Balanza comercial de Colombia como porcentaje del PIB" />
</ChartContainer>
