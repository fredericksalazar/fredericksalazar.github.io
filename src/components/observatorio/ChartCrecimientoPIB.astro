---
import type { PIBSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props { serie: PIBSerieFila[]; embedded?: boolean; }
const { serie, embedded = false } = Astro.props;
const { x, y } = extractSerie(serie, "crecimiento_pib");

const barColors = y.map(v => v !== null ? (v >= 0 ? "#16a34a" : "#dc2626") : "#cbd5e1");
const traces = [{ name: "Crecimiento PIB", x, y, type: "bar" as const, marker: { color: barColors, line: { color: "rgba(0,0,0,0.05)", width: 0.5 } }, hovertemplate: "<b>%{x|%Y}</b><br>Crecimiento: %{y:.2f}%<extra></extra>" }];
const layout = baseLayout({ showlegend: false, margin: { l: 48, r: 24, t: 16, b: 40 }, hovermode: "x" as const,
  shapes: [{ type: "line", xref: "paper", x0: 0, x1: 1, yref: "y", y0: 0, y1: 0, line: { color: "#1f2328", width: 1.5, dash: "solid" } }] });
---

<ChartContainer titulo="Crecimiento del PIB (%)" pregunta="Variación porcentual anual del PIB real. Verde = crecimiento, rojo = contracción."
  fuenteTexto="Banco Mundial — WDI" embedded={embedded}>
  <PlotlyChart id="pib-crecimiento" traces={traces} layout={layout} height={380} ariaLabel="Crecimiento anual del PIB de Colombia" />
</ChartContainer>
