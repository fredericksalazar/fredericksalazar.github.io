---
import type { PIBSerieFila } from "../../lib/observatorio/types";
import { baseLayout, extractSerie } from "../../lib/observatorio/charts";
import ChartContainer from "./ChartContainer.astro";
import PlotlyChart from "./PlotlyChart.astro";

interface Props { serie: PIBSerieFila[]; embedded?: boolean; }
const { serie, embedded = false } = Astro.props;
const { x, y } = extractSerie(serie, "pib_total");

const traces = [{ name: "PIB", x, y, mode: "lines", line: { color: "#2563eb", width: 2.2 }, fill: "tozeroy", fillcolor: "rgba(37,99,235,0.06)", hovertemplate: "<b>%{x|%Y}</b><br>PIB: %{y:,.1f} mil M USD<extra></extra>" }];
const layout = baseLayout();
---

<ChartContainer titulo="PIB total de Colombia" pregunta="Producto Interno Bruto en miles de millones de USD corrientes. La economía colombiana multiplicó su tamaño 100 veces desde 1960."
  fuenteTexto="Banco Mundial — WDI" embedded={embedded}>
  <PlotlyChart id="pib-total" traces={traces} layout={layout} height={340} ariaLabel="PIB total de Colombia" />
</ChartContainer>
