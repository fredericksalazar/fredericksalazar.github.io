---
/**
 * SEOHead.astro
 * Componente centralizado para todas las etiquetas <head> relacionadas con SEO.
 * Incluye: meta estándar, Open Graph, Twitter Cards y JSON-LD (Person Schema).
 */
import { SITE_URL, urls } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Lista de keywords específicas para esta página (sobrescribe el default). */
  keywords?: string;
  /** Para type="article" — fecha ISO de publicación. */
  publishedTime?: string;
  /** Para type="article" — fecha ISO de última modificación. */
  modifiedTime?: string;
  /** Para type="article" — nombre del autor (default: Frederick Salazar). */
  articleAuthor?: string;
  /** Para type="article" — sección/categoría del artículo (ej. "Análisis político"). */
  articleSection?: string;
  /** Para type="article" — tags del artículo. */
  articleTags?: string[];
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt,
  type = 'website',
  noindex = false,
  keywords,
  publishedTime,
  modifiedTime,
  articleAuthor = 'Frederick Adolfo Salazar Sánchez',
  articleSection,
  articleTags = [],
} = Astro.props;

const DEFAULT_KEYWORDS = 'data engineer colombia, arquitecto de datos, big data latam, apache spark, databricks, azure data, python data engineering, frederick salazar, machine learning colombia, ETL pipelines, data warehouse';
const RESOLVED_KEYWORDS = keywords ?? DEFAULT_KEYWORDS;
const RESOLVED_IMAGE_ALT = imageAlt ?? title;

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const SITE_NAME   = 'Frederick Salazar — Data Engineer & Arquitecto de Datos';
// El sufijo de marca solo se añade si el título total se mantiene ≤ 60 caracteres
// (límite SEO de Bing/Google). Para títulos ya descriptivos y largos se omite la
// marca en vez de provocar truncado. Mantén cada `title` de página ≤ 60.
const TITLE_SUFFIX = ' | Frederick Salazar';
const FULL_TITLE  = title.length + TITLE_SUFFIX.length <= 60
  ? `${title}${TITLE_SUFFIX}`
  : title;
const CANONICAL   = new URL(Astro.url.pathname, SITE_URL).href;
const IMAGE_URL   = new URL(image, SITE_URL).href;

// ─── JSON-LD: Person Schema ───────────────────────────────────────────────────
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ing. Frederick Adolfo Salazar Sánchez',
  url: SITE_URL,
  jobTitle: 'Senior Data Engineer & Arquitecto de Datos',
  description:
    'Senior Data Engineer & Arquitecto de Datos con más de 11 años de experiencia. Especializado en Data Engineering, Big Data, IA y Analytics en Colombia y LATAM.',
  image: `${SITE_URL}/images/profile.png`,
  knowsAbout: [
    'Data Engineering',
    'Big Data',
    'Apache Spark',
    'Azure Data Factory',
    'Databricks',
    'Python',
    'Machine Learning',
    'Inteligencia Artificial',
    'SQL',
    'Data Architecture',
    'dbt',
    'Apache Airflow',
    'ETL/ELT',
  ],
  sameAs: [
    'https://www.linkedin.com/in/fredericksalazar',
    'https://github.com/fredericksalazar',
    'https://www.kaggle.com/fredericksalazar',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Globant',
    url: 'https://www.globant.com',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universitat Oberta de Catalunya',
    url: 'https://www.uoc.edu',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CO',
    addressLocality: 'Cali',
  },
  knowsLanguage: [
    { '@type': 'Language', name: 'Español' },
    { '@type': 'Language', name: 'Inglés' },
  ],
  birthPlace: {
    '@type': 'Place',
    address: 'Cali, Colombia',
  },
};
---

<!-- ── Charset & Viewport ──────────────────────────────────────────────────── -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="language" content="es-CO" />
<meta name="geo.region" content="CO" />
<meta name="geo.placename" content="Cali" />
<meta name="geo.position" content="3.4516;-76.5320" />
<meta name="ICBM" content="3.4516, -76.5320" />

<!-- ── Primary SEO ───────────────────────────────────────────────────────────── -->
<title>{FULL_TITLE}</title>
<meta name="title" content={FULL_TITLE} />
<meta name="description" content={description} />
<meta name="author" content="Frederick Adolfo Salazar Sánchez" />
<meta name="robots" content={robotsContent} />
<meta name="keywords" content={RESOLVED_KEYWORDS} />
<link rel="canonical" href={CANONICAL} />

<!-- ── Dublin Core (para mejor indexación) ─────────────────────────────────────── -->
<meta name="DC.title" content={FULL_TITLE} />
<meta name="DC.creator" content="Frederick Salazar" />
<meta name="DC.subject" content={description} />
<meta name="DC.description" content={description} />
<meta name="DC.publisher" content="Frederick Salazar" />
<meta name="DC.language" content="es-CO" />

<!-- ── Open Graph ────────────────────────────────────────────────────────────── -->
<meta property="og:type" content={type} />
<meta property="og:url" content={CANONICAL} />
<meta property="og:title" content={FULL_TITLE} />
<meta property="og:description" content={description} />
<meta property="og:image" content={IMAGE_URL} />
<meta property="og:image:secure_url" content={IMAGE_URL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={RESOLVED_IMAGE_ALT} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="es_CO" />
<meta property="og:locale:alternate" content="en_US" />

{type === 'article' && (
  <>
    <meta property="article:author" content={articleAuthor} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags.map((t) => <meta property="article:tag" content={t} />)}
  </>
)}

<!-- ── Twitter Card ──────────────────────────────────────────────────────────── -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@fredericksala" />
<meta name="twitter:creator" content="@fredericksala" />
<meta name="twitter:url" content={CANONICAL} />
<meta name="twitter:title" content={FULL_TITLE} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={IMAGE_URL} />
<meta name="twitter:image:alt" content={RESOLVED_IMAGE_ALT} />

<!-- ── LinkedIn / Otras redes: usan Open Graph; sólo añadimos los específicos ── -->
<meta property="og:see_also" content={SITE_URL} />

<!-- ── App identity + PWA hints ──────────────────────────────────────────────── -->
<meta name="theme-color" content="#2563eb" />
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
<meta name="application-name" content={SITE_NAME} />
<meta name="msapplication-TileColor" content="#2563eb" />
<meta name="format-detection" content="telephone=no" />

<!-- ── Favicons ───────────────────────────────────────────────────────────────── -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />

<!-- ── RSS feed ───────────────────────────────────────────────────────────────── -->
<link rel="alternate" type="application/rss+xml" title="Blog · Frederick Salazar" href={urls.rss()} />

<!-- ── Google Fonts: Google Sans Flex ───────────────────────────── -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@100..900&display=swap"
  rel="stylesheet"
/>

<!-- ── JSON-LD: Person Schema ────────────────────────────────────────────────── -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
