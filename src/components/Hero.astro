---
/**
 * Hero.astro — Hero zone reutilizable con estilo blueprint light.
 *
 * Uso:
 *   <Hero
 *     badge={{ text: "Disponible para proyectos" }}
 *     title="Tu Título"
 *     subtitle="Descripción corta"
 *     kpis={[{ value: "11+", label: "Años" }]}
 *     tags={["Tag 1", "Tag 2"]}
 *     image={{ src: "/img.png", alt: "Descripción", width: 800, height: 600 }}
 *   />
 *
 * Slots opcionales:
 *   - content  → Reemplaza todo el bloque de contenido izquierdo
 *   - visual   → Reemplaza la imagen derecha
 */

interface KPI {
  value: string | number;
  label: string;
}

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  badge: { text: string };
  title?: string;
  subtitle?: string;
  kpis?: KPI[];
  tags?: string[];
  image?: HeroImage;
}

const { badge, title, subtitle, kpis = [], tags = [], image } = Astro.props;
---

<section class="hero">
  <!-- Decoraciones de fondo -->
  <div class="hero__orb hero__orb--tl" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--br" aria-hidden="true"></div>
  <div class="hero__arc" aria-hidden="true"></div>
  <div class="hero__arc hero__arc--2" aria-hidden="true"></div>

  <!-- Fila superior: contenido + visual -->
  <div class="hero__main">
    <div class="hero__content">
      <slot name="content">
        <!-- Badge de estado -->
        <span class="hero__badge">
          <span class="hero__badge-pulse"></span>
          {badge.text}
        </span>

        <!-- Título principal -->
        {title && <h1 class="hero__title">{title}</h1>}

        <!-- Subtítulo / tagline -->
        {subtitle && <p class="hero__subtitle">{subtitle}</p>}

        <!-- KPIs / Indicadores -->
        {kpis.length > 0 && (
          <div class="hero__kpis">
            {kpis.map((kpi) => (
              <div class="hero__kpi">
                <span class="hero__kpi-value">{kpi.value}</span>
                <span class="hero__kpi-label">{kpi.label}</span>
              </div>
            ))}
          </div>
        )}

        <!-- Tags / Pills -->
        {tags.length > 0 && (
          <div class="hero__tags">
            {tags.map((tag) => (
              <span class="hero__tag">{tag}</span>
            ))}
          </div>
        )}
      </slot>
    </div>

    <!-- Zona derecha: imagen o contenido custom -->
    <div class="hero__visual">
      <slot name="visual">
        {image && (
          <img
            src={image.src}
            alt={image.alt}
            class="hero__image"
            width={image.width ?? 800}
            height={image.height ?? 600}
            loading="eager"
          />
        )}
      </slot>
    </div>
  </div>

  <!-- Fila inferior: Cloud Partners (siempre igual) -->
  <div class="hero__partners">
    <span class="hero__partners-label">Cloud Partners</span>
    <div class="hero__partners-divider" aria-hidden="true"></div>
    <div class="hero__partners-logos">
      <div class="hero__partner-item">
        <img src="/logos/aws.png" alt="AWS" class="hero__partner-logo hero__partner-logo--aws" width="80" height="32" />
        <span class="hero__partner-name">Amazon Web Services</span>
      </div>
      <div class="hero__partner-item">
        <img src="/logos/google.svg" alt="Google Cloud" class="hero__partner-logo hero__partner-logo--google" width="120" height="36" />
        <span class="hero__partner-name">Google Cloud Platform</span>
      </div>
      <div class="hero__partner-item">
        <img src="/logos/microsoft.svg" alt="Microsoft Azure" class="hero__partner-logo hero__partner-logo--microsoft" width="40" height="40" />
        <span class="hero__partner-name">Microsoft Azure</span>
      </div>
      <div class="hero__partner-item">
        <img src="/logos/databricks-logo.png" alt="Databricks" class="hero__partner-logo hero__partner-logo--databricks" width="110" height="30" />
        <span class="hero__partner-name">Databricks</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Animaciones ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* ──────────────────────────────────────────
   *  HERO — blueprint light theme
   * ────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: clip;
    width: 100%;
    min-height: 660px;
    display: flex;
    flex-direction: column;
    font-family: "Google Sans Flex", "Google Sans", system-ui, -apple-system,
      sans-serif;
    background:
      radial-gradient(
        ellipse 70% 60% at 90% -10%,
        rgba(37, 99, 235, 0.07) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 50% at -10% 110%,
        rgba(96, 165, 250, 0.08) 0%,
        transparent 60%
      ),
      linear-gradient(180deg, #ffffff 0%, #fafbff 60%, #f5f8ff 100%);
    border-bottom: 1px solid rgba(37, 99, 235, 0.08);
  }

  /* Blueprint dots */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      #2563eb 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.12;
    mask-image: radial-gradient(
      ellipse 100% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  /* Decorative orbs — contenidos dentro del hero */
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero__orb--tl {
    top: -120px;
    left: -120px;
    width: 360px;
    height: 360px;
    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.12) 0%,
      transparent 70%
    );
  }

  .hero__orb--br {
    bottom: -80px;
    right: 5%;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.1) 0%,
      transparent 70%
    );
  }

  /* Decorative arcs — contenidos dentro del hero */
  .hero__arc {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(37, 99, 235, 0.12);
    pointer-events: none;
    z-index: 0;
    bottom: -200px;
    right: -60px;
    width: 500px;
    height: 500px;
  }

  .hero__arc--2 {
    bottom: -240px;
    right: -20px;
    width: 600px;
    height: 600px;
    border-color: rgba(37, 99, 235, 0.07);
  }

  /* ── Hero main: grid 2 columnas ── */
  .hero__main {
    display: grid;
    grid-template-columns: 45% 1fr;
    flex: 1;
    position: relative;
    z-index: 1;
    min-height: 0;
  }

  /* Izquierda: contenido */
  .hero__content {
    padding: 3.5rem 1.5rem 3.5rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.1rem;
    position: relative;
    z-index: 2;
  }

  /* Derecha: visual */
  .hero__visual {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .hero__image {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: right center;
    display: block;
    pointer-events: none;
    animation: fadeInRight 0.8s ease-out backwards;
  }

  /* ── Badge de estado ── */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #15803d;
    letter-spacing: 0.01em;
    animation: fadeInUp 0.5s ease-out backwards;
  }

  .hero__badge-pulse {
    position: relative;
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
  }

  .hero__badge-pulse::before {
    content: "";
    position: absolute;
    inset: -3px;
    background: rgba(34, 197, 94, 0.4);
    border-radius: 50%;
    animation: ping 2s ease-out infinite;
  }

  /* ── Título ── */
  .hero__title {
    font-family: "Google Sans Flex", "Google Sans", "Product Sans", sans-serif;
    font-size: clamp(2.5rem, 5.2vw, 5.5rem);
    font-weight: 700;
    font-stretch: 100%;
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin: 0;
    color: #2563eb;
    animation: fadeInUp 0.6s ease-out 0.1s backwards;
  }

  /* ── Subtítulo ── */
  .hero__subtitle {
    font-size: 1rem;
    font-weight: 400;
    color: #475569;
    line-height: 1.55;
    margin: 0.25rem 0 0;
    max-width: 480px;
    animation: fadeInUp 0.5s ease-out 0.18s backwards;
  }

  /* ── KPIs ── */
  .hero__kpis {
    display: flex;
    gap: 2.5rem;
    margin-top: 0.5rem;
    animation: fadeInUp 0.5s ease-out 0.25s backwards;
  }

  .hero__kpi {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__kpi-value {
    font-size: 2rem;
    font-weight: 700;
    color: #2563eb;
    line-height: 1;
  }

  .hero__kpi-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Tags / Pills ── */
  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
    animation: fadeInUp 0.5s ease-out 0.28s backwards;
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: white;
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #2563eb;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero__tag:hover {
    border-color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.15);
  }

  /* ── Cloud Partners ── */
  .hero__partners {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1.25rem 3rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(37, 99, 235, 0.12);
    position: relative;
    z-index: 2;
    animation: fadeInUp 0.5s ease-out 0.4s backwards;
  }

  .hero__partners-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #2563eb;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .hero__partners-divider {
    width: 1px;
    height: 28px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(37, 99, 235, 0.25),
      transparent
    );
    flex-shrink: 0;
  }

  .hero__partners-logos {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex: 1;
    gap: 2.5rem;
    max-width: 720px;
  }

  .hero__partner-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .hero__partner-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
    display: block;
    transition:
      transform 0.25s ease,
      filter 0.25s ease;
    filter: grayscale(0%);
  }

  .hero__partner-logo:hover {
    transform: translateY(-2px) scale(1.05);
  }

  .hero__partner-name {
    font-size: 0.6rem;
    font-weight: 600;
    color: #2563eb;
    text-align: center;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .hero__partner-logo--aws {
    height: 32px;
  }

  .hero__partner-logo--google {
    height: 36px;
  }

  .hero__partner-logo--microsoft {
    height: 40px;
    width: 40px;
  }

  .hero__partner-logo--databricks {
    height: 30px;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .hero__main {
      grid-template-columns: 50% 50%;
    }

    .hero__content {
      padding: 3rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
    }

    .hero__main {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      display: none;
    }

    .hero__content {
      padding: 2.5rem 1.5rem 2rem;
    }

    .hero__title {
      font-size: 2.75rem;
    }

    .hero__kpis {
      gap: 1.5rem;
    }

    .hero__partners {
      flex-wrap: wrap;
      gap: 1rem;
      padding: 1rem 1.5rem;
    }

    .hero__partners-divider {
      display: none;
    }

    .hero__partners-logos {
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
