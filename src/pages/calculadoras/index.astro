---
/**
 * /calculadoras/ — Landing de las calculadoras ciudadanas.
 *
 * Herramientas interactivas construidas sobre los datos del Observatorio
 * (mismos JSON, misma fuente de verdad). Cada calculadora es una página
 * propia optimizada para SEO.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import MapaColombia from "../../components/observatorio/MapaColombia.astro";
import { urls, absUrls } from "../../lib/urls";
import { getObservatorio, getSalarioMinimo, getIngresos } from "../../lib/observatorio/data";

const title = "Calculadoras de economía colombiana: inflación, salario y poder adquisitivo";
const description =
  "Calculadoras interactivas con datos oficiales de Colombia: descubre cuánto vale hoy tu sueldo de hace años frente a la inflación y cómo era el país el año en que naciste. Datos del DANE, Banco de la República y Banco Mundial.";

const obs = getObservatorio();
const smlv = getSalarioMinimo();
const ingresos = getIngresos();
const inflacionActual = obs.indicadores.inflacion_anual.actual.valor;
const smlvActual = smlv.indicadores.salario_minimo.actual.valor;
const medianaIngreso = ingresos.indicadores.mediana.actual.valor ?? 0;
const fmtCOP = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 0 });

const calculadoras = [
  {
    slug: "cuanto-ganas",
    nombre: "¿Ganas bien? Compárate con Colombia",
    descripcion:
      "Tu salario frente a todos los trabajadores del país: en qué percentil estás, a qué clase social pertenece tu hogar según el DANE y cuánto gana tu ocupación.",
    dato: `Mediana nacional: $${fmtCOP.format(medianaIngreso)}`,
    emoji: "🏆",
  },
  {
    slug: "sueldo-vs-inflacion",
    nombre: "¿Cuánto vale hoy tu sueldo de hace unos años?",
    descripcion:
      "Ingresa un monto y un año: la calculadora lo ajusta con la inflación oficial y te dice cuánto poder adquisitivo ganaste o perdiste, y a cuántos salarios mínimos equivale.",
    dato: `Inflación anual actual: ${inflacionActual ?? "—"}%`,
    emoji: "📉",
  },
  {
    slug: "en-que-colombia-naciste",
    nombre: "¿En qué Colombia naciste?",
    descripcion:
      "Tu año de nacimiento, convertido en datos: quién gobernaba, cuántos éramos, cuánto valía el salario mínimo y cuánto ha cambiado el país desde entonces hasta hoy.",
    dato: `Cobertura: 1960 — hoy`,
    emoji: "🇨🇴",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Calculadoras de economía colombiana",
  description,
  url: absUrls.calculadoras(),
  inLanguage: "es",
  creator: { "@type": "Person", name: "Frederick Salazar", url: absUrls.home() },
  hasPart: calculadoras.map((c) => ({
    "@type": "WebApplication",
    name: c.nombre,
    url: absUrls.calculadora(c.slug),
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "COP" },
  })),
};
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <Hero
    badge={{ text: "Calculadoras · Datos oficiales de Colombia" }}
    title="La economía colombiana, aplicada a tu bolsillo"
    subtitle="Estas calculadoras usan exactamente los mismos datos del Observatorio de Datos de Colombia — inflación del DANE, salario mínimo de los decretos anuales, microdatos de la GEIH y series del Banco de la República y del Banco Mundial — para responder preguntas concretas sobre tu plata y tu historia. Sin opiniones: solo datos."
    kpis={[
      { value: `${inflacionActual ?? "—"}%`, label: "Inflación anual" },
      { value: `$${smlvActual !== null ? fmtCOP.format(smlvActual) : "—"}`, label: `Salario mínimo ${smlv.indicadores.salario_minimo.actual.periodo.slice(0, 4)}` },
      { value: `$${fmtCOP.format(medianaIngreso)}`, label: "Mediana de ingreso" },
    ]}
    showPartners={false}
  >
    <MapaColombia slot="visual" />
  </Hero>

  <div class="calc-container">
  <section class="calc-grid" aria-label="Calculadoras disponibles">
    {
      calculadoras.map((c) => (
        <a class="calc-card" href={urls.calculadora(c.slug)}>
          <span class="calc-card__emoji" aria-hidden="true">{c.emoji}</span>
          <h2 class="calc-card__titulo">{c.nombre}</h2>
          <p class="calc-card__desc">{c.descripcion}</p>
          <span class="calc-card__dato">{c.dato}</span>
          <span class="calc-card__cta">Usar calculadora →</span>
        </a>
      ))
    }
  </section>

  <section class="calc-about">
    <h2>¿De dónde salen los datos?</h2>
    <p>
      Toda cifra que ves aquí nace en el pipeline de datos del Observatorio:
      series oficiales descargadas, procesadas y publicadas como datasets
      abiertos en este mismo sitio. La inflación proviene del DANE y del
      Banco Mundial; el salario mínimo, de los decretos anuales del Gobierno
      nacional; la demografía, de los World Development Indicators. Puedes
      ver las series completas en el
      <a href={urls.observatorio()}>Observatorio</a> y en el
      <a href={urls.observatorioSub("empleo")}>dashboard de empleo</a>.
    </p>
  </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .calc-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2rem 2rem 0;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin: 1rem 0 3rem;
  }
  .calc-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    background: var(--color-sidebar, #f6f8fa);
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 18px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .calc-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent, #2563eb);
    box-shadow: 0 10px 28px rgba(37, 99, 235, 0.12);
  }
  .calc-card__emoji { font-size: 1.8rem; }
  .calc-card__titulo {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary, #1f2328);
    margin: 0;
  }
  .calc-card__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #475569);
    margin: 0;
    flex: 1;
  }
  .calc-card__dato {
    font-size: 0.72rem;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    color: var(--color-text-muted, #636c76);
  }
  .calc-card__cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent, #2563eb);
  }

  .calc-about {
    max-width: 720px;
    padding-bottom: 3rem;
  }
  .calc-about h2 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--color-text-primary, #1f2328);
  }
  .calc-about p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #475569);
  }
  .calc-about a { color: var(--color-accent, #2563eb); }
</style>
