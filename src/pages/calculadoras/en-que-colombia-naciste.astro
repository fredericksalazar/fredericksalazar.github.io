---
/**
 * /calculadoras/en-que-colombia-naciste/ — Tu año de nacimiento en datos.
 *
 * SEO build-time (título, KPIs, FAQ, JSON-LD) + cálculo 100% client-side
 * sobre los JSON del Observatorio (REGLA 2: los datos nunca se incrustan).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import { urls, absUrls } from "../../lib/urls";
import { getDemografia, getPIB } from "../../lib/observatorio/data";

const dem = getDemografia();
const pib = getPIB();

const poblacionActual = dem.indicadores.poblacion.actual.valor;
const anioMin = 1960;
const anioMax = new Date().getFullYear();
const anios = Array.from({ length: anioMax - anioMin + 1 }, (_, i) => anioMax - i);
const nfDec1 = new Intl.NumberFormat("es-CO", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const nfEntero = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 0 });
const fmtMill = (v: number | null) =>
  v === null ? "—" : `${nfDec1.format(v / 1_000_000)} millones`;

const title = "¿En qué Colombia naciste? Tu año de nacimiento en datos";
const description =
  "Ingresa tu año de nacimiento y descubre la Colombia en la que llegaste: quién era presidente, cuántos habitantes éramos, cuánto valía el salario mínimo, cuánto costaba la vida y cuánto ha cambiado todo desde entonces. Datos oficiales desde 1960.";

const faqs = [
  {
    q: "¿Qué datos usa esta calculadora?",
    a: "Series oficiales desde 1960: población y esperanza de vida del Banco Mundial (WDI), PIB per cápita en USD, inflación del DANE/Banco Mundial, salario mínimo de los decretos anuales (desde 1984), TRM del Banco de la República (desde 2003) y la lista de presidentes de la Registraduría Nacional.",
  },
  {
    q: "¿Por qué algunos datos no aparecen para mi año?",
    a: "Cada serie tiene su propia cobertura: el salario mínimo unificado existe desde 1984 y la TRM publicada desde 2003. Si naciste antes, esos campos se omiten en lugar de inventarse.",
  },
  {
    q: "¿Cómo se calcula cuánto han subido los precios desde que nací?",
    a: "Componiendo la inflación anual oficial año a año desde tu nacimiento hasta el último dato mensual publicado. Es el mismo índice de la calculadora de sueldo vs. inflación.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "¿En qué Colombia naciste?",
      url: absUrls.calculadora("en-que-colombia-naciste"),
      description,
      applicationCategory: "EducationalApplication",
      operatingSystem: "Web",
      inLanguage: "es",
      offers: { "@type": "Offer", price: "0", priceCurrency: "COP" },
      creator: { "@type": "Person", name: "Frederick Salazar", url: absUrls.home() },
      dateModified: dem.metadata.ultima_actualizacion,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} image="/images/observatorio.png">
  <article class="calc">
    <header class="calc__header">
      <nav class="calc__breadcrumb" aria-label="Miga de pan">
        <a href={urls.calculadoras()}>Calculadoras</a> <span aria-hidden="true">/</span> ¿En qué Colombia naciste?
      </nav>
      <h1 class="calc__titulo">¿En qué Colombia naciste?</h1>
      <p class="calc__lead">
        Hoy Colombia tiene <strong>{fmtMill(poblacionActual)}</strong> de habitantes y un PIB
        per cápita de <strong>{pib.indicadores.pib_percapita.actual.valor !== null ? nfEntero.format(pib.indicadores.pib_percapita.actual.valor) : "—"} USD</strong>.
        Pero, ¿cómo era el país el año en que llegaste? Elige tu año de nacimiento y
        conviértelo en datos: presidente, población, salario mínimo, precios y cuánto
        ha cambiado todo desde entonces.
      </p>
    </header>

    <form class="calc__form" id="form-naciste" aria-label="Calculadora de año de nacimiento">
      <div class="calc__field">
        <label for="anio">Tu año de nacimiento</label>
        <select id="anio" name="anio">
          {anios.map((a) => <option value={a} selected={a === 1990}>{a}</option>)}
        </select>
      </div>
      <button type="submit" class="calc__submit">Descubrir mi Colombia</button>
    </form>

    <section class="calc__resultados" id="resultados" hidden aria-live="polite">
      <div class="calc__headline">
        <span class="calc__headline-label">Naciste en la Colombia de</span>
        <span class="calc__headline-valor" id="r-presidente"></span>
        <span class="calc__headline-label" id="r-presidente-detalle"></span>
      </div>

      <h2 class="calc__seccion-titulo" id="r-titulo-entonces"></h2>
      <div class="calc__stats" id="r-entonces"></div>

      <h2 class="calc__seccion-titulo">Lo que ha cambiado desde entonces</h2>
      <div class="calc__stats" id="r-cambios"></div>

      <div class="calc__chart-card">
        <h2 class="calc__chart-titulo">La población de Colombia durante tu vida</h2>
        <div id="calc-naciste-chart" style="height: 360px;" role="img" aria-label="Población de Colombia desde 1960 con marcador en tu año de nacimiento"></div>
      </div>

      <div class="calc__share">
        <span class="calc__share-label">Comparte tu Colombia:</span>
        <a id="share-wa" class="calc__share-btn" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a id="share-x" class="calc__share-btn" target="_blank" rel="noopener noreferrer">X</a>
        <button id="share-copy" type="button" class="calc__share-btn">Copiar enlace</button>
      </div>
    </section>

    <section class="calc__faq">
      <h2>Preguntas frecuentes</h2>
      {
        faqs.map((f) => (
          <details class="calc__faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <p class="calc__metodologia">
        <strong>Fuentes:</strong> Banco Mundial (WDI), DANE, Banco de la República,
        decretos anuales de salario mínimo y Registraduría Nacional. Series completas
        en el <a href={urls.observatorio()}>Observatorio de Datos de Colombia</a>.
      </p>
    </section>
  </article>

  <PlotlyLoader />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
  import {
    loadDemografia,
    loadPIB,
    loadInflacion,
    loadSalarioMinimo,
    loadExterno,
    loadPresidentes,
  } from "../../lib/observatorio/data-client";
  import { presidenteForYear } from "../../lib/observatorio/presidentes-client";
  import { recordByYear } from "../../lib/observatorio/derivations";
  import { mountPlotly, purgeChart } from "../../lib/observatorio/plotly-mount";
  import { COLORS, baseLayout } from "../../lib/observatorio/charts";
  import {
    construirIndicePrecios,
    factorAHoy,
    smlvDe,
    anioSMLVActual,
    fmtCOP,
    fmtNum,
    fmtDec1,
    fmtVeces,
  } from "../../lib/calculadoras/calculos";

  const CHART_ID = "calc-naciste-chart";
  const $ = (id: string) => document.getElementById(id);

  interface Dato { valor: string; label: string }

  function ultimoDe(rec: Record<string, number>): { anio: number; valor: number } | null {
    const anios = Object.keys(rec).map(Number).sort((a, b) => a - b);
    if (!anios.length) return null;
    const anio = anios[anios.length - 1];
    return { anio, valor: rec[String(anio)] };
  }

  function statCard({ valor, label }: Dato): string {
    const div = document.createElement("div");
    div.className = "calc-stat";
    const v = document.createElement("span");
    v.className = "calc-stat__valor";
    v.textContent = valor;
    const l = document.createElement("span");
    l.className = "calc-stat__label";
    l.textContent = label;
    div.append(v, l);
    return div.outerHTML;
  }

  async function calcular(anio: number): Promise<void> {
    const [dem, pib, inflacion, smlv, externo, presidentes] = await Promise.all([
      loadDemografia(), loadPIB(), loadInflacion(), loadSalarioMinimo(), loadExterno(), loadPresidentes(),
    ]);

    const indice = construirIndicePrecios(inflacion);
    const poblacion = recordByYear(dem.serie, (r) => r.poblacion ?? null);
    const esperanzaM = recordByYear(dem.serie, (r) => r.esperanza_vida_mujeres ?? null);
    const esperanzaH = recordByYear(dem.serie, (r) => r.esperanza_vida_hombres ?? null);
    const pibPc = recordByYear(pib.serie, (r) => r.pib_percapita ?? null);
    const trm = externo.historico?.trm ?? {};

    const presidente = presidenteForYear(anio, presidentes);
    const elP = $("r-presidente");
    if (elP) elP.textContent = presidente?.nombre ?? "—";
    const elPD = $("r-presidente-detalle");
    if (elPD && presidente) {
      const ini = new Date(presidente.inicio).getFullYear();
      const fin = new Date(presidente.fin).getFullYear();
      elPD.textContent = `${presidente.partido} · gobernó ${ini}–${fin}`;
    }
    const elTitulo = $("r-titulo-entonces");
    if (elTitulo) elTitulo.textContent = `Así era Colombia en ${anio}`;

    // ── Tarjetas "entonces" ──
    const entonces: Dato[] = [];
    const pobAnio = poblacion[String(anio)];
    if (pobAnio) entonces.push({ valor: `${(pobAnio / 1e6).toFixed(1)} M`, label: "habitantes tenía Colombia" });
    const inflAnio = inflacion.historico[String(anio)];
    if (inflAnio !== undefined) entonces.push({ valor: `${fmtDec1(inflAnio)}%`, label: "fue la inflación de ese año" });
    const pibAnio = pibPc[String(anio)];
    if (pibAnio) entonces.push({ valor: `${fmtNum(pibAnio)} USD`, label: "era el PIB per cápita" });
    const smlvAnio = smlvDe(smlv, anio);
    if (smlvAnio) entonces.push({ valor: fmtCOP(smlvAnio), label: "era el salario mínimo mensual" });
    const trmAnio = trm[String(anio)];
    if (trmAnio) entonces.push({ valor: fmtCOP(trmAnio), label: "costaba un dólar (TRM promedio)" });
    const evM = esperanzaM[String(anio)];
    const evH = esperanzaH[String(anio)];
    if (evM && evH) entonces.push({ valor: `${fmtDec1((evM + evH) / 2)} años`, label: "era la esperanza de vida al nacer" });
    const elEntonces = $("r-entonces");
    if (elEntonces) elEntonces.innerHTML = entonces.map(statCard).join("");

    // ── Tarjetas "lo que cambió" (hasta el dato más reciente) ──
    const cambios: Dato[] = [];
    const pobHoy = ultimoDe(poblacion);
    if (pobAnio && pobHoy) {
      cambios.push({
        valor: `${(pobAnio / 1e6).toFixed(1)} M → ${(pobHoy.valor / 1e6).toFixed(1)} M`,
        label: `creció la población (dato a ${pobHoy.anio})`,
      });
    }
    if (anio < indice.anioMax) {
      const factor = factorAHoy(indice, anio);
      cambios.push({
        valor: fmtVeces(factor),
        label: `se multiplicaron los precios: $1.000 de ${anio} son ${fmtCOP(1000 * factor)} de hoy`,
      });
    }
    const pibHoy = ultimoDe(pibPc);
    if (pibAnio && pibHoy) {
      cambios.push({
        valor: fmtVeces(pibHoy.valor / pibAnio),
        label: `se multiplicó el PIB per cápita (${fmtNum(pibAnio)} → ${fmtNum(pibHoy.valor)} USD)`,
      });
    }
    const anioSmlvHoy = anioSMLVActual(smlv);
    const smlvHoy = smlvDe(smlv, anioSmlvHoy);
    if (smlvAnio && smlvHoy) {
      cambios.push({
        valor: fmtVeces(smlvHoy / smlvAnio),
        label: `se multiplicó el salario mínimo (${fmtCOP(smlvAnio)} → ${fmtCOP(smlvHoy)})`,
      });
    }
    const evMHoy = ultimoDe(esperanzaM);
    const evHHoy = ultimoDe(esperanzaH);
    if (evM && evH && evMHoy && evHHoy) {
      const delta = (evMHoy.valor + evHHoy.valor) / 2 - (evM + evH) / 2;
      cambios.push({
        valor: `+${fmtDec1(delta)} años`,
        label: "ganamos de esperanza de vida desde tu nacimiento",
      });
    }
    const elCambios = $("r-cambios");
    if (elCambios) elCambios.innerHTML = cambios.map(statCard).join("");

    const resultados = $("resultados");
    if (resultados) resultados.hidden = false;

    // ── Gráfico: población con marcador en tu año ──
    const aniosPob = Object.keys(poblacion).map(Number).sort((a, b) => a - b);
    const valoresPob = aniosPob.map((a) => poblacion[String(a)] / 1e6);
    await mountPlotly(CHART_ID, {
      traces: [{
        type: "scatter", mode: "lines", x: aniosPob, y: valoresPob,
        name: "Población", line: { color: COLORS.brand, width: 3 },
        fill: "tozeroy", fillcolor: "rgba(37, 99, 235, 0.06)",
        hovertemplate: "<b>%{x}</b><br>Población: <b>%{y:.1f} M</b><extra></extra>",
      }],
      layout: baseLayout({
        margin: { l: 48, r: 24, t: 16, b: 40 },
        showlegend: false, hovermode: "x",
        yaxis: {
          showgrid: true, gridcolor: "rgba(208, 215, 220, 0.4)", zeroline: false,
          tickfont: { size: 11, color: "#636c76" }, ticksuffix: " M", automargin: true,
        },
        shapes: pobAnio ? [{
          type: "line", xref: "x", x0: anio, x1: anio, yref: "paper", y0: 0, y1: 1,
          line: { color: "#dc2626", width: 2, dash: "dash" }, layer: "above",
        }] : [],
        annotations: pobAnio ? [{
          xref: "x", yref: "paper", x: anio, y: 1, yanchor: "bottom",
          text: `<b>Naciste aquí · ${anio}</b>`, showarrow: false,
          font: { size: 11, color: "#ffffff", family: "system-ui, sans-serif" },
          bgcolor: "#dc2626", bordercolor: "#b91c1c", borderwidth: 1, borderpad: 4,
        }] : [],
      }),
    });

    // ── Compartir ──
    const url = `${location.origin}${location.pathname}?anio=${anio}`;
    history.replaceState(null, "", `?anio=${anio}`);
    const partes = [`Nací en la Colombia de ${presidente?.nombre ?? anio}`];
    if (pobAnio && pobHoy) partes.push(`éramos ${(pobAnio / 1e6).toFixed(1)} millones, hoy somos ${(pobHoy.valor / 1e6).toFixed(1)}`);
    if (smlvAnio) partes.push(`el salario mínimo era ${fmtCOP(smlvAnio)}`);
    const texto = `${partes.join(" · ")}. Descubre tu Colombia 👇 ${url}`;
    const wa = $("share-wa") as HTMLAnchorElement | null;
    if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(texto)}`;
    const x = $("share-x") as HTMLAnchorElement | null;
    if (x) x.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(texto)}`;
    const copy = $("share-copy");
    if (copy) {
      copy.onclick = async () => {
        await navigator.clipboard.writeText(url);
        copy.textContent = "¡Copiado!";
        setTimeout(() => { copy.textContent = "Copiar enlace"; }, 1800);
      };
    }
  }

  function init(): void {
    const form = $("form-naciste") as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const anio = parseInt(($("anio") as HTMLSelectElement)?.value ?? "", 10);
      if (anio) calcular(anio).catch((err) => console.error("[calc-naciste]", err));
    });

    const params = new URLSearchParams(location.search);
    const anio = parseInt(params.get("anio") ?? "", 10);
    if (anio >= 1960) {
      const sel = $("anio") as HTMLSelectElement | null;
      if (sel) sel.value = String(anio);
      calcular(anio).catch((err) => console.error("[calc-naciste]", err));
    }
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => purgeChart(CHART_ID));
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init, { once: true });
</script>

<style>
  .calc { padding: 2.5rem 0 3rem; }

  .calc__breadcrumb {
    font-size: 0.78rem;
    color: var(--color-text-muted, #636c76);
    margin-bottom: 1rem;
  }
  .calc__breadcrumb a { color: var(--color-accent, #2563eb); text-decoration: none; }

  .calc__titulo {
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 700;
    line-height: 1.18;
    margin: 0 0 0.9rem;
    color: var(--color-text-primary, #1f2328);
  }
  .calc__lead {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #475569);
    max-width: 680px;
  }

  .calc__form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-sidebar, #f6f8fa);
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 18px;
  }
  .calc__field { display: flex; flex-direction: column; gap: 0.35rem; flex: 0 1 220px; }
  .calc__field label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #636c76);
  }
  .calc__field select {
    font-size: 1.05rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 10px;
    background: #fff;
    color: var(--color-text-primary, #1f2328);
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }
  .calc__field select:focus {
    outline: 2px solid var(--color-accent, #2563eb);
    outline-offset: 1px;
    border-color: var(--color-accent, #2563eb);
  }
  .calc__submit {
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.7rem 1.6rem;
    background: var(--color-accent, #2563eb);
    color: #fff;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .calc__submit:hover { background: #1d4ed8; transform: translateY(-1px); }

  .calc__headline {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.75rem;
  }
  .calc__headline-label { font-size: 0.95rem; color: var(--color-text-secondary, #475569); }
  .calc__headline-valor {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-accent, #2563eb);
  }

  .calc__seccion-titulo {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.9rem;
    color: var(--color-text-primary, #1f2328);
  }

  .calc__chart-card {
    padding: 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 18px;
    margin-bottom: 1.5rem;
  }
  .calc__chart-titulo {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary, #1f2328);
  }

  .calc__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .calc__share-label { font-size: 0.85rem; color: var(--color-text-muted, #636c76); }
  .calc__share-btn {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 100px;
    background: #fff;
    color: var(--color-accent, #2563eb);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .calc__share-btn:hover { border-color: var(--color-accent, #2563eb); box-shadow: 0 2px 10px rgba(37, 99, 235, 0.12); }

  .calc__faq { margin-top: 3rem; max-width: 720px; }
  .calc__faq h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text-primary, #1f2328);
  }
  .calc__faq-item {
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 12px;
    padding: 0.85rem 1.1rem;
    margin-bottom: 0.6rem;
    background: var(--color-sidebar, #f6f8fa);
  }
  .calc__faq-item summary {
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text-primary, #1f2328);
  }
  .calc__faq-item p {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #475569);
  }
  .calc__metodologia {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-text-muted, #636c76);
  }
  .calc__metodologia a { color: var(--color-accent, #2563eb); }
</style>

<style is:global>
  /* Tarjetas inyectadas por JS: deben ser globales porque los nodos creados
     en runtime no llevan el atributo de scoping de Astro. */
  .calc__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .calc__stats .calc-stat {
    padding: 1.1rem 1.25rem;
    background: var(--color-sidebar, #f6f8fa);
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .calc__stats .calc-stat__valor {
    font-size: 1.35rem;
    font-weight: 700;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    color: var(--color-text-primary, #1f2328);
  }
  .calc__stats .calc-stat__label {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-text-muted, #636c76);
  }
</style>
