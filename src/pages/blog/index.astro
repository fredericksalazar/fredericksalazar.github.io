---
/**
 * blog/index.astro — Listado de artículos del blog
 * URL: /blog
 *
 * Lee la colección 'blog', filtra borradores y ordena por fecha descendente.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Blog de Data Engineering & IA — Frederick Salazar';
const description = 'Artículos sobre Data Engineering, Inteligencia Artificial, Big Data, Azure y tecnología en Colombia y LATAM. Por Frederick Salazar.';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts    = allPosts.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} type="article">

  <section aria-labelledby="blog-heading">
    <h1 id="blog-heading" class="page-title">Blog</h1>
    <p class="page-subtitle">
      Contenido sobre Data Engineering, IA y tecnología para la comunidad en Colombia y LATAM.
    </p>
  </section>

  {posts.length === 0 ? (
    <p class="empty-state">Los artículos se publicarán pronto.</p>
  ) : (
    <ul class="posts-list" aria-label="Listado de artículos">
      {posts.map((post) => (
        <li class="post-card">
          <time class="post-card__date" datetime={post.data.fecha.toISOString()}>
            {formatDate(post.data.fecha)}
          </time>
          <a href={`/blog/${post.id}`} class="post-card__title-link">
            <h2 class="post-card__title">{post.data.titulo}</h2>
          </a>
          <p class="post-card__desc">{post.data.descripcion}</p>
          <div class="tags-row">
            {post.data.etiquetas.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        </li>
      ))}
    </ul>
  )}

</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }
  .empty-state {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-style: italic;
  }
  .posts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .post-card:first-child {
    padding-top: 0;
  }
  .post-card:last-child {
    border-bottom: none;
  }
  .post-card__date {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  .post-card__title-link {
    text-decoration: none;
  }
  .post-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: color 0.15s ease;
    line-height: 1.3;
  }
  .post-card__title-link:hover .post-card__title {
    color: var(--color-accent);
  }
  .post-card__desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
</style>
