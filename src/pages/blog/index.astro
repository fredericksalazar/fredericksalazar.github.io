---
/**
 * blog/index.astro — Listado de artículos del blog
 * URL: /blog
 *
 * Lee la colección 'blog', filtra borradores y ordena por fecha descendente.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const title       = 'Blog de Data Engineering, Machine Learning | Frederick Salazar';
const description = 'Artículos técnicos sobre Data Engineering, Big Data, Machine Learning, Azure y Analytics. Tutorials, guías y análisis de datos por Frederick Salazar, Data Engineer en Colombia.';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts    = allPosts.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const tagHref = (tag: string) => `/blog/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, '-'))}`;
---

<BaseLayout title={title} description={description} type="article">

  <section aria-labelledby="blog-heading">
    <h1 id="blog-heading" class="page-title">Blog</h1>
    <p class="page-subtitle">
      Contenido sobre Data Engineering, IA y tecnología para la comunidad en Colombia y LATAM.
    </p>
  </section>

  {posts.length === 0 ? (
    <p class="empty-state">Los artículos se publicarán pronto.</p>
  ) : (
    <div class="blog-grid">
      {posts.map((post) => (
        <Card
          variant="blog"
          href={`/blog/${post.id}`}
          image={post.data.imagen}
          imageAlt={post.data.titulo}
          title={post.data.titulo}
          description={post.data.descripcion}
          date={post.data.fecha}
          tags={post.data.etiquetas}
          headingLevel="h2"
          tagLinks={true}
          tagHref={tagHref}
        />
      ))}
    </div>
  )}

</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
  }
  .empty-state {
    color: var(--color-text-muted);
    font-size: 1rem;
    font-style: italic;
  }

  /* ── Grid Layout ──────────────────────────────────────────────────────── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2.5rem;
  }
</style>
