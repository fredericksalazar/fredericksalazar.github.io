---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import { urls, absUrls, SITE_URL } from '../../lib/urls';
import { trail, sectionCrumb } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const PAGE_URL = absUrls.blogPost(post.id);

const formatDate = (date: Date) =>
  date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });

const wordCount   = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const TIPO_LABEL: Record<string, string> = {
  tutorial: 'Tutorial',
  analisis: 'Análisis',
  opinion: 'Opinión',
  'caso-estudio': 'Caso de estudio',
  referencia: 'Referencia',
};
const tipoLabel = TIPO_LABEL[post.data.tipo] ?? 'Artículo';

// ── Artículos relacionados (4): por tags compartidos; fallback al mismo `tipo` ──
const sortedByDate = [...allPosts].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const byTags = sortedByDate.filter(
  (p) => p.id !== post.id && p.data.etiquetas.some((t: string) => post.data.etiquetas.includes(t)),
);
const byTipo = sortedByDate.filter(
  (p) => p.id !== post.id && p.data.tipo === post.data.tipo && !byTags.includes(p),
);
const related = [...byTags, ...byTipo].slice(0, 4);

// ── Prev / Next por fecha ──
const ordered = sortedByDate;
const idx = ordered.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? ordered[idx - 1] : null;
const older = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;

// ── JSON-LD ──

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.titulo,
  description: post.data.descripcion,
  datePublished: post.data.fecha.toISOString(),
  dateModified: post.data.fecha.toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.autor,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: 'Frederick Salazar',
    url: SITE_URL,
    image: `${SITE_URL}/images/profile.png`,
  },
  image: post.data.imagen ? new URL(post.data.imagen, SITE_URL).href : `${SITE_URL}/og-default.png`,
  url: PAGE_URL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
  inLanguage: 'es-CO',
  wordCount,
  articleSection: post.data.etiquetas[0] ?? tipoLabel,
  keywords: post.data.etiquetas.join(', '),
};
if (post.data.resumen) articleSchema.abstract = post.data.resumen;
---

<BaseLayout
  title={post.data.tituloSeo ?? post.data.titulo}
  description={post.data.descripcion}
  image={post.data.imagen}
  type="article"
  breadcrumbs={trail(sectionCrumb.blog, { name: post.data.titulo, url: PAGE_URL })}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <ReadingProgress />

  <nav class="breadcrumb" aria-label="Migas de pan">
    <a href={urls.home()}>Inicio</a>
    <span aria-hidden="true"> › </span>
    <a href={urls.blog()}>Blog</a>
    <span aria-hidden="true"> › </span>
    <span>{post.data.titulo}</span>
  </nav>

  <article>

    <header class="art-header">
      <div class="art-badges">
        <span class={`tipo-badge tipo-badge--${post.data.tipo}`}>{tipoLabel}</span>
        {post.data.etiquetas.length > 0 && post.data.etiquetas.slice(0, 4).map((t: string) => (
          <a href={urls.blogTag(t)} class="tag">{t}</a>
        ))}
      </div>
      <h1 class="art-title">{post.data.titulo}</h1>
      <div class="art-meta">
        <time datetime={post.data.fecha.toISOString()}>{formatDate(post.data.fecha)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} min de lectura</span>
        <span aria-hidden="true">·</span>
        <span>{wordCount.toLocaleString('es-CO')} palabras</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.autor}</span>
      </div>
    </header>

    {post.data.imagen && (
      <div class="art-cover">
        <img
          src={post.data.imagen}
          alt={post.data.titulo}
          loading="eager"
          width="1200"
          height="630"
        />
      </div>
    )}

    {post.data.resumen && (
      <aside class="tldr" aria-label="Resumen del artículo">
        <p class="tldr__label">TL;DR</p>
        <p class="tldr__body">{post.data.resumen}</p>
      </aside>
    )}

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    <ShareButtons url={PAGE_URL} title={post.data.titulo} />

    <AuthorBio />

    {(newer || older) && (
      <nav class="prevnext" aria-label="Navegación entre artículos">
        {older ? (
          <div class="prevnext__link prevnext__link--prev">
            <span class="prevnext__dir" aria-hidden="true">← Artículo anterior</span>
            <span class="prevnext__title">
              <a href={urls.blogPost(older.id)} rel="prev" class="prevnext__anchor">{older.data.titulo}</a>
            </span>
          </div>
        ) : <span />}
        {newer ? (
          <div class="prevnext__link prevnext__link--next">
            <span class="prevnext__dir" aria-hidden="true">Artículo siguiente →</span>
            <span class="prevnext__title">
              <a href={urls.blogPost(newer.id)} rel="next" class="prevnext__anchor">{newer.data.titulo}</a>
            </span>
          </div>
        ) : <span />}
      </nav>
    )}

    {related.length > 0 && (
      <aside class="related">
        <h2 class="related-title">Artículos relacionados</h2>
        <div class="related-grid">
          {related.map((r) => (
            <Card
              variant="related"
              href={urls.blogPost(r.id)}
              image={r.data.imagen}
              imageAlt={r.data.titulo}
              title={r.data.titulo}
              date={r.data.fecha}
              headingLevel="h3"
            />
          ))}
        </div>
      </aside>
    )}

    <footer class="art-footer">
      <a href={urls.blog()} class="back-link">← Volver al blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem; font-size: 0.85rem;
    max-width: 800px; margin-left: auto; margin-right: auto;
    color: var(--color-text-muted);
  }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb span:last-child { color: var(--color-text-secondary); }

  article {
    max-width: 800px;
    margin: 0 auto;
  }

  .art-header { margin-bottom: 1.75rem; }

  .art-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .tipo-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    background: var(--color-accent);
    color: #fff;
  }
  .tipo-badge--tutorial { background: #16a34a; }
  .tipo-badge--analisis { background: var(--color-accent); }
  .tipo-badge--opinion { background: #9333ea; }
  .tipo-badge--caso-estudio { background: #ea580c; }
  .tipo-badge--referencia { background: #475569; }

  .tag {
    display: inline-block;
    font-size: 0.75rem; font-weight: 500;
    padding: 0.2rem 0.65rem;
    background: var(--color-tag-bg); border: 1px solid var(--color-tag-border);
    border-radius: 999px; color: var(--color-accent);
    text-decoration: none; transition: background 0.15s;
  }
  .tag:hover { background: var(--color-hover); }

  .art-title {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0.5rem 0 0.85rem;
    color: var(--color-text-primary);
  }

  .art-meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.825rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .art-cover {
    margin-bottom: 2rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    aspect-ratio: 1200 / 630;
  }
  .art-cover img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  /* ── TL;DR block ─────────────────────────────────────────────────── */
  .tldr {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: var(--color-hover);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .tldr__label {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .tldr__body {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ── Prose ───────────────────────────────────────────────────────── */
  .prose {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 100%;
  }
  .prose :global(h2) {
    font-size: 1.5rem; font-weight: 700; color: var(--color-text-primary);
    margin: 2.5rem 0 0.85rem;
    padding-bottom: 0.4rem; border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
    position: relative;
  }
  .prose :global(h3) {
    font-size: 1.2rem; font-weight: 600; color: var(--color-text-primary);
    margin: 1.9rem 0 0.5rem;
    scroll-margin-top: 5rem;
    position: relative;
  }
  .prose :global(h2 > a),
  .prose :global(h3 > a) {
    text-decoration: none;
    color: inherit;
  }
  .prose :global(p) { margin-bottom: 1.15rem; }
  .prose :global(a) {
    color: var(--color-accent); text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(ul), .prose :global(ol) { margin: 0.75rem 0 1.15rem 1.5rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(img) {
    max-width: 100%; height: auto; border-radius: 0.5rem;
    margin: 1.75rem auto; display: block;
    border: 1px solid var(--color-border);
    max-height: 500px; object-fit: contain;
  }
  .prose :global(figure) { margin: 1.75rem 0; }
  .prose :global(figcaption) {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    font-style: italic;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0; color: var(--color-text-muted); font-style: italic;
  }
  .prose :global(code) {
    font-family: var(--font-mono); font-size: 0.85em;
    background: var(--color-tag-bg); border: 1px solid var(--color-tag-border);
    padding: 0.15rem 0.4rem; border-radius: 0.3rem;
  }
  .prose :global(pre) {
    background: #f6f8fa; border: 1px solid var(--color-border);
    border-radius: 0.5rem; padding: 1.25rem; overflow-x: auto; margin: 1.5rem 0;
    position: relative;
  }
  .prose :global(pre code) { background: none; border: none; padding: 0; font-size: 0.875em; }
  .prose :global(pre .copy-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--color-sidebar, #fff);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, background 0.15s;
    font-family: inherit;
  }
  .prose :global(pre:hover .copy-btn) { opacity: 1; }
  .prose :global(pre .copy-btn:hover) { background: var(--color-hover); color: var(--color-accent); }
  .prose :global(table) {
    width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--color-border); padding: 0.5rem 0.85rem;
  }
  .prose :global(th) {
    background: var(--color-hover); font-weight: 600;
    color: var(--color-text-primary);
  }
  .prose :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 2rem 0; }
  .prose :global(strong) { color: var(--color-text-primary); font-weight: 600; }

  /* Anchor link icon */
  .prose :global(.heading-anchor) {
    position: absolute;
    left: -1.25rem;
    top: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s;
    font-weight: 400;
  }
  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor) { opacity: 1; }

  /* ── Prev/Next ───────────────────────────────────────────────────── */
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2.5rem 0;
  }
  /* "Stretched link" pattern: el <a> envuelve solo el título; el
     ::after lo expande para que toda la card sea clicable. El anchor
     text queda corto (solo el título). */
  .prevnext__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-sidebar, #fff);
    transition: border-color 0.15s, transform 0.15s;
  }
  .prevnext__link:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .prevnext__link--next { text-align: right; }
  .prevnext__dir {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .prevnext__title {
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .prevnext__anchor {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .prevnext__anchor::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .prevnext__link:hover .prevnext__anchor {
    color: var(--color-accent);
  }
  @media (max-width: 640px) {
    .prevnext { grid-template-columns: 1fr; }
    .prevnext__link--next { text-align: left; }
  }

  /* ── Related articles ────────────────────────────────────────────── */
  .related { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .related-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 1.25rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }

  .art-footer {
    margin-top: 3rem; padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .back-link { font-size: 0.875rem; color: var(--color-text-muted); }
  .back-link:hover { color: var(--color-accent); }
</style>

<script>
  // Inject "copy" buttons on every <pre> inside .prose
  const enhanceCodeBlocks = () => {
    document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy-btn')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = 'Copiar';
      btn.setAttribute('aria-label', 'Copiar código');
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = '¡Copiado!';
          setTimeout(() => (btn.textContent = 'Copiar'), 1500);
        } catch {
          btn.textContent = 'Error';
        }
      });
      pre.appendChild(btn);
    });
  };

  // Inject heading-anchor links into h2/h3 with an id
  const enhanceHeadings = () => {
    document.querySelectorAll<HTMLHeadingElement>('.prose h2[id], .prose h3[id]').forEach((h) => {
      if (h.querySelector('.heading-anchor')) return;
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.className = 'heading-anchor';
      a.setAttribute('aria-label', 'Enlace permanente a esta sección');
      a.textContent = '#';
      h.prepend(a);
    });
  };

  const init = () => {
    enhanceCodeBlocks();
    enhanceHeadings();
  };
  document.addEventListener('astro:page-load', init);
  init();
</script>
