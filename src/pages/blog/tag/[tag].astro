---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const tagMap = new Map<string, typeof allPosts>();
  for (const post of allPosts) {
    for (const etiqueta of post.data.etiquetas) {
      const slug = etiqueta.toLowerCase().replace(/\s+/g, '-');
      if (!tagMap.has(slug)) tagMap.set(slug, []);
      tagMap.get(slug)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, posts]) => ({
    params: { tag: slug },
    props: {
      tagSlug: slug,
      tagLabel: posts[0].data.etiquetas.find(
        (t: string) => t.toLowerCase().replace(/\s+/g, '-') === slug
      ) ?? slug,
      posts: posts.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()),
    },
  }));
}

const { tagLabel, posts } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });

const title = `Artículos sobre ${tagLabel} | Frederick Salazar`;
const description = `Todos los artículos de Data Engineering, Big Data y tecnología sobre ${tagLabel} escritos por Frederick Salazar.`;
---

<BaseLayout {title} {description}>

  <nav class="breadcrumb">
    <a href="/">Inicio</a>
    <span aria-hidden="true"> › </span>
    <a href="/blog">Blog</a>
    <span aria-hidden="true"> › </span>
    <span>{tagLabel}</span>
  </nav>

  <section>
    <h1 class="page-title">#{tagLabel}</h1>
    <p class="page-subtitle">{posts.length} artículo{posts.length !== 1 ? 's' : ''}</p>
  </section>

  <div class="blog-grid">
    {posts.map((post) => (
      <article class="post-card">
        <a href={`/blog/${post.id}`} class="post-card__link">
          {post.data.imagen && (
            <div class="post-card__img-container">
              <img src={post.data.imagen} alt={post.data.titulo} loading="lazy" class="post-card__img" />
            </div>
          )}
          <div class="post-card__content">
            <time class="post-card__date" datetime={post.data.fecha.toISOString()}>
              {formatDate(post.data.fecha)}
            </time>
            <h2 class="post-card__title">{post.data.titulo}</h2>
            <p class="post-card__desc">{post.data.descripcion}</p>
            {post.data.etiquetas && post.data.etiquetas.length > 0 && (
              <div class="post-card__tags">
                {post.data.etiquetas.map((t: string) => (
                  <span class="post-card__tag">{t}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      </article>
    ))}
  </div>

</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem; font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); }

  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800; margin-bottom: 0.25rem; letter-spacing: -0.02em;
  }
  .page-subtitle {
    font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 2.5rem;
  }

  .blog-grid { display: flex; flex-direction: column; gap: 1.5rem; }

  .post-card {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem; overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }
  .post-card:hover { border-color: var(--color-accent); background: var(--color-hover); }
  .post-card__link { display: flex; gap: 1.25rem; text-decoration: none; color: inherit; padding: 1rem; }
  .post-card__img-container { flex-shrink: 0; width: 120px; height: 80px; border-radius: 0.5rem; overflow: hidden; }
  .post-card__img { width: 100%; height: 100%; object-fit: cover; }
  .post-card__content { flex: 1; min-width: 0; }
  .post-card__date { font-size: 0.75rem; color: var(--color-text-muted); display: block; margin-bottom: 0.25rem; }
  .post-card__title { font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; line-height: 1.35; }
  .post-card__desc { font-size: 0.875rem; color: var(--color-text-secondary); margin-bottom: 0.5rem; line-height: 1.5; }
  .post-card__tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .post-card__tag {
    font-size: 0.7rem; padding: 0.15rem 0.5rem;
    background: var(--color-tag-bg); border: 1px solid var(--color-tag-border);
    border-radius: 999px; color: var(--color-accent);
  }
</style>
