---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';
import { descriptionFor } from '../../../data/tags';
import { urls, absUrls } from '../../../lib/urls';
import { trail, sectionCrumb } from '../../../lib/seo';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const tagMap = new Map<string, typeof allPosts>();
  for (const post of allPosts) {
    for (const etiqueta of post.data.etiquetas) {
      const slug = etiqueta.toLowerCase().replace(/\s+/g, '-');
      if (!tagMap.has(slug)) tagMap.set(slug, []);
      tagMap.get(slug)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, posts]) => ({
    params: { tag: slug },
    props: {
      tagSlug: slug,
      tagLabel: posts[0].data.etiquetas.find(
        (t: string) => t.toLowerCase().replace(/\s+/g, '-') === slug
      ) ?? slug,
      posts: posts.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()),
    },
  }));
}

const { tagSlug, tagLabel, posts } = Astro.props;
const PAGE_URL = absUrls.blogTag(tagLabel);

const tagDescription = descriptionFor(tagSlug);
const title = `Artículos sobre ${tagLabel}`;
const description = tagDescription ?? `Todos los artículos sobre ${tagLabel} en el blog de Frederick Salazar: tutoriales, guías y análisis sobre Data Engineering, Big Data, IA y Analytics.`;

const TIPO_LABEL: Record<string, string> = {
  tutorial: 'Tutorial',
  analisis: 'Análisis',
  opinion: 'Opinión',
  'caso-estudio': 'Caso de estudio',
  referencia: 'Referencia',
};

// Conteo por tipo
const counts: Record<string, number> = {};
posts.forEach((p) => { counts[p.data.tipo] = (counts[p.data.tipo] ?? 0) + 1; });

const tagHref = (tag: string) => urls.blogTag(tag);

// JSON-LD: CollectionPage + ItemList
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Artículos sobre ${tagLabel}`,
  description,
  url: PAGE_URL,
  inLanguage: 'es-CO',
  isPartOf: { '@type': 'Blog', name: 'Blog · Frederick Salazar', url: absUrls.blog() },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absUrls.blogPost(p.id),
      name: p.data.titulo,
    })),
  },
};

---

<BaseLayout {title} {description} noindex={true}
  breadcrumbs={trail(sectionCrumb.blog, { name: tagLabel, url: PAGE_URL })}>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <nav class="breadcrumb" aria-label="Migas de pan">
    <a href={urls.home()}>Inicio</a>
    <span aria-hidden="true"> › </span>
    <a href={urls.blog()}>Blog</a>
    <span aria-hidden="true"> › </span>
    <span>{tagLabel}</span>
  </nav>

  <section>
    <p class="eyebrow">Tema</p>
    <h1 class="page-title">#{tagLabel}</h1>
    {tagDescription && <p class="page-subtitle">{tagDescription}</p>}
    <p class="counts">
      <strong>{posts.length}</strong> artículo{posts.length !== 1 ? 's' : ''}
      {Object.entries(counts).map(([tipo, n]) => (
        <span class="count-pill">{n} {TIPO_LABEL[tipo] ?? tipo}</span>
      ))}
    </p>
  </section>

  <div class="blog-list">
    {posts.map((post) => (
      <Card
        variant="blog"
        layout="horizontal"
        href={urls.blogPost(post.id)}
        image={post.data.imagen}
        imageAlt={post.data.titulo}
        title={post.data.titulo}
        description={post.data.descripcion}
        date={post.data.fecha}
        tags={post.data.etiquetas}
        headingLevel="h2"
        showReadMore={false}
        tagLinks={true}
        tagHref={tagHref}
      />
    ))}
  </div>

  <p class="more-link"><a href={urls.blogTags()}>← Ver todos los temas</a></p>

</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem; font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 0.4rem;
  }
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800; margin: 0 0 0.5rem; letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .page-subtitle {
    font-size: 1.05rem; color: var(--color-text-secondary);
    max-width: 65ch; line-height: 1.55;
    margin: 0 0 0.85rem;
  }
  .counts {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
    margin: 0 0 2.5rem;
  }
  .counts strong { color: var(--color-text-primary); font-weight: 700; }
  .count-pill {
    padding: 0.15rem 0.55rem;
    background: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .blog-list { display: flex; flex-direction: column; gap: 1.5rem; }

  .more-link {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }
  .more-link a { color: var(--color-text-muted); text-decoration: none; }
  .more-link a:hover { color: var(--color-accent); }
</style>
