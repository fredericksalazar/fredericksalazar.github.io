---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import MapaColombia from "../../components/observatorio/MapaColombia.astro";
import DashboardNav from "../../components/observatorio/DashboardNav.astro";
import KpiRow from "../../components/observatorio/KpiRow.astro";
import ChartInflacion from "../../components/observatorio/ChartInflacion.astro";
import ChartTasaInteres from "../../components/observatorio/ChartTasaInteres.astro";
import ChartFrenoAcelerador from "../../components/observatorio/ChartFrenoAcelerador.astro";
import ChartSpread from "../../components/observatorio/ChartSpread.astro";
import ChartInflacionHistorica from "../../components/observatorio/ChartInflacionHistorica.astro";
import DashboardFooter from "../../components/observatorio/DashboardFooter.astro";
import { getObservatorio, getSerieAscending } from "../../lib/observatorio/data";
import { formatPeriodo } from "../../lib/observatorio/formatters";

const obs = getObservatorio();
const serieAsc = getSerieAscending();
const ultimoPeriodo = formatPeriodo(obs.metadata.cobertura.ultimo_periodo);
---

<BaseLayout
  title="Observatorio de Datos de Colombia"
  description="Datos públicos de Colombia consolidados en un solo lugar: dashboard interactivo, análisis y reportes sobre indicadores económicos, sociales y más."
  fullWidth={true}
>
  <Hero
    badge={{ text: "Datos Públicos · Colombia" }}
    title="Observatorio de Datos de Colombia"
    subtitle="El Observatorio de Datos de Colombia consolida, procesa y publica los indicadores macroeconómicos que definen el pulso del país: para que cualquier persona lea la economía colombiana como un gerente lee el dashboard de su empresa."
    tags={["Inflación", "Empleo", "Comercio Exterior", "Sector Fiscal", "Monetario"]}
    showPartners={false}
  >
    <MapaColombia slot="visual" />
  </Hero>
  <DashboardNav active="inflacion-tasa" />

  <div class="observatorio-container">
    <KpiRow indicadores={obs.indicadores} />

    <section class="charts-synthesis" aria-label="Inflación histórica Colombia">
      <ChartInflacionHistorica historico={obs.historico} />
    </section>

    <section class="charts-grid" aria-label="Indicadores en columnas">
      <ChartInflacion serie={serieAsc} fuente={obs.metadata.fuentes.inflacion} />
      <ChartTasaInteres serie={serieAsc} fuente={obs.metadata.fuentes.tasa_interes} />
    </section>

    <section class="charts-synthesis" aria-label="Síntesis: freno o acelerador">
      <ChartFrenoAcelerador serie={serieAsc} />
    </section>

    <section class="charts-synthesis" aria-label="Diferencial spread en barras">
      <ChartSpread serie={serieAsc} />
    </section>

    <DashboardFooter metadata={obs.metadata} />
  </div>

  <script is:inline src="https://cdn.plot.ly/plotly-2.35.2.min.js" defer></script>
</BaseLayout>

<style>
  .observatorio-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.75rem 1.5rem 3rem;
  }

  .charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 960px) {
    .charts-grid {
      grid-template-columns: 1fr;
    }
  }

  .charts-synthesis {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 640px) {
    .observatorio-container {
      padding: 1.25rem 1rem 2rem;
    }
  }
</style>
