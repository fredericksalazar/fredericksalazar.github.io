---
/**
 * Home del Observatorio de Datos de Colombia (spec 005).
 * Todas las cifras salen de `public/data/*.json` en build (data.ts → home.ts);
 * las mini tendencias se cargan en cliente (REGLA 2).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import MapaColombia from "../../components/observatorio/MapaColombia.astro";
import DashboardNav from "../../components/observatorio/DashboardNav.astro";
import IndicadorClaveCard from "../../components/observatorio/IndicadorClaveCard.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import DashboardFooter from "../../components/observatorio/DashboardFooter.astro";
import BandaOscura from "../../components/observatorio/BandaOscura.astro";
import Card from "../../components/Card.astro";
import AuthorBio from "../../components/AuthorBio.astro";
import { getCollection } from "astro:content";
import { INFORMES } from "../../lib/observatorio/informes";
import {
  getObservatorio,
  getEmpleo,
  getPIB,
  getComercio,
  getExterno,
  getDemografia,
  getSalarioMinimo,
} from "../../lib/observatorio/data";
import {
  DATASETS_PUBLICADOS,
  GRUPOS,
  buildIndicadoresClave,
  publicacionesRecientes,
  type DatasetObservatorio,
  type DatasetsHome,
} from "../../lib/observatorio/home";
import { yearOf } from "../../lib/observatorio/derivations";
import { trail, sectionCrumb, catalogoSchema } from "../../lib/seo";
import { urls, absUrls } from "../../lib/urls";
import type { Fuente } from "../../lib/observatorio/types";

const datasets = {
  inflacion: getObservatorio(),
  empleo: getEmpleo(),
  pib: getPIB(),
  comercio: getComercio(),
  externo: getExterno(),
  demografia: getDemografia(),
  "salario-minimo": getSalarioMinimo(),
} as unknown as DatasetsHome;

const indicadores = buildIndicadoresClave(datasets);
const recientes = publicacionesRecientes(await getCollection("blog"), INFORMES);

const grupos = GRUPOS
  .map((g) => ({ ...g, items: indicadores.filter((i) => i.def.grupo === g.id) }))
  .filter((g) => g.items.length > 0);

// Cifras de contexto del hero, cada una con periodo y fuente (constitución, principio II).
const todos = Object.values(datasets) as DatasetObservatorio[];
const pib = getPIB();
const poblacion = pib.indicadores.poblacion.actual;
const nfMillones = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 1 });
const anioMasAntiguo = Math.min(...todos.map((d) => parseInt(yearOf(d.metadata.cobertura.primer_periodo), 10)));
const anioMasReciente = Math.max(...todos.map((d) => parseInt(yearOf(d.metadata.cobertura.ultimo_periodo), 10)));

const heroKpis = [
  ...(poblacion.valor !== null
    ? [{
        value: `${nfMillones.format(poblacion.valor / 1_000_000)} M`,
        label: `Habitantes · ${yearOf(poblacion.periodo)} · ${pib.metadata.fuentes.pib.nombre.split(" — ")[0]}`,
      }]
    : []),
  { value: DATASETS_PUBLICADOS.length, label: "Conjuntos de datos" },
  { value: `${anioMasAntiguo}–${anioMasReciente}`, label: "Años de historia" },
];

const ultimaActualizacion = todos
  .map((d) => d.metadata.ultima_actualizacion)
  .sort()
  .at(-1)!;
// Fuentes oficiales del panel, sin duplicados (sección de confianza y footer).
const fuentesPanel = [
  ...new Map(
    indicadores.filter((i) => i.fuente).map((i) => [i.fuente!.url, i.fuente!] as const),
  ).values(),
] as Fuente[];
const anioVersion = yearOf(ultimaActualizacion);
const citaSugerida =
  `Salazar, F. (${anioVersion}). Observatorio de Datos de Colombia [Conjunto de datos]. ${absUrls.observatorio()}`;

const TITULO = "Indicadores económicos de Colombia hoy · Observatorio";
const DESCRIPCION =
  "Inflación, tasa BanRep, desempleo, PIB y dólar en Colombia: los indicadores clave del país en un vistazo, con fuente oficial y actualización automática.";

// JSON-LD DataCatalog: un Dataset por JSON publicado (FR-015). La clave del
// archivo usa "_" y el nombre del dataset en data-client usa "-".
const jsonLd = catalogoSchema(
  DATASETS_PUBLICADOS.map((d) => {
    const data = datasets[d.clave.replace("_", "-") as keyof DatasetsHome]!;
    return {
      ...d,
      ultimaActualizacion: data.metadata.ultima_actualizacion,
      primerPeriodo: data.metadata.cobertura.primer_periodo,
      ultimoPeriodo: data.metadata.cobertura.ultimo_periodo,
      fuentes: Object.values(data.metadata.fuentes).filter((f): f is Fuente => !!f),
    };
  }),
  { nombre: TITULO, descripcion: DESCRIPCION },
);
---

<BaseLayout
  title={TITULO}
  description={DESCRIPCION}
  image="/images/observatorio-home.png"
  fullWidth={true}
  breadcrumbs={trail(sectionCrumb.observatorio)}
>
  <Hero
    badge={{ text: "Datos públicos · Colombia" }}
    title="Observatorio de Datos de Colombia"
    subtitle="Inflación, empleo, crecimiento y dólar en un solo vistazo. Cifras oficiales del DANE, el Banco de la República y el Banco Mundial, actualizadas de forma automática y explicadas para cualquier persona."
    kpis={heroKpis}
    tags={["Indicadores clave", "Fuentes oficiales", "Actualización automática"]}
    showPartners={false}
  >
    <MapaColombia slot="visual" />
  </Hero>
  <DashboardNav active="inicio" />

  <div class="observatorio-container">
    <section class="panel-clave" aria-labelledby="panel-clave-titulo">
      <div class="panel-clave__cabecera">
        <p class="panel-clave__eyebrow">Indicadores clave</p>
        <h2 class="panel-clave__titulo" id="panel-clave-titulo">Cómo va Colombia</h2>
      </div>

      <div class="panel-clave__grupos">
        {grupos.map((g) => (
          <section
            class="grupo"
            style={`--span: ${g.items.length};`}
            aria-labelledby={`grupo-${g.id}`}
          >
            <h3 class="grupo__titulo" id={`grupo-${g.id}`}>{g.titulo}</h3>
            <div class="grupo__tarjetas">
              {g.items.map((ind) => <IndicadorClaveCard indicador={ind} />)}
            </div>
          </section>
        ))}
      </div>
    </section>

  </div>

  <BandaOscura class="recientes-banda" ariaLabelledby="recientes-titulo">
    <div class="observatorio-ancho">
      <p class="seccion__eyebrow seccion__eyebrow--claro">Análisis e informes</p>
      <h2 class="seccion__titulo seccion__titulo--claro" id="recientes-titulo">Lo más reciente</h2>
      <div class="recientes">
        {recientes.map((pub) => (
          <Card
            variant="blog"
            href={pub.href}
            image={pub.imagen}
            imageAlt={pub.titulo}
            title={pub.titulo}
            description={pub.descripcion}
            date={pub.fecha}
            showTags={false}
            data-ga-event="home_publicacion_click"
            data-ga-tipo={pub.tipo}
            data-ga-destino={pub.href}
          />
        ))}
      </div>
    </div>
  </BandaOscura>

  <div class="observatorio-container">

    <section class="seccion confianza" aria-labelledby="confianza-titulo">
      <p class="seccion__eyebrow">Transparencia</p>
      <h2 class="seccion__titulo" id="confianza-titulo">Datos en los que puedes confiar</h2>
      <div class="confianza__grilla">
        <div class="confianza__bloque">
          <h3 class="confianza__subtitulo">Fuentes oficiales</h3>
          <ul class="confianza__lista">
            {fuentesPanel.map((f) => (
              <li><a href={f.url} target="_blank" rel="noopener">{f.nombre}</a> · {f.indicador}</li>
            ))}
          </ul>
        </div>
        <div class="confianza__bloque">
          <h3 class="confianza__subtitulo">Cómo se actualiza</h3>
          <p>
            Un pipeline automático descarga las fuentes oficiales varias veces al mes, valida cada serie y
            publica los datos. Si una fuente falla, se conserva la última versión válida: nunca se reemplaza
            un dato por uno más pobre.
          </p>
          <p><a href={urls.observatorioSub("acerca")}>Lee la metodología completa</a></p>
        </div>
        <div class="confianza__bloque">
          <h3 class="confianza__subtitulo">Cita y comparte</h3>
          <p>
            Las cifras, gráficos y análisis del Observatorio se publican con licencia
            <a href="https://creativecommons.org/licenses/by/4.0/deed.es" target="_blank" rel="noopener">CC BY 4.0</a>:
            puedes citarlos y compartirlos mencionando la fuente.
          </p>
          <p class="confianza__cita"><span class="confianza__cita-label">Cita sugerida</span>{citaSugerida}</p>
        </div>
      </div>
    </section>

    <section class="seccion autor" aria-label="Quién construye el Observatorio">
      <p class="seccion__eyebrow">Quién está detrás</p>
      <AuthorBio />
      <p class="autor__cta">
        <a href={urls.home()} data-ga-event="home_autor_click" data-ga-destino="perfil">
          Conoce mi trabajo y mi experiencia <span aria-hidden="true">→</span>
        </a>
      </p>
    </section>

    <DashboardFooter
      fuentes={fuentesPanel}
      ultimaActualizacion={ultimaActualizacion}
      definiciones={[
        { titulo: "Promedio de 20 años", texto: "media de los valores publicados en los últimos 20 años de cada serie." },
        { titulo: "Hace un año", texto: "valor del mismo periodo del año anterior; se usa en series en pesos o dólares corrientes." },
        { titulo: "Dato no reciente", texto: "serie mensual sin dato nuevo 45 días después del cierre del mes siguiente, o anual sin dato 15 meses después del cierre del año." },
      ]}
      cobertura={`${anioMasAntiguo} → ${anioMasReciente} · ${DATASETS_PUBLICADOS.length} conjuntos de datos`}
    />
  </div>

  <PlotlyLoader />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .observatorio-container,
  .observatorio-ancho {
    width: 97%;
    max-width: 1800px;
    margin: 0 auto;
  }

  .observatorio-container {
    padding: 1.75rem 0 3rem;
  }

  /* Dentro de la banda el padding lateral ya lo pone BandaOscura. */
  .observatorio-ancho {
    width: 100%;
  }

  .seccion__eyebrow.seccion__eyebrow--claro {
    color: #93c5fd;
  }

  .seccion__titulo.seccion__titulo--claro {
    color: #ffffff;
  }

  .panel-clave {
    margin-bottom: 1.5rem;
  }

  .panel-clave__cabecera {
    margin-bottom: 1rem;
  }

  .panel-clave__eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .panel-clave__titulo {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  /* 8 columnas lógicas: cada grupo ocupa tantas como tarjetas tiene. */
  .panel-clave__grupos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .grupo {
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .grupo__titulo {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .grupo__tarjetas {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(var(--span), minmax(0, 1fr));
    gap: 1rem;
  }

  .seccion {
    margin: 2.5rem 0 1.5rem;
  }

  .seccion__eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .seccion__titulo {
    margin: 0 0 1rem;
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .recientes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .autor__cta {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .autor__cta a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .autor__cta a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .confianza__grilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .confianza__bloque {
    padding: 1.25rem;
    background: var(--color-sidebar);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .confianza__bloque p {
    margin: 0 0 0.5rem;
  }

  .confianza__bloque a {
    color: var(--color-accent);
  }

  .confianza__subtitulo {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .confianza__lista {
    margin: 0;
    padding-left: 1.25rem;
  }

  .confianza__lista li::marker {
    color: var(--color-accent);
  }

  .confianza__cita {
    padding: 0.75rem;
    background: var(--color-bg);
    border-radius: 6px;
    word-break: break-word;
  }

  .confianza__cita-label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .recientes,
    .confianza__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .panel-clave__grupos {
      grid-template-columns: minmax(0, 1fr);
    }

    .grupo {
      grid-column: 1 / -1;
    }

    .grupo__tarjetas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .observatorio-container {
      width: 100%;
      padding: 1.25rem 1rem 2rem;
    }

    .grupo__tarjetas,
    .recientes,
    .confianza__grilla {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
