---
/**
 * Home del Observatorio de Datos de Colombia.
 * Todas las cifras salen de `public/data/*.json` en build (data.ts → home.ts);
 * las mini tendencias se cargan en cliente (REGLA 2).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import MapaColombia from "../../components/observatorio/MapaColombia.astro";
import DashboardNav from "../../components/observatorio/DashboardNav.astro";
import PanelBlueprint from "../../components/observatorio/PanelBlueprint.astro";
import PipelineBlueprint from "../../components/observatorio/PipelineBlueprint.astro";
import IndicadorClaveCard from "../../components/observatorio/IndicadorClaveCard.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import DashboardFooter from "../../components/observatorio/DashboardFooter.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";
import { INFORMES } from "../../lib/observatorio/informes";
import {
  getObservatorio,
  getEmpleo,
  getPIB,
  getComercio,
  getExterno,
  getDemografia,
  getSalarioMinimo,
} from "../../lib/observatorio/data";
import {
  DATASETS_PUBLICADOS,
  buildIndicadoresClave,
  publicacionesRecientes,
  type DatasetObservatorio,
  type DatasetsHome,
} from "../../lib/observatorio/home";
import { yearOf } from "../../lib/observatorio/derivations";
import { formatFechaActualizacion } from "../../lib/observatorio/formatters";
import { trail, sectionCrumb, catalogoSchema } from "../../lib/seo";
import { urls } from "../../lib/urls";
import type { Fuente } from "../../lib/observatorio/types";

const datasets = {
  inflacion: getObservatorio(),
  empleo: getEmpleo(),
  pib: getPIB(),
  comercio: getComercio(),
  externo: getExterno(),
  demografia: getDemografia(),
  "salario-minimo": getSalarioMinimo(),
} as unknown as DatasetsHome;

const indicadores = buildIndicadoresClave(datasets);
const recientes = publicacionesRecientes(await getCollection("blog"), INFORMES);

// Cifras de contexto del hero, cada una con periodo y fuente (constitución, principio II).
const todos = Object.values(datasets) as DatasetObservatorio[];
const pib = getPIB();
const poblacion = pib.indicadores.poblacion.actual;
const nfMillones = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 1 });
const anioMasAntiguo = Math.min(...todos.map((d) => parseInt(yearOf(d.metadata.cobertura.primer_periodo), 10)));
const anioMasReciente = Math.max(...todos.map((d) => parseInt(yearOf(d.metadata.cobertura.ultimo_periodo), 10)));

const heroKpis = [
  ...(poblacion.valor !== null
    ? [{
        value: `${nfMillones.format(poblacion.valor / 1_000_000)} M`,
        label: `Habitantes · ${yearOf(poblacion.periodo)} · ${pib.metadata.fuentes.pib.nombre.split(" — ")[0]}`,
      }]
    : []),
  { value: DATASETS_PUBLICADOS.length, label: "Conjuntos de datos" },
  { value: `${anioMasAntiguo}–${anioMasReciente}`, label: "Años de historia" },
];

const ultimaActualizacion = todos
  .map((d) => d.metadata.ultima_actualizacion)
  .sort()
  .at(-1)!;
const fechaActualizacionFmt = formatFechaActualizacion(ultimaActualizacion);

// Fuentes oficiales del panel, sin duplicados (footer).
const fuentesPanel = [
  ...new Map(
    indicadores.filter((i) => i.fuente).map((i) => [i.fuente!.url, i.fuente!] as const),
  ).values(),
] as Fuente[];

const TITULO = "Indicadores económicos de Colombia hoy · Observatorio";
const DESCRIPCION =
  "Inflación, tasa BanRep, desempleo, PIB y dólar en Colombia: los indicadores clave del país en un vistazo, con fuente oficial y actualización automática.";

const capacidades = [
  {
    titulo: "Consolidación de fuentes",
    desc: "Integración de información proveniente de entidades públicas, sistemas estadísticos y organismos nacionales en una única capa estructurada.",
    icon: "layers",
  },
  {
    titulo: "Series históricas",
    desc: "Indicadores organizados a lo largo del tiempo para analizar tendencias, cambios y comportamientos del país.",
    icon: "history",
  },
  {
    titulo: "Actualización automatizada",
    desc: "Procesos automáticos detectan y sincronizan nuevas publicaciones oficiales para mantener los indicadores al día.",
    icon: "refresh",
  },
  {
    titulo: "Visualización clara",
    desc: "Herramientas visuales que permiten consultar y comprender indicadores complejos desde una experiencia intuitiva.",
    icon: "chart",
  },
  {
    titulo: "Análisis e interpretación",
    desc: "Análisis basados en datos para facilitar la comprensión de fenómenos económicos, sociales y territoriales.",
    icon: "lens",
  },
  {
    titulo: "Acceso centralizado",
    desc: "Toda la información se presenta desde una única plataforma estructurada, accesible y abierta.",
    icon: "globe",
  },
];

// JSON-LD DataCatalog: un Dataset por JSON publicado (FR-015). La clave del
// archivo usa "_" y el nombre del dataset en data-client usa "-".
const jsonLd = catalogoSchema(
  DATASETS_PUBLICADOS.map((d) => {
    const data = datasets[d.clave.replace("_", "-") as keyof DatasetsHome]!;
    return {
      ...d,
      ultimaActualizacion: data.metadata.ultima_actualizacion,
      primerPeriodo: data.metadata.cobertura.primer_periodo,
      ultimoPeriodo: data.metadata.cobertura.ultimo_periodo,
      fuentes: Object.values(data.metadata.fuentes).filter((f): f is Fuente => !!f),
    };
  }),
  { nombre: TITULO, descripcion: DESCRIPCION },
);
---

<BaseLayout
  title={TITULO}
  description={DESCRIPCION}
  image="/images/observatorio-home.png"
  fullWidth={true}
  breadcrumbs={trail(sectionCrumb.observatorio)}
>
  <Hero
    class="hero--observatorio"
    badge={{ text: "Datos públicos · Colombia" }}
    title="Observatorio de Datos de Colombia"
    subtitle="Inflación, empleo, crecimiento y dólar en un solo vistazo. Cifras oficiales del DANE, el Banco de la República y el Banco Mundial, actualizadas de forma automática y explicadas para cualquier persona."
    kpis={heroKpis}
    tags={["Indicadores clave", "Fuentes oficiales", "Actualización automática"]}
    showPartners={false}
  >
    <MapaColombia slot="visual" />
  </Hero>
  <DashboardNav active="inicio" />

  <div class="observatorio-container">
    <!-- ─── 01 · Indicadores más importantes ─── -->
    <PanelBlueprint class="home-panel" ariaLabelledby="panel-clave-titulo">
      <header class="seccion-head">
        <div>
          <span class="seccion-index" aria-hidden="true">01</span>
          <p class="seccion-eyebrow">Indicadores clave</p>
          <h2 class="seccion-titulo" id="panel-clave-titulo">Cómo va Colombia</h2>
          <p class="seccion-subtitulo">
            Ocho indicadores macroeconómicos y sociales esenciales con su variación, tendencia y referencia histórica.
          </p>
        </div>
        <div class="panel-clave__meta">
          <span class="panel-clave__badge">
            <span class="panel-clave__dot" aria-hidden="true"></span>
            Actualizado · {fechaActualizacionFmt}
          </span>
        </div>
      </header>

      <div class="panel-clave__grilla">
        {indicadores.map((ind, idx) => (
          <IndicadorClaveCard
            indicador={ind}
            indice={String(idx + 1).padStart(2, "0")}
          />
        ))}
      </div>
    </PanelBlueprint>

    <!-- ─── 02 · Últimas publicaciones ─── -->
    <PanelBlueprint class="home-panel" ariaLabelledby="recientes-titulo">
      <header class="seccion-head">
        <div>
          <span class="seccion-index" aria-hidden="true">02</span>
          <p class="seccion-eyebrow">Análisis e informes</p>
          <h2 class="seccion-titulo" id="recientes-titulo">Últimas publicaciones</h2>
          <p class="seccion-subtitulo">
            Informes económicos mensuales, comparativos internacionales y hallazgos basados en datos oficiales.
          </p>
        </div>
        <div class="recientes-acciones">
          <a href={urls.observatorioInformes()} class="btn-outline">
            Ver informes
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href={urls.blog()} class="btn-ghost">
            Ir al blog
          </a>
        </div>
      </header>

      <div class="recientes">
        {recientes.map((pub) => (
          <Card
            variant="blog"
            href={pub.href}
            image={pub.imagen}
            imageAlt={pub.titulo}
            title={pub.titulo}
            description={pub.descripcion}
            date={pub.fecha}
            tipoBadge={
              pub.tipo === "informe"
                ? { label: "Informe especial", value: "informe" }
                : { label: "Análisis", value: "analisis" }
            }
            ctaText={pub.tipo === "informe" ? "Consultar informe" : "Leer análisis"}
            showTags={false}
            data-ga-event="home_publicacion_click"
            data-ga-tipo={pub.tipo}
            data-ga-destino={pub.href}
          />
        ))}
      </div>
    </PanelBlueprint>

    <!-- ─── 03 · Quiénes somos + Misión y Visión ─── -->
    <PanelBlueprint class="home-panel" ariaLabelledby="quienes-somos-titulo">
      <div class="quienes-grid">
        <div class="quienes-grid__lead">
          <span class="seccion-index" aria-hidden="true">03</span>
          <p class="seccion-eyebrow" id="quienes-somos-titulo">Quiénes somos</p>
          <p class="quienes-h2">
            Una plataforma <em>independiente</em> para integrar y comprender la información pública de Colombia.
          </p>
        </div>
        <div class="quienes-grid__body">
          <p>
            El <strong>Observatorio de Datos de Colombia</strong> es una plataforma independiente de integración, procesamiento, análisis y visualización de información pública del país. Es un proyecto creado y mantenido por <a href="#creador" class="identidad-link">Frederick Salazar</a>, Data Engineer.
          </p>
          <p>
            Su objetivo es consolidar en un solo lugar los principales indicadores económicos, sociales y territoriales de Colombia, ofreciendo acceso a datos históricos, actualizados y verificables desde una experiencia clara, moderna y accesible.
          </p>
        </div>
      </div>

      <div class="mision-vision" aria-label="Misión y visión del Observatorio">
        <article class="mv-card">
          <div class="mv-card__head">
            <div class="mv-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <span class="seccion-eyebrow mv-card__eyebrow">Nuestra misión</span>
          </div>
          <h3 class="mv-card__title">Democratizar el acceso a información pública confiable</h3>
          <p class="mv-card__desc">
            Construir una plataforma que permita comprender la evolución económica y social de Colombia a través de indicadores históricos, visualizaciones y análisis basados en datos verificables.
          </p>
        </article>

        <article class="mv-card">
          <div class="mv-card__head">
            <div class="mv-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <span class="seccion-eyebrow mv-card__eyebrow">Nuestra visión</span>
          </div>
          <h3 class="mv-card__title">Convertirnos en una referencia nacional de inteligencia pública abierta</h3>
          <p class="mv-card__desc">
            Construir una infraestructura abierta de datos que ciudadanos, investigadores, periodistas, empresas, estudiantes y tomadores de decisión puedan usar para interpretar la realidad del país desde información estructurada, histórica y accesible.
          </p>
        </article>
      </div>
    </PanelBlueprint>

    <!-- ─── 04 · Qué hacemos ─── -->
    <PanelBlueprint class="home-panel" ariaLabelledby="que-hacemos-titulo">
      <header class="seccion-head">
        <div>
          <span class="seccion-index" aria-hidden="true">04</span>
          <p class="seccion-eyebrow">Qué hacemos</p>
          <h2 class="seccion-titulo" id="que-hacemos-titulo">Seis capacidades, una infraestructura</h2>
          <p class="seccion-subtitulo">
            Consolidamos información pública proveniente de entidades oficiales y construimos una capa unificada de datos estructurados y actualizados.
          </p>
        </div>
      </header>

      <div class="capacidades">
        {capacidades.map((c, i) => (
          <article class="capacidad">
            <span class="capacidad__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="capacidad__icon" aria-hidden="true">
              {c.icon === "layers" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              )}
              {c.icon === "history" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><polyline points="3 3 3 8 8 8"/><polyline points="12 7 12 12 15 14"/></svg>
              )}
              {c.icon === "refresh" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
              )}
              {c.icon === "chart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              )}
              {c.icon === "lens" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              )}
              {c.icon === "globe" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              )}
            </div>
            <h3 class="capacidad__title">{c.titulo}</h3>
            <p class="capacidad__desc">{c.desc}</p>
          </article>
        ))}
      </div>
    </PanelBlueprint>

    <!-- ─── 05 · Cómo funciona (Mapa Blueprint Animado) ─── -->
    <PanelBlueprint class="home-panel" ariaLabelledby="como-funciona-titulo">
      <header class="seccion-head">
        <div>
          <span class="seccion-index" aria-hidden="true">05</span>
          <p class="seccion-eyebrow">Cómo funciona</p>
          <h2 class="seccion-titulo" id="como-funciona-titulo">Del dato disperso al indicador histórico</h2>
          <p class="seccion-subtitulo">
            Procesos automatizados recolectan información publicada por entidades oficiales y la transforman en indicadores históricos consistentes y trazables hasta llegar a este dashboard.
          </p>
        </div>
        <div class="recientes-acciones">
          <a href={urls.observatorioSub("acerca")} class="btn-outline">
            Conocer metodología
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </header>

      <PipelineBlueprint />
    </PanelBlueprint>

    <!-- ─── 06 · Iniciativa liderada por ─── -->
    <PanelBlueprint id="creador" class="home-panel" ariaLabelledby="creador-titulo">
      <div class="creador-card">
        <div class="creador-card__visual">
          <div class="creador-card__grid" aria-hidden="true"></div>
          <div class="creador-card__halo" aria-hidden="true"></div>

          <div class="creador-card__photo-frame">
            <img
              src="/images/profile.png"
              alt="Frederick Salazar"
              class="creador-card__photo"
              width="184"
              height="184"
              loading="lazy"
            />
            <span class="creador-card__status">
              <span class="creador-card__status-dot" aria-hidden="true"></span>
              Arquitecto &amp; Autor
            </span>
          </div>

          <div class="creador-card__signature">
            <span class="creador-card__sig-label">Creador del Observatorio</span>
            <span class="creador-card__sig-name">Frederick Salazar</span>
            <span class="creador-card__sig-handle">@fredericksalazar</span>
          </div>
        </div>

        <div class="creador-card__body">
          <div class="creador-card__head">
            <div>
              <span class="seccion-index" aria-hidden="true">06</span>
              <p class="seccion-eyebrow">Iniciativa liderada por</p>
              <h2 class="creador-card__name" id="creador-titulo">Frederick Salazar</h2>
            </div>
            <div class="creador-card__pills">
              <span class="creador-pill creador-pill--primary">Senior Data Architect &amp; Data Engineer</span>
              <span class="creador-pill">+8 años en LATAM</span>
              <span class="creador-pill">Datos Abiertos</span>
            </div>
          </div>

          <p class="creador-card__bio">
            El <strong>Observatorio de Datos de Colombia</strong> es una iniciativa independiente creada y liderada por Frederick Salazar con un propósito claro: <strong>democratizar el acceso a la información pública y al análisis basado en datos</strong>, para que cualquier persona —sin importar su perfil técnico— pueda comprender la evolución económica y social del país.
          </p>

          <div class="creador-card__mission">
            <div class="creador-card__mission-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <p class="creador-card__mission-text">
              <strong>Combatir la desinformación con datos.</strong> Promover una conversación pública informada, basada en evidencia oficial, trazable y verificable.
            </p>
          </div>

          <div class="creador-card__footer">
            <div class="creador-card__actions">
              <a href={urls.home()} class="btn-primary-creador">
                Ver portafolio profesional
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href={urls.proyectos()} class="btn-outline">
                Proyectos de datos
              </a>
              <a href={urls.observatorioSub("acerca")} class="btn-ghost">
                Acerca del Observatorio
              </a>
            </div>

            <div class="creador-card__socials" aria-label="Redes profesionales de Frederick Salazar">
              <a href="https://www.linkedin.com/in/fredericksalazar" target="_blank" rel="noopener noreferrer" class="creador-social" aria-label="LinkedIn de Frederick Salazar">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0z"/></svg>
                <span>LinkedIn</span>
              </a>
              <a href="https://github.com/fredericksalazar" target="_blank" rel="noopener noreferrer" class="creador-social" aria-label="GitHub de Frederick Salazar">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.7.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.2.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
                <span>GitHub</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </PanelBlueprint>

    <DashboardFooter
      fuentes={fuentesPanel}
      ultimaActualizacion={ultimaActualizacion}
      definiciones={[
        { titulo: "Promedio de 20 años", texto: "media de los valores publicados en los últimos 20 años de cada serie." },
        { titulo: "Hace un año", texto: "valor del mismo periodo del año anterior; se usa en series en pesos o dólares corrientes." },
        { titulo: "Dato no reciente", texto: "serie mensual sin dato nuevo 45 días después del cierre del mes siguiente, o anual sin dato 15 meses después del cierre del año." },
      ]}
      cobertura={`${anioMasAntiguo} → ${anioMasReciente} · ${DATASETS_PUBLICADOS.length} conjuntos de datos`}
    />
  </div>

  <PlotlyLoader />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .observatorio-container {
    width: 97%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 2.5rem 0 3.5rem;
    display: flex;
    flex-direction: column;
