  .metodologia__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .metodologia__lista li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 8px;
    font-size: 0.93rem;
    color: #334155;
    font-weight: 500;
  }
  .metodologia__lista svg {
    width: 18px;
    height: 18px;
    color: var(--color-acc);
    flex-shrink: 0;
  }

  /* ── Audiencia chips ── */
  .audiencia {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .audiencia__chip {
    padding: 0.55rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 100px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-acc);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .audiencia__chip:hover {
    border-color: var(--color-acc);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(37, 99, 235, 0.12);
  }

  /* ── Pull quote ── */
  .acerca-quote-section {
    padding: 3rem 1.5rem;
  }
  .pull-quote {
    position: relative;
    margin: 0;
    padding: 2.5rem 2rem 2.5rem 4.5rem;
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    border-radius: 16px;
    color: white;
    overflow: hidden;
  }
  .pull-quote::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.18) 1px, transparent 1.2px);
    background-size: 22px 22px;
    opacity: 0.4;
    pointer-events: none;
  }
  .pull-quote__mark {
    position: absolute;
    top: 0.5rem;
    left: 1.5rem;
    font-size: 6rem;
    font-family: Georgia, serif;
    font-weight: 700;
    line-height: 1;
    color: rgba(255, 255, 255, 0.35);
  }
  .pull-quote p {
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
    position: relative;
    max-width: 820px;
    letter-spacing: -0.01em;
  }
  .pull-quote strong {
    font-weight: 700;
  }

  /* ── Estado ── */
  .estado {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }
  .estado__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #15803d;
    margin-bottom: 1rem;
  }
  .estado__dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
  }
  .estado__cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.4rem;
    background: var(--color-acc);
    color: white;
    font-weight: 600;
    font-size: 0.92rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .estado__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
  }

  /* ── Section index numbering ── */
  .section-index {
    display: block;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-acc);
    margin-bottom: 0.45rem;
    opacity: 0.85;
  }
  .section-index--light {
    color: rgba(255, 255, 255, 0.7);
  }

  /* ── Stat strip ── */
  .stat-strip {
    background: linear-gradient(135deg, #ffffff 0%, #f0f5ff 100%);
    border-bottom: 1px solid var(--color-acc-border);
  }
  .stat-strip__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.4rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .stat-strip__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat-strip__value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-acc);
    line-height: 1;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stat-strip__live {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    animation: founderPulse 2.4s ease-out infinite;
  }
  .stat-strip__label {
    font-size: 0.78rem;
    color: #64748b;
    line-height: 1.3;
  }
  .stat-strip__divider {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, transparent, var(--color-acc-border), transparent);
  }

  /* ── Intro grid ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  .intro-h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #0f172a;
    margin: 0;
  }
  .intro-h2 em {
    color: var(--color-acc);
    font-style: normal;
    background: linear-gradient(180deg, transparent 65%, rgba(37, 99, 235, 0.15) 65%);
  }
  .intro-grid__body p {
    font-size: 1rem;
    line-height: 1.7;
    color: #475569;
    margin: 0 0 1rem;
  }
  .intro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-acc);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: gap 0.2s ease;
  }
  .intro-link svg {
    width: 18px;
    height: 18px;
  }
  .intro-link:hover {
    gap: 0.85rem;
  }

  /* ── Sección oscura (Problema) ── */
  .acerca-section--dark {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 60% at 80% -10%, rgba(37, 99, 235, 0.35) 0%, transparent 60%),
      linear-gradient(180deg, #0b1633 0%, #0e1a3d 50%, #0a1430 100%);
    color: #e2e8f0;
    padding: 5.5rem 1.5rem;
  }
  .acerca-dark__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 100% 80% at 50% 50%, black 50%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 100% 80% at 50% 50%, black 50%, transparent 100%);
    pointer-events: none;
  }
  .acerca-dark__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .acerca-dark__orb--a {
    top: -120px;
    right: -80px;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.45) 0%, transparent 70%);
  }
  .acerca-dark__orb--b {
    bottom: -100px;
    left: -100px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, transparent 70%);
  }
  .acerca-dark__inner {
    position: relative;
    z-index: 1;
  }
  .eyebrow--light {
    color: #93c5fd;
  }
  .problema-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .problema-h2 {
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 1.25rem;
  }
  .problema-h2 em {
    color: #93c5fd;
    font-style: normal;
  }
  .problema-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: #cbd5e1;
    margin: 0 0 1rem;
    max-width: 520px;
  }
  .problema-tag {
    display: inline-block;
    margin: 0.6rem 0 0;
    padding: 0.5rem 0.95rem;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #bfdbfe;
  }
  .fricciones-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .friccion-item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .friccion-item:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(96, 165, 250, 0.35);
    transform: translateX(4px);
  }
  .friccion-item__num {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: #60a5fa;
    letter-spacing: 0.05em;
  }
  .friccion-item__text {
    font-size: 0.92rem;
    color: #e2e8f0;
    line-height: 1.5;
  }
  .friccion-item__bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, #60a5fa, #3b82f6);
    transform: scaleY(0.3);
    transform-origin: center;
    transition: transform 0.25s ease;
  }
  .friccion-item:hover .friccion-item__bar {
    transform: scaleY(1);
  }

  /* ── Misión/Visión header ── */
  .mv-header {
    margin-bottom: 1.75rem;
    max-width: 720px;
  }

  /* ── Capacidades header ── */
  .caps-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .acerca-lead--inline {
    margin: 0 0 0.25rem;
    max-width: 480px;
  }
  .capacidad {
    position: relative;
  }
  .capacidad__index {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-acc);
    opacity: 0.4;
    letter-spacing: 0.08em;
  }

  /* ── Principios refinados ── */
  .princ-header {
    margin-bottom: 2rem;
  }
  .principios .principio {
    border-left: none;
    padding: 1.75rem 1.5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .principio__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }
  .principio__index {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-acc);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .principio__bar {
    flex: 1;
    height: 2px;
    background: linear-gradient(to right, var(--color-acc) 0%, transparent 100%);
    opacity: 0.35;
    transition: opacity 0.25s ease;
  }
  .principio:hover .principio__bar {
    opacity: 0.8;
  }

  /* ── Pipeline rediseñado ── */
  .pipe-header {
    margin-bottom: 2.5rem;
    max-width: 720px;
  }
  .pipe-flow {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 1rem 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }
  .pipe-flow__line {
    position: absolute;
    top: calc(1rem + 28px);
    left: 8.33%;
    right: 8.33%;
    height: 2px;
    background: linear-gradient(to right,
      transparent 0%,
      var(--color-acc) 10%,
      var(--color-acc) 90%,
      transparent 100%);
    z-index: 0;
  }
  .pipe-node {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  .pipe-node__circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--color-acc);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .pipe-node:hover .pipe-node__circle {
    transform: translateY(-3px) scale(1.05);
    background: var(--color-acc);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
  }
  .pipe-node__num {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-acc);
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }
  .pipe-node:hover .pipe-node__num {
    color: white;
  }
  .pipe-node__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #1e293b;
    text-align: center;
  }

  /* ── Fuentes monogram-wall ── */
  .src-header {
    margin-bottom: 2rem;
    max-width: 720px;
  }
  .fuentes-wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.85rem;
  }
  .fuente-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.95rem;
    padding: 0.95rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 12px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .fuente-card:hover {
    border-color: var(--color-acc);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(37, 99, 235, 0.1);
  }
  .fuente-card__monogram {
    width: 44px;
    height: 44px;
    border-radius: 9px;
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
    flex-shrink: 0;
  }
  .fuente-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .fuente-card__sigla {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
  }
  .fuente-card__nombre {
    font-size: 0.78rem;
    color: #64748b;
    line-height: 1.35;
  }
  .fuente-card__check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.12);
    color: #16a34a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .fuente-card__check svg {
    width: 12px;
    height: 12px;
  }

  /* ── Fuentes: agrupación nacional/internacional ── */
  .fuentes-group {
    margin-top: 1.5rem;
  }
  .fuentes-group:first-of-type {
    margin-top: 0;
  }
  .fuentes-group__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px dashed var(--color-acc-border);
  }
  .fuentes-group__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .fuentes-group__pill svg {
    width: 14px;
    height: 14px;
  }
  .fuentes-group__pill--nacional {
    background: var(--color-acc-soft);
    color: var(--color-acc);
    border: 1px solid var(--color-acc-border);
  }
  .fuentes-group__pill--internacional {
    background: rgba(168, 85, 247, 0.1);
    color: #7c3aed;
    border: 1px solid rgba(168, 85, 247, 0.25);
  }
  .fuentes-group__count {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.04em;
  }
  .fuente-card--intl:hover {
    border-color: #7c3aed;
    box-shadow: 0 10px 22px rgba(168, 85, 247, 0.12);
  }
  .fuente-card__monogram--intl {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
    box-shadow: 0 4px 10px rgba(168, 85, 247, 0.28);
  }

  /* ── Transiciones suaves entre claras y oscuras ── */
  .acerca-section--dark + .acerca-section,
  .acerca-section + .acerca-section--dark {
    position: relative;
  }
  .acerca-section--dark::before,
  .acerca-section--dark::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 60px;
    pointer-events: none;
    z-index: 2;
  }
  .acerca-section--dark::before {
    top: 0;
    background: linear-gradient(180deg, rgba(11, 22, 51, 1) 0%, rgba(11, 22, 51, 0) 100%);
    /* La sección oscura ya cubre el fondo; el gradiente añade un fade desde la sección anterior */
    display: none;
  }
  .acerca-section--dark::after {
    bottom: -1px;
    background: linear-gradient(180deg, rgba(10, 20, 48, 0) 0%, rgba(255, 255, 255, 0) 100%);
    display: none;
  }

  /* ── Pipeline dark ── */
  .pipe-flow--dark {
    margin-top: 2.5rem;
  }
  .pipe-flow__line--dark {
    background: linear-gradient(to right,
      transparent 0%,
      #60a5fa 10%,
      #93c5fd 50%,
      #60a5fa 90%,
      transparent 100%);
    box-shadow: 0 0 12px rgba(96, 165, 250, 0.5);
    height: 2px;
  }
  .pipe-node__circle--dark {
    background: rgba(255, 255, 255, 0.06);
    border: 2px solid rgba(96, 165, 250, 0.55);
    box-shadow:
      0 0 0 0 rgba(96, 165, 250, 0),
      0 8px 22px rgba(15, 23, 42, 0.5),
      inset 0 0 14px rgba(96, 165, 250, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .pipe-node--dark:hover .pipe-node__circle--dark {
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    border-color: #93c5fd;
    transform: translateY(-3px) scale(1.06);
    box-shadow:
      0 0 0 6px rgba(96, 165, 250, 0.18),
      0 14px 30px rgba(37, 99, 235, 0.5);
  }
  .pipe-node__num--dark {
    color: #93c5fd;
    transition: color 0.2s ease;
  }
  .pipe-node--dark:hover .pipe-node__num--dark {
    color: white;
  }
  .pipe-node__label--dark {
    color: #e2e8f0;
    font-weight: 600;
  }

  /* ── Metodología dark ── */
  .metodologia__lista--dark {
    display: grid;
    gap: 0.55rem;
  }
  .metodologia__lista--dark li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: #e2e8f0;
    font-weight: 500;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .metodologia__lista--dark li:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(96, 165, 250, 0.4);
    transform: translateX(4px);
  }
  .metodologia__num {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: #60a5fa;
    letter-spacing: 0.05em;
  }
  .metodologia__lista--dark svg {
    width: 18px;
    height: 18px;
    color: #22c55e;
    flex-shrink: 0;
  }
  .metodologia__txt {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #e2e8f0;
  }
  .metodologia__intro p {
    color: #cbd5e1;
  }

  /* ── Audiencia con check (legacy chip — sin uso) ── */
  .audiencia__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .audiencia__chip svg {
    width: 14px;
    height: 14px;
    color: var(--color-acc);
  }

  /* ── Audience grid (rediseño) ── */
  .audience-header {
    margin-bottom: 2rem;
    max-width: 760px;
  }
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.9rem;
  }
  .audience-card {
    position: relative;
    padding: 1.6rem 1.4rem 1.5rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .audience-card:hover {
    border-color: var(--color-acc);
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(37, 99, 235, 0.12);
  }
  .audience-card:hover .audience-card__icon {
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    color: white;
    transform: scale(1.05);
  }
  .audience-card:hover .audience-card__corner {
    transform: translate(-4px, 4px);
    opacity: 1;
  }
  .audience-card__icon {
    width: 46px;
    height: 46px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-acc-soft);
    color: var(--color-acc);
    margin-bottom: 1rem;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
