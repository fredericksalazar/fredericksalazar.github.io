---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import DashboardNav from "../../components/observatorio/DashboardNav.astro";

const capacidades = [
  {
    titulo: "Consolidación de fuentes",
    desc: "Integración de información proveniente de entidades públicas, sistemas estadísticos y organismos nacionales en una única capa estructurada.",
    icon: "layers",
  },
  {
    titulo: "Series históricas",
    desc: "Indicadores organizados a lo largo del tiempo para analizar tendencias, cambios y comportamientos del país.",
    icon: "history",
  },
  {
    titulo: "Actualización automatizada",
    desc: "Procesos automáticos detectan y sincronizan nuevas publicaciones oficiales para mantener los indicadores al día.",
    icon: "refresh",
  },
  {
    titulo: "Visualización clara",
    desc: "Herramientas visuales que permiten consultar y comprender indicadores complejos desde una experiencia intuitiva.",
    icon: "chart",
  },
  {
    titulo: "Análisis e interpretación",
    desc: "Análisis basados en datos para facilitar la comprensión de fenómenos económicos, sociales y territoriales.",
    icon: "lens",
  },
  {
    titulo: "Acceso centralizado",
    desc: "Toda la información se presenta desde una única plataforma estructurada, accesible y abierta.",
    icon: "globe",
  },
];

const principios = [
  { titulo: "Transparencia", desc: "Cada indicador mantiene trazabilidad sobre su origen, fecha de actualización y fuente oficial." },
  { titulo: "Rigor técnico", desc: "Priorizamos consistencia, validación y estructuración de la información procesada." },
  { titulo: "Neutralidad", desc: "Presentamos información basada en datos públicos verificables, sin orientación política o partidista." },
  { titulo: "Acceso abierto", desc: "El conocimiento basado en datos debe ser accesible para cualquier persona." },
  { titulo: "Contexto histórico", desc: "Los datos adquieren valor cuando pueden analizarse en el tiempo y dentro de un contexto más amplio." },
  { titulo: "Evolución continua", desc: "Diseñado para incorporar nuevas fuentes, indicadores y capacidades analíticas de forma progresiva." },
];

const fricciones = [
  "Dificultad para acceder a datos históricos consolidados.",
  "Diferencias de formatos y estructuras entre entidades.",
  "Baja interoperabilidad entre fuentes de información.",
  "Procesos manuales para consultar y actualizar indicadores.",
  "Limitaciones para realizar análisis comparativos y longitudinales.",
  "Barreras técnicas para ciudadanos y organizaciones no especializadas.",
];

const pipeline = [
  { paso: "01", label: "Recolección" },
  { paso: "02", label: "Normalización" },
  { paso: "03", label: "Transformación" },
  { paso: "04", label: "Estructuración" },
  { paso: "05", label: "Versionado" },
  { paso: "06", label: "Almacenamiento" },
];

const fuentesNacionales = [
  { sigla: "DANE", nombre: "Departamento Administrativo Nacional de Estadística" },
  { sigla: "BanRep", nombre: "Banco de la República" },
  { sigla: "MinHacienda", nombre: "Ministerio de Hacienda y Crédito Público" },
  { sigla: "DIAN", nombre: "Dirección de Impuestos y Aduanas Nacionales" },
  { sigla: "SFC", nombre: "Superintendencia Financiera de Colombia" },
  { sigla: "SuperSociedades", nombre: "Superintendencia de Sociedades" },
  { sigla: "Sectoriales", nombre: "Ministerios y entidades sectoriales" },
  { sigla: "Datos Abiertos", nombre: "Sistemas abiertos de datos públicos" },
];

const fuentesInternacionales = [
  { sigla: "Banco Mundial", nombre: "World Bank Open Data — indicadores de desarrollo" },
  { sigla: "FMI", nombre: "Fondo Monetario Internacional" },
  { sigla: "CEPAL", nombre: "Comisión Económica para América Latina y el Caribe" },
  { sigla: "OCDE", nombre: "Organización para la Cooperación y el Desarrollo Económicos" },
];

const audiencias = [
  { titulo: "Investigadores", desc: "Series históricas trazables para estudios académicos y publicaciones.", icon: "research" },
  { titulo: "Periodistas", desc: "Datos verificables con cita de fuente para reportajes y análisis.", icon: "news" },
  { titulo: "Estudiantes", desc: "Material estructurado para tesis, ensayos y trabajos de curso.", icon: "student" },
  { titulo: "Analistas", desc: "Indicadores listos para modelado, segmentación y tableros propios.", icon: "analyst" },
  { titulo: "Empresas", desc: "Contexto macroeconómico para decisiones de inversión y estrategia.", icon: "business" },
  { titulo: "Tomadores de decisión", desc: "Información comparable para diseñar política y planeación pública.", icon: "decision" },
  { titulo: "Entidades públicas", desc: "Referencias cruzadas con otras entidades del Estado colombiano.", icon: "gov" },
  { titulo: "Ciudadanía", desc: "Acceso abierto y comprensible para entender la realidad del país.", icon: "people" },
];

const metodologia = [
  "Integración automatizada de fuentes",
  "Estandarización de estructuras",
  "Control de calidad",
  "Validación de formatos",
  "Versionado de datos",
  "Monitoreo de actualizaciones",
  "Trazabilidad histórica de indicadores",
];
---

<BaseLayout
  title="Acerca del Observatorio de Datos de Colombia"
  description="Quiénes somos, misión, visión, principios y metodología del Observatorio de Datos de Colombia: una infraestructura abierta para entender el país a través de datos."
  fullWidth={true}
>
  <Hero
    badge={{ text: "Proyecto independiente · Colombia" }}
    title="Acerca del Observatorio"
    subtitle="Una infraestructura abierta para entender Colombia a través de datos públicos consolidados, históricos y verificables."
    tags={["Independiente", "Datos abiertos", "Trazabilidad", "Contexto histórico"]}
    showPartners={false}
  >
    <div slot="visual" class="acerca-hero-visual" aria-hidden="true">
      <svg viewBox="0 0 480 380" xmlns="http://www.w3.org/2000/svg" class="acerca-hero-svg">
        <defs>
          <linearGradient id="grad-card" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="100%" stop-color="#eef4ff" />
          </linearGradient>
          <linearGradient id="grad-bar" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#2563eb" stop-opacity="1" />
          </linearGradient>
        </defs>
        <!-- Card principal -->
        <rect x="60" y="60" width="360" height="240" rx="16" fill="url(#grad-card)" stroke="#cbd5ff" stroke-width="1.5" />
        <!-- Header card -->
        <circle cx="84" cy="86" r="6" fill="#2563eb" />
        <rect x="100" y="80" width="120" height="12" rx="3" fill="#cbd5ff" />
        <rect x="100" y="98" width="80" height="8" rx="2" fill="#dbe5ff" />
        <!-- Línea -->
        <polyline points="80,220 130,180 180,200 230,150 280,170 330,120 380,140" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <!-- Puntos -->
        <g fill="#2563eb">
          <circle cx="80" cy="220" r="4" />
          <circle cx="130" cy="180" r="4" />
          <circle cx="180" cy="200" r="4" />
          <circle cx="230" cy="150" r="4" />
          <circle cx="280" cy="170" r="4" />
          <circle cx="330" cy="120" r="4" />
          <circle cx="380" cy="140" r="4" />
        </g>
        <!-- Barras pequeñas -->
        <rect x="100" y="260" width="14" height="20" rx="2" fill="url(#grad-bar)" />
        <rect x="120" y="250" width="14" height="30" rx="2" fill="url(#grad-bar)" />
        <rect x="140" y="240" width="14" height="40" rx="2" fill="url(#grad-bar)" />
        <rect x="160" y="255" width="14" height="25" rx="2" fill="url(#grad-bar)" />
        <rect x="180" y="245" width="14" height="35" rx="2" fill="url(#grad-bar)" />
        <!-- Card flotante -->
        <rect x="280" y="240" width="120" height="56" rx="10" fill="#ffffff" stroke="#cbd5ff" stroke-width="1.5" />
        <text x="294" y="262" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#64748b" letter-spacing="1">FUENTES</text>
        <text x="294" y="284" font-family="system-ui, sans-serif" font-size="22" font-weight="700" fill="#2563eb">8+</text>
        <!-- Nodos satélite -->
        <circle cx="40" cy="120" r="14" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" />
        <circle cx="40" cy="120" r="4" fill="#2563eb" />
        <circle cx="440" cy="80" r="10" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" />
        <circle cx="440" cy="80" r="3" fill="#2563eb" />
        <circle cx="430" cy="320" r="12" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" />
        <circle cx="430" cy="320" r="3.5" fill="#2563eb" />
      </svg>
    </div>
  </Hero>

  <DashboardNav active="acerca" />

  <main class="acerca">

    <!-- ─── Stat strip ─── -->
    <section class="stat-strip" aria-label="Indicadores del Observatorio">
      <div class="stat-strip__inner">
        <div class="stat-strip__item">
          <span class="stat-strip__value">8+</span>
          <span class="stat-strip__label">Fuentes oficiales integradas</span>
        </div>
        <div class="stat-strip__divider" aria-hidden="true"></div>
        <div class="stat-strip__item">
          <span class="stat-strip__value">100%</span>
          <span class="stat-strip__label">Información pública verificable</span>
        </div>
        <div class="stat-strip__divider" aria-hidden="true"></div>
        <div class="stat-strip__item">
          <span class="stat-strip__value">Histórico</span>
          <span class="stat-strip__label">Series longitudinales por indicador</span>
        </div>
        <div class="stat-strip__divider" aria-hidden="true"></div>
        <div class="stat-strip__item">
          <span class="stat-strip__value">
            <span class="stat-strip__live" aria-hidden="true"></span>
            En vivo
          </span>
          <span class="stat-strip__label">Actualización automatizada</span>
        </div>
      </div>
    </section>

    <!-- ─── Quiénes somos ─── -->
    <section class="acerca-section acerca-intro">
      <div class="acerca-section__inner">
        <div class="intro-grid">
          <div class="intro-grid__lead">
            <span class="section-index" aria-hidden="true">01</span>
            <span class="eyebrow">Quiénes somos</span>
            <h2 class="intro-h2">
              Una plataforma <em>independiente</em> para integrar y comprender la información pública de Colombia.
            </h2>
          </div>
          <div class="intro-grid__body">
            <p>
              El <strong>Observatorio de Datos de Colombia</strong> es una plataforma independiente de integración, procesamiento, análisis y visualización de información pública del país. Es un proyecto creado y mantenido por <a href="#creador" class="acerca-link">Frederick Salazar</a>, Data Engineer.
            </p>
            <p>
              Su objetivo es consolidar en un solo lugar los principales indicadores económicos, sociales y territoriales de Colombia, ofreciendo acceso a datos históricos, actualizados y verificables desde una experiencia clara, moderna y accesible.
            </p>
            <a href="/observatorio/" class="intro-link">
              Explorar el dashboard
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Por qué nace (sección oscura) ─── -->
    <section class="acerca-section acerca-section--dark" aria-label="El problema">
      <div class="acerca-dark__grid" aria-hidden="true"></div>
      <div class="acerca-dark__orb acerca-dark__orb--a" aria-hidden="true"></div>
      <div class="acerca-dark__orb acerca-dark__orb--b" aria-hidden="true"></div>

      <div class="acerca-section__inner acerca-dark__inner">
        <div class="problema-grid">
          <header class="problema-header">
            <span class="section-index section-index--light" aria-hidden="true">02</span>
            <span class="eyebrow eyebrow--light">Por qué nace</span>
            <h2 class="problema-h2">
              Los datos existen.<br />
              <em>Convertirlos en información útil, no.</em>
            </h2>
            <p class="problema-lead">
              Múltiples entidades oficiales publican información de alto valor, pero está distribuida entre plataformas, formatos y estructuras que dificultan su consulta, integración y análisis histórico.
            </p>
            <p class="problema-tag">El Observatorio nace para resolver esa fragmentación.</p>
          </header>

          <ul class="fricciones-list" aria-label="Fricciones identificadas">
            {fricciones.map((f, i) => (
              <li class="friccion-item">
                <span class="friccion-item__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="friccion-item__text">{f}</span>
                <span class="friccion-item__bar" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ─── Misión y Visión ─── -->
    <section class="acerca-section">
      <div class="acerca-section__inner">
        <div class="mv-header">
          <span class="section-index" aria-hidden="true">03</span>
          <span class="eyebrow">Propósito</span>
          <h2 class="acerca-h2">Misión y visión del Observatorio</h2>
        </div>
        <div class="mision-vision">
          <article class="mv-card mv-card--mision">
            <div class="mv-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <span class="eyebrow">Nuestra misión</span>
            <h3 class="mv-card__title">Democratizar el acceso a información pública confiable</h3>
            <p>
              Construir una plataforma que permita comprender la evolución económica y social de Colombia a través de indicadores históricos, visualizaciones y análisis basados en datos verificables.
            </p>
          </article>

          <article class="mv-card mv-card--vision">
            <div class="mv-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <span class="eyebrow">Nuestra visión</span>
            <h3 class="mv-card__title">Convertirnos en una referencia nacional de inteligencia pública abierta</h3>
            <p>
              Construir una infraestructura abierta de datos que ciudadanos, investigadores, periodistas, empresas, estudiantes y tomadores de decisión puedan usar para interpretar la realidad del país desde información estructurada, histórica y accesible.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── Qué hacemos ─── -->
    <section class="acerca-section acerca-section--alt">
      <div class="acerca-section__inner">
        <div class="caps-header">
          <div>
            <span class="section-index" aria-hidden="true">04</span>
            <span class="eyebrow">Qué hacemos</span>
            <h2 class="acerca-h2">Seis capacidades, una infraestructura</h2>
          </div>
          <p class="acerca-lead acerca-lead--inline">
            Consolidamos información pública proveniente de entidades oficiales y construimos una capa unificada de datos estructurados y actualizados.
          </p>
        </div>

        <div class="capacidades">
          {capacidades.map((c, i) => (
            <article class="capacidad">
              <span class="capacidad__index">{String(i + 1).padStart(2, "0")}</span>
              <div class="capacidad__icon" aria-hidden="true">
                {c.icon === "layers" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                )}
                {c.icon === "history" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><polyline points="3 3 3 8 8 8"/><polyline points="12 7 12 12 15 14"/></svg>
                )}
                {c.icon === "refresh" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                )}
                {c.icon === "chart" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                )}
                {c.icon === "lens" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                )}
                {c.icon === "globe" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                )}
              </div>
              <h3 class="capacidad__title">{c.titulo}</h3>
              <p class="capacidad__desc">{c.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Principios ─── -->
    <section class="acerca-section">
      <div class="acerca-section__inner">
        <div class="princ-header">
          <span class="section-index" aria-hidden="true">05</span>
          <span class="eyebrow">Principios</span>
          <h2 class="acerca-h2">Los compromisos que guían el Observatorio</h2>
          <p class="acerca-lead">
            Reglas claras sobre cómo se trata la información, sin ambigüedades.
          </p>
        </div>

        <div class="principios">
          {principios.map((p, i) => (
            <article class="principio">
              <header class="principio__head">
                <span class="principio__index">{String(i + 1).padStart(2, "0")}</span>
                <span class="principio__bar" aria-hidden="true"></span>
              </header>
              <h3 class="principio__title">{p.titulo}</h3>
              <p>{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Cómo funciona (pipeline · oscura) ─── -->
    <section class="acerca-section acerca-section--dark" aria-label="Cómo funciona">
      <div class="acerca-dark__grid" aria-hidden="true"></div>
      <div class="acerca-dark__orb acerca-dark__orb--a" aria-hidden="true"></div>
      <div class="acerca-dark__orb acerca-dark__orb--b" aria-hidden="true"></div>

      <div class="acerca-section__inner acerca-dark__inner">
        <div class="pipe-header">
          <span class="section-index section-index--light" aria-hidden="true">06</span>
          <span class="eyebrow eyebrow--light">Cómo funciona</span>
          <h2 class="problema-h2">
            Del dato disperso al <em>indicador histórico</em>.
          </h2>
          <p class="problema-lead">
            Procesos automatizados recolectan información publicada por entidades oficiales y la transforman en indicadores históricos consistentes y trazables.
          </p>
        </div>

        <ol class="pipe-flow pipe-flow--dark" aria-label="Pasos del procesamiento de datos">
          <span class="pipe-flow__line pipe-flow__line--dark" aria-hidden="true"></span>
          {pipeline.map((p) => (
            <li class="pipe-node pipe-node--dark">
              <span class="pipe-node__circle pipe-node__circle--dark">
                <span class="pipe-node__num pipe-node__num--dark">{p.paso}</span>
              </span>
              <span class="pipe-node__label pipe-node__label--dark">{p.label}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── Fuentes ─── -->
    <section class="acerca-section">
      <div class="acerca-section__inner">
        <div class="src-header">
          <span class="section-index" aria-hidden="true">07</span>
          <span class="eyebrow">Fuentes oficiales</span>
          <h2 class="acerca-h2">Datos de entidades públicas y organismos internacionales</h2>
          <p class="acerca-lead">
            Cada indicador conserva referencia y trazabilidad hacia su fuente original. Integramos información de entidades nacionales y organismos internacionales para enriquecer el contexto.
          </p>
        </div>

        <div class="fuentes-group">
          <div class="fuentes-group__head">
            <span class="fuentes-group__pill fuentes-group__pill--nacional">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Nacionales · Colombia
            </span>
            <span class="fuentes-group__count">{fuentesNacionales.length} fuentes</span>
          </div>
          <div class="fuentes-wall">
            {fuentesNacionales.map((f) => (
              <article class="fuente-card">
                <div class="fuente-card__monogram" aria-hidden="true">
                  <span>{f.sigla.slice(0, 2).toUpperCase()}</span>
                </div>
                <div class="fuente-card__body">
                  <span class="fuente-card__sigla">{f.sigla}</span>
                  <span class="fuente-card__nombre">{f.nombre}</span>
                </div>
                <span class="fuente-card__check" aria-label="Verificada">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
              </article>
            ))}
          </div>
        </div>

        <div class="fuentes-group">
          <div class="fuentes-group__head">
            <span class="fuentes-group__pill fuentes-group__pill--internacional">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              Internacionales
            </span>
            <span class="fuentes-group__count">{fuentesInternacionales.length} fuentes</span>
          </div>
          <div class="fuentes-wall">
            {fuentesInternacionales.map((f) => (
              <article class="fuente-card fuente-card--intl">
