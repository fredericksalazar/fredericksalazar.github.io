</BaseLayout>

<style>
  .acerca {
    --color-acc: #2563eb;
    --color-acc-soft: rgba(37, 99, 235, 0.08);
    --color-acc-border: rgba(37, 99, 235, 0.18);
    font-family: "Google Sans Flex", "Google Sans", system-ui, -apple-system, sans-serif;
    color: #1e293b;
  }

  /* ── Hero visual SVG ── */
  .acerca-hero-visual {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    z-index: 1;
  }
  .acerca-hero-svg {
    width: 100%;
    max-width: 520px;
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(37, 99, 235, 0.18));
  }

  /* ── Sections base ── */
  .acerca-section {
    padding: 4.5rem 1.5rem;
  }
  .acerca-section--alt {
    background: linear-gradient(180deg, #fafbff 0%, #f5f8ff 100%);
    border-top: 1px solid rgba(37, 99, 235, 0.06);
    border-bottom: 1px solid rgba(37, 99, 235, 0.06);
  }
  .acerca-section__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .acerca-section__inner--center {
    text-align: center;
  }
  .acerca-section__inner--center .audiencia {
    justify-content: center;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-acc);
    margin-bottom: 0.85rem;
  }

  .acerca-h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #0f172a;
    margin: 0 0 1.25rem;
    max-width: 780px;
  }
  .acerca-section__inner--center .acerca-h2 {
    margin-left: auto;
    margin-right: auto;
  }

  .acerca-lead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #475569;
    max-width: 720px;
    margin: 0 0 2.25rem;
  }
  .acerca-section__inner--center .acerca-lead {
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Intro ── */
  .acerca-intro__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    margin-top: 1.25rem;
  }
  .acerca-intro__grid p {
    font-size: 1rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
  }

  /* ── Fricciones ── */
  .fricciones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.85rem;
  }
  .friccion {
    display: flex;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 10px;
    align-items: flex-start;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .friccion:hover {
    border-color: var(--color-acc);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.08);
  }
  .friccion__num {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-acc);
    background: var(--color-acc-soft);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }
  .friccion__text {
    font-size: 0.92rem;
    color: #334155;
    line-height: 1.5;
  }

  /* ── Misión / Visión ── */
  .mision-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .mv-card {
    position: relative;
    padding: 2.25rem;
    border-radius: 16px;
    border: 1px solid var(--color-acc-border);
    background: #ffffff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .mv-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.1);
  }
  .mv-card--mision {
    background: linear-gradient(180deg, #ffffff 0%, #f0f6ff 100%);
  }
  .mv-card--vision {
    background: linear-gradient(180deg, #ffffff 0%, #eef4ff 100%);
  }
  .mv-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-acc);
    color: white;
    margin-bottom: 1rem;
  }
  .mv-card__icon svg {
    width: 22px;
    height: 22px;
  }
  .mv-card__title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0.4rem 0 0.85rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .mv-card p {
    font-size: 0.97rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  /* ── Capacidades ── */
  .capacidades {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .capacidad {
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 12px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .capacidad:hover {
    border-color: var(--color-acc);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.08);
  }
  .capacidad__icon {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: var(--color-acc-soft);
    color: var(--color-acc);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
  }
  .capacidad__icon svg {
    width: 20px;
    height: 20px;
  }
  .capacidad__title {
    font-size: 1.02rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.4rem;
  }
  .capacidad__desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: #475569;
    margin: 0;
  }

  /* ── Principios ── */
  .principios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .principio {
    position: relative;
    padding: 1.6rem 1.5rem 1.5rem;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-left: 3px solid var(--color-acc);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .principio:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(37, 99, 235, 0.08);
  }
  .principio__index {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-acc);
    letter-spacing: 0.08em;
  }
  .principio__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0.3rem 0 0.45rem;
  }
  .principio p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: #475569;
    margin: 0;
  }

  /* ── Pipeline ── */
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    justify-content: center;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 14px;
  }
  .pipe-step {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.95rem;
    background: var(--color-acc-soft);
    border-radius: 8px;
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .pipe-step:hover {
    background: rgba(37, 99, 235, 0.14);
    border-color: var(--color-acc-border);
  }
  .pipe-step__num {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-acc);
    background: white;
    padding: 0.18rem 0.42rem;
    border-radius: 5px;
    letter-spacing: 0.04em;
  }
  .pipe-step__label {
    font-size: 0.92rem;
    font-weight: 600;
    color: #1e293b;
  }
  .pipe-step__arrow {
    font-size: 1.1rem;
    color: var(--color-acc);
    margin-left: 0.4rem;
    opacity: 0.7;
  }

  /* ── Fuentes ── */
  .fuentes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
  }
  .fuente {
    padding: 1rem 1.2rem;
    background: #ffffff;
    border: 1px solid var(--color-acc-border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .fuente:hover {
    border-color: var(--color-acc);
    transform: translateY(-2px);
  }
  .fuente__sigla {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-acc);
    letter-spacing: -0.01em;
  }
  .fuente__nombre {
    font-size: 0.82rem;
    color: #64748b;
    line-height: 1.4;
  }

  /* ── Metodología ── */
  .metodologia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .metodologia__intro p {
    font-size: 1rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
    max-width: 480px;
