---
/**
 * experiencia.astro — Timeline laboral y certificaciones
 * URL: /experiencia
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Experiencia como Data Engineer | Frederick Salazar";
const description =
  "+11 años diseñando arquitecturas de datos escalables, pipelines ETL/ELT y soluciones de Big Data. Trayectoria profesional como Senior Data Engineer en Globant, Mercado Libre y más en Colombia.";

const habilidades = [
  "Senior Data Engineer",
  "Data Architect",
  "Data Governance",
  "Machine Learning",
  "Artificial Intelligence",
];

const experienciaSoftware = [
  {
    empresa: "Fasttrack SAS",
    url: "https://www.fasttrack.com.co",
    rol: "Software Developer",
    periodo: "ene. 2017 — abr. 2017",
    sector: "Desarrollo de Software",
    descripcion:
      "Desarrollo y Mantenimiento de software Empresarial en Java EE, ademas de de Mantenimiento de la base de datos Oracle con PL/SQL",
    tecnologias: ["Java", "POO", "Oracle", "PL/SQL"],
    logo: "/logos/Fasttrack.png",
  },
  {
    empresa: "Codesa",
    url: "https://www.codesa.com.co",
    rol: "Software Developer",
    periodo: "nov. 2015 — dic. 2016",
    sector: "Desarrollo de Software",
    descripcion:
      "Desarrollo y mantenimiento de software Transaccional de SuperGiros en JavaSE y Oracle PLSQL, se logro la implementación de varios módulso especialmente el de verificación de seguridad con Biometria dactilar para el pago de transacciones.",
    tecnologias: ["Java", "PL/SQL", "Oracle", "Scrum"],
    logo: "/logos/codesa.png",
  },
  {
    empresa: "EPS SOS",
    url: "https://www.epssos.com.co",
    rol: "Administrador BD SIAM",
    periodo: "feb. 2014 — jul. 2015",
    sector: "HealthCare",
    descripcion:
      "Operación, administración y mantenimiento de la base dedatos SIAM para la movilidad de afiliados entre EPS, se logro automatizar el proceso mediante procesos de ETL",
    tecnologias: ["SQL Server", "Bases de datos", "ETL", "SIAM"],
    logo: "/logos/eps_sos.png",
  },
];

const experienciaData = [
  {
    empresa: "Globant",
    url: "https://www.globant.com",
    rol: "Senior Data Engineer",
    periodo: "nov. 2024 — Presente",
    sector: "Consultoría IT",
    descripcion:
      "BanReservas: Consultor experto en arquitectura e ingeniería de datos para el sector bancario. Personalización de experiencia de cliente basada en transacciones usando modelos de ML.",
    tecnologias: [
      "Estrategia de datos",
      "Machine Learning",
      "Arquitectura de Datos",
      "Azure",
    ],
    logo: "/logos/globant.png",
  },
  {
    empresa: "Mercado Libre",
    url: "https://www.mercadolibre.com.co",
    rol: "Senior Data Engineer",
    periodo: "nov. 2023 — oct. 2024",
    sector: "E-Commerce",
    descripcion:
      "Integración de datos de billing de diferentes proveedores cloud para el proceso de FinOps. Permite identificar costos y uso de servicios en tiempo real.",
    tecnologias: [
      "Estrategia de datos",
      "Google BigQuery",
      "FinOps",
      "Cloud Computing",
      "Composer",
      "Tableau",
      "Airflow",
    ],
    logo: "/logos/mercado_libre.svg",
  },
  {
    empresa: "UBITS",
    url: "https://www.ubits.co",
    rol: "Senior Data Engineer",
    periodo: "abr. 2023 — nov. 2023",
    sector: "EdTech",
    descripcion:
      "Desarrollo e implementación de soluciones de ingeniería de datos para la plataforma de capacitación corporativa más grande de LATAM.",
    tecnologias: ["NoSQL", "PySpark", "Data Engineering", "MongoDB"],
    logo: "/logos/ubits.svg",
  },
  {
    empresa: "DERCO COLOMBIA",
    url: "https://www.derco.com.co",
    rol: "Data Engineer",
    periodo: "feb. 2022 — abr. 2023",
    sector: "Retail Automotriz",
    descripcion:
      "Construcción de pipelines y procesos de análisis de datos para el sector automotriz y retail",
    tecnologias: ["Databricks", "Azure Data Factory", "SQL", "Delta Lake"],
    logo: "/logos/derco_colombia.png",
  },
  {
    empresa: "Arkano Software",
    url: "https://www.arkanosoftware.com",
    rol: "Data Engineer",
    periodo: "oct. 2021 — feb. 2022",
    sector: "Consultoría IT",
    descripcion:
      "Diseño e implementación de arquitectura de datos y soluciones analíticas para clientes externos en múltiples sectores.",
    tecnologias: ["Arquitectura de datos", "PySpark", "Cloud AWS", "Data Lake"],
    logo: "/logos/arkano_software.png",
  },
  {
    empresa: "Olimpia IT",
    url: "https://www.olimpia-it.com",
    rol: "Data Engineer",
    periodo: "mar. 2021 — oct. 2021",
    sector: "Tecnología",
    descripcion:
      "Desarrollo de procesos de integración y transformación de datos empresariales para el sector tecnológico.",
    tecnologias: ["Arquitectura de datos", "PySpark", "SQL", "Cloud"],
    logo: "/logos/olimpia_it.png",
  },
  {
    empresa: "SuperGIROS",
    url: "https://www.supergiros.com.co",
    rol: "Coordinador unidad de gestión de información",
    periodo: "ago. 2019 — feb. 2021",
    sector: "Fintech",
    descripcion:
      "Liderazgo del equipo de datos. Estrategia de información para toda la organización. Implementación de cultura data-driven.",
    tecnologias: ["QlikView", "Análisis de datos", "Liderazgo", "BI"],
    logo: "/logos/supergiros.svg",
  },
  {
    empresa: "SuperGIROS",
    url: "https://www.supergiros.com.co",
    rol: "Ingeniero de datos",
    periodo: "abr. 2017 — jul. 2019",
    sector: "Fintech",
    descripcion:
      "Desarrollo de modelos de datos e integración de sistemas para la red de giros más grande de Colombia. Creación de dashboards ejecutivos para toma de decisiones.",
    tecnologias: ["QlikView", "PostgreSQL", "ETL", "Data Warehouse"],
    logo: "/logos/supergiros.svg",
  },
];
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- Header / Hero Section -->
  <section class="exp-hero">
    <div class="exp-hero__orb exp-hero__orb--left"></div>
    <div class="exp-hero__orb exp-hero__orb--right"></div>
    
    <div class="exp-hero__container">
      <div class="exp-hero__content">
        <span class="exp-hero__badge">
          <span class="exp-hero__badge-dot"></span>
          Trayectoria profesional
        </span>
        
        <h1 class="exp-hero__headline">Experiencia Profesional</h1>
        
        <p class="exp-hero__subheadline">
          +11 años transformando datos en decisiones estratégicas. Desde administrador de bases de datos hasta Senior Data Engineer en los mayores proyectos de LATAM.
        </p>
        
        <div class="exp-hero__stats">
          <div class="exp-hero__stat">
            <span class="exp-hero__stat-number">11+</span>
            <span class="exp-hero__stat-label">Años</span>
          </div>
          <div class="exp-hero__stat">
            <span class="exp-hero__stat-number">8</span>
            <span class="exp-hero__stat-label">Compañías</span>
          </div>
          <div class="exp-hero__stat">
            <span class="exp-hero__stat-number">3</span>
            <span class="exp-hero__stat-label">Cloud</span>
          </div>
        </div>
      </div>
      
      <div class="exp-hero__certs">
        <p class="exp-hero__certs-label">Cloud Providers</p>
        <div class="exp-hero__certs-grid">
          <img src="/logos/microsoft.svg" alt="Microsoft" class="exp-hero__cert-img" />
          <img src="/logos/google.svg" alt="Google" class="exp-hero__cert-img" />
          <img src="/logos/databricks.png" alt="Databricks" class="exp-hero__cert-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Data Experience Era ── -->
  <section class="timeline-section" aria-labelledby="data-heading">
    <h2 id="data-heading" class="section-title">
      <span class="era-pill era-pill--accent">Data Experience</span>
    </h2>
    <br />
    <div class="timeline timeline--data">
      {
        experienciaData.map((item, index) => {
          const markerClass = [
            "timeline__marker",
            index === 0 ? "timeline__marker--current" : "",
            item.empresa === "Mercado Libre" ? "timeline__marker--meli" : "",
            item.empresa === "Globant" ? "timeline__marker--globant" : "",
            item.empresa === "Olimpia IT" ? "timeline__marker--olimpia" : "",
            item.empresa === "Arkano Software"
              ? "timeline__marker--arkano"
              : "",
            item.empresa === "DERCO COLOMBIA" ? "timeline__marker--derco" : "",
            item.empresa === "UBITS" ? "timeline__marker--ubits" : "",
            item.empresa === "SuperGIROS" ? "timeline__marker--supergiros" : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <div class="timeline__item">
              <div class={markerClass}>
                <img
                  src={item.logo}
                  alt={`Logo ${item.empresa}`}
                  class="timeline__logo"
                  width="100"
                  height="100"
                  style="width: 100%; height: 100%; object-fit: contain; padding: 12%; box-sizing: border-box; background: white;"
                  onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${item.empresa.replace(/\\s+/g, "+")}&background=random';`}
                  loading="lazy"
                />
              </div>
              <div class="timeline__content">
                <div class="timeline__header">
                  <h3 class="timeline__role">{item.rol}</h3>
                  <span class="timeline__period">{item.periodo}</span>
                </div>
                <h4 class="timeline__company">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.empresa}
                  </a>
                </h4>
                {item.sector && (
                  <div class="timeline__sector">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>{item.sector}</span>
                  </div>
                )}
                <p class="timeline__desc">{item.descripcion}</p>
                <div class="timeline__tags">
                  {item.tecnologias.map((tech) => (
                    <span class="tag tag--small">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ── Software Engineer Era ── -->
  <section class="timeline-section" aria-labelledby="software-heading">
    <h2 id="software-heading" class="section-title">
      <span class="era-pill">Software Engineer</span>
    </h2>
    <br />

    <div class="timeline">
      {
        experienciaSoftware.map((item) => {
          const markerClass = [
            "timeline__marker",
            item.empresa === "Fasttrack SAS"
              ? "timeline__marker--fasttrack"
              : "",
            item.empresa === "Codesa" ? "timeline__marker--codesa" : "",
            item.empresa === "EPS SOS" ? "timeline__marker--sos" : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <div class="timeline__item">
              <div class={markerClass}>
                <img
                  src={item.logo}
                  alt={`Logo ${item.empresa}`}
                  class="timeline__logo"
                  width="100"
                  height="100"
                  style="width: 100%; height: 100%; object-fit: contain; padding: 12%; box-sizing: border-box; background: white;"
                  onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${item.empresa.replace(/\\s+/g, "+")}&background=random';`}
                  loading="lazy"
                />
              </div>
              <div class="timeline__content">
                <div class="timeline__header">
                  <h3 class="timeline__role">{item.rol}</h3>
                  <span class="timeline__period">{item.periodo}</span>
                </div>
                <h4 class="timeline__company">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.empresa}
                  </a>
                </h4>
                {item.sector && (
                  <div class="timeline__sector">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>{item.sector}</span>
                  </div>
                )}
                <p class="timeline__desc">{item.descripcion}</p>
                <div class="timeline__tags">
                  {item.tecnologias.map((tech) => (
                    <span class="tag tag--small">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Animaciones de entrada ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(3%, 5%) scale(1.05); }
  }

  /* ── Hero Section ── */
  .exp-hero {
    position: relative;
    overflow: hidden;
    background: 
      radial-gradient(circle at center, rgba(56, 189, 248, 0.08) 0%, transparent 50%),
      linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
    padding: 6rem 2rem 5rem;
    min-height: 500px;
    display: flex;
    align-items: center;
  }

  .exp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle, rgba(255, 255, 255, 0.2) 1px, transparent 1px);
    background-size: 25px 25px;
    opacity: 0.6;
    pointer-events: none;
  }

  .exp-hero__orb {
    position: absolute;
    width: 50vw;
    height: 50vw;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: float 20s ease-in-out infinite alternate;
    z-index: 0;
  }

  .exp-hero__orb--left {
    background: radial-gradient(circle, rgba(56, 189, 248, 0.5) 0%, transparent 70%);
    top: -15%;
    left: -10%;
  }

  .exp-hero__orb--right {
    background: radial-gradient(circle, rgba(168, 85, 247, 0.5) 0%, transparent 70%);
    bottom: -15%;
    right: -10%;
    animation-delay: -10s;
  }

  .exp-hero__container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .exp-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #4ade80;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.6s ease-out;
  }

  .exp-hero__badge-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
  }

  .exp-hero__headline {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    animation: fadeInUp 0.6s ease-out 0.1s backwards;
  }

  .exp-hero__subheadline {
    font-size: 1.2rem;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 480px;
    animation: fadeInUp 0.6s ease-out 0.2s backwards;
  }

  .exp-hero__stats {
    display: flex;
    gap: 3rem;
    animation: fadeInUp 0.6s ease-out 0.3s backwards;
    margin-bottom: 2rem;
  }

  .exp-hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .exp-hero__stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .exp-hero__stat-label {
    font-size: 0.9rem;
    color: #64748b;
  }

  /* ── Panel derecho (como certs del home) ── */
  .exp-hero__certs {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    animation: fadeInUp 0.6s ease-out 0.5s backwards;
  }

  .exp-hero__certs-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
    margin-bottom: 1.25rem;
  }

  .exp-hero__certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .exp-hero__cert-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .exp-hero__cert-img:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  /* ── Skills ── */
  .exp-hero__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: rgba(37, 99, 235, 0.15);
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #60a5fa;
  }

  /* ── Timeline Styles ── */

  .exp-hero__industries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .exp-hero__industries span {
    font-size: 0.7rem;
    color: #a78bfa;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .exp-hero__industries-col {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .exp-hero__industries-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .exp-hero__providers {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    align-items: center;
  }

  .provider-icon {
    height: 20px;
    width: auto;
  }

  .provider-icon--png {
    height: 24px;
    border-radius: 4px;
    background: white;
    padding: 2px 4px;
  }

  /* ── Section Title ── */
  .section-title {
    font-size: 1.6rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .era-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1rem;
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 100px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #2563eb;
  }

  .era-pill--accent {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
    color: #16a34a;
  }

  /* Timeline */
  .timeline-section {
    max-width: 900px;
    margin: 4rem auto 4.5rem;
    padding: 0 1.5rem;
  }

  .timeline {
    position: relative;
    padding-left: 8rem;
  }

  /* Línea vertical */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 4rem;
    width: 2px;
    background: var(--color-border);
    border-radius: 2px;
  }

  .timeline__item {
    position: relative;
    margin-bottom: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  .timeline__item:last-child {
    margin-bottom: 0;
  }

  /* Punto en la línea */
  .timeline__marker {
    position: absolute;
    top: 0;
    left: -7.125rem;
    width: 6.25rem;
    height: 6.25rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    box-shadow: 0 0 0 4px var(--color-bg);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .timeline__marker--sos,
  .timeline__marker--meli,
  .timeline__marker--ubits,
  .timeline__marker--arkano,
  .timeline__marker--derco,
  .timeline__marker--supergiros,
  .timeline__marker--fasttrack,
  .timeline__marker--codesa {
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 10px rgba(0, 0, 0, 0.12) !important;
  }

  .timeline--data .timeline__marker {
    border-color: var(--color-accent);
  }

  .timeline__marker--current {
    border: 3px solid #22c55e !important;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 16px rgba(34, 197, 94, 0.4) !important;
  }

  .timeline__marker--meli {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #ffcb00, #2563eb) border-box !important;
  }

  .timeline__marker--ubits {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #1e3a5f, #9ca3af) border-box !important;
  }

  .timeline__marker--meli {
    border-color: #ffcb00 !important;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 12px rgba(255, 203, 0, 0.25) !important;
  }

  .timeline__marker--olimpia {
    border-color: #ef4444 !important;
    box-shadow:
      0 0 0 4px var(--color-bg),
