---
/**
 * experiencia.astro — Timeline laboral y certificaciones
 * URL: /experiencia
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = 'Experiencia Profesional & Certificaciones — Frederick Salazar';
const description = 'Timeline de experiencia laboral de Frederick Salazar como Data Engineer en Mercado Libre, Globant, UBITS, Derco y más. Certificaciones Azure y Databricks.';

const experiencia = [
  {
    empresa: 'Globant',
    rol: 'Senior Data Engineer',
    periodo: 'nov. 2024 — Presente',
    descripcion: 'BanReservas: Consultor experto en arquitectura e ingeniería de datos para el sector bancario. Personalización de experiencia de cliente basada en transacciones usando modelos de ML.',
    tecnologias: ['Estrategia de datos', 'Machine Learning', 'Arquitectura de Datos'],
    logo: '/logos/globant.png'
  },
  {
    empresa: 'Mercado Libre',
    rol: 'Senior Data Engineer',
    periodo: 'nov. 2023 — oct. 2024',
    descripcion: 'Integración de datos de billing de diferentes proveedores cloud para el proceso de FinOps, permitiendo identificar costos y uso de servicios.',
    tecnologias: ['Estrategia de datos', 'Google BigQuery', 'FinOps', 'Cloud Computing'],
    logo: '/logos/mercado_libre.svg'
  },
  {
    empresa: 'UBITS',
    rol: 'Senior Data Engineer',
    periodo: 'abr. 2023 — nov. 2023',
    descripcion: 'Desarrollo e implementación de soluciones de ingeniería de datos para la plataforma de capacitación corporativa.',
    tecnologias: ['NoSQL', 'PySpark', 'Data Engineering'],
    logo: '/logos/ubits.svg'
  },
  {
    empresa: 'DERCO COLOMBIA',
    rol: 'Data Engineer',
    periodo: 'feb. 2022 — abr. 2023',
    descripcion: 'Construcción de pipelines y procesos de datos para el sector automotriz y retail.',
    tecnologias: ['PySpark', 'Azure Data Factory'],
    logo: '/logos/derco_colombia.png'
  },
  {
    empresa: 'Arkano Software',
    rol: 'Data Engineer',
    periodo: 'oct. 2021 — feb. 2022',
    descripcion: 'Diseño e implementación de arquitectura de datos y soluciones analíticas para clientes externos.',
    tecnologias: ['Arquitectura de datos', 'PySpark'],
    logo: '/logos/arkano_software.png'
  },
  {
    empresa: 'Olimpia IT',
    rol: 'Data Engineer',
    periodo: 'mar. 2021 — oct. 2021',
    descripcion: 'Desarrollo de procesos de integración y transformación de datos empresariales.',
    tecnologias: ['Arquitectura de datos', 'PySpark'],
    logo: '/logos/olimpia_it.png'
  },
  {
    empresa: 'SuperGIROS',
    rol: 'Coordinador unidad de gestión de información',
    periodo: 'ago. 2019 — feb. 2021',
    descripcion: 'Liderazgo en la gestión de información y analítica de la compañía.',
    tecnologias: ['QlikView', 'Análisis de datos'],
    logo: '/logos/supergiros.svg'
  },
  {
    empresa: 'SuperGIROS',
    rol: 'Ingeniero de datos',
    periodo: 'abr. 2017 — jul. 2019',
    descripcion: 'Desarrollo de modelos de datos e integración de sistemas.',
    tecnologias: ['QlikView', 'PostgreSQL'],
    logo: '/logos/supergiros.svg'
  },
  {
    empresa: 'Fasttrack SAS',
    rol: 'Software Developer',
    periodo: 'ene. 2017 — abr. 2017',
    descripcion: 'Desarrollo de aplicaciones de software.',
    tecnologias: ['Java', 'POO'],
    logo: '/logos/Fasttrack.png'
  },
  {
    empresa: 'Codesa',
    rol: 'Software Developer',
    periodo: 'nov. 2015 — dic. 2016',
    descripcion: 'Desarrollo y mantenimiento de software.',
    tecnologias: ['Java', 'PL/SQL'],
    logo: '/logos/codesa.png'
  },
  {
    empresa: 'EPS SOS',
    rol: 'Administrador BD SIAM',
    periodo: 'feb. 2014 — jul. 2015',
    descripcion: 'Administrar la base de datos de afiliados de la EPS SOS, gestionar y actualizar el sistema SIAM para controlar la movilidad de afiliados.',
    tecnologias: ['Bases de datos', 'PL/SQL'],
    logo: '/logos/eps_sos.png'
  }
];

const certificaciones = [
  {
    nombre: 'Azure Data Engineer Associate (DP-203)',
    emisor: 'Microsoft',
    fecha: '2023'
  },
  {
    nombre: 'Azure Fundamentals (AZ-900)',
    emisor: 'Microsoft',
    fecha: '2022'
  },
  {
    nombre: 'Databricks Certified Data Engineer Associate',
    emisor: 'Databricks',
    fecha: '2023'
  },
  {
    nombre: 'Master en Big Data Analytics',
    emisor: 'Universitat Oberta de Catalunya (UOC)',
    fecha: '2021'
  }
];
---

<BaseLayout title={title} description={description}>

  <!-- ── Header ─────────────────────────────────────────────────────────── -->
  <section aria-labelledby="exp-heading" class="exp-header">
    <h1 id="exp-heading" class="page-title">Experiencia</h1>
    <p class="page-subtitle">
      Mi trayectoria como ingeniero de datos, consultor y desarrollador desde 2015.
    </p>
  </section>

  <!-- ── Timeline de Experiencia ────────────────────────────────────────── -->
  <section class="timeline-section" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="section-title">Trayectoria Profesional</h2>
    
    <div class="timeline">
      {experiencia.map((item, index) => (
        <div class="timeline__item">
          <div class="timeline__marker">
            <img 
              src={item.logo} 
              alt={`Logo ${item.empresa}`} 
              class="timeline__logo" 
              width="100"
              height="100"
              style="width: 100%; height: 100%; object-fit: contain; padding: 12%; box-sizing: border-box; background: white;"
              onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${item.empresa.replace(/\\s+/g, '+')}&background=random';`}
              loading="lazy"
            />
          </div>
          <div class="timeline__content">
            <div class="timeline__header">
              <h3 class="timeline__role">{item.rol}</h3>
              <span class="timeline__period">{item.periodo}</span>
            </div>
            <h4 class="timeline__company">{item.empresa}</h4>
            <p class="timeline__desc">{item.descripcion}</p>
            <div class="timeline__tags">
              {item.tecnologias.map((tech) => (
                <span class="tag tag--small">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Certificaciones ────────────────────────────────────────────────── -->
  <section class="certs-section" aria-labelledby="certs-heading">
    <h2 id="certs-heading" class="section-title">Certificaciones & Educación</h2>
    
    <div class="certs-grid">
      {certificaciones.map((cert) => (
        <div class="cert-card">
          <div class="cert-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="cert-card__info">
            <h3 class="cert-card__name">{cert.nombre}</h3>
            <p class="cert-card__issuer">{cert.emisor} <span class="cert-card__dot">·</span> {cert.fecha}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Headers ────────────────────────────────────────────────────────────── */
  .exp-header {
    margin-bottom: 3.5rem;
  }
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 100%;
  }
  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--color-text-primary);
  }

  /* ── Timeline ───────────────────────────────────────────────────────────── */
  .timeline-section {
    margin-bottom: 4.5rem;
  }

  .timeline {
    position: relative;
    padding-left: 8rem;
  }
  
  /* Línea vertical */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 4rem; /* Centrado con el marker */
    width: 2px;
    background: var(--color-border);
    border-radius: 2px;
  }

  .timeline__item {
    position: relative;
    margin-bottom: 3.5rem;
    min-height: 6.25rem;
  }
  .timeline__item:last-child {
    margin-bottom: 0;
  }

  /* Punto en la línea */
  .timeline__marker {
    position: absolute;
    top: 0;
    left: -7.125rem;
    width: 6.25rem;
    height: 6.25rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    box-shadow: 0 0 0 4px var(--color-bg); /* Espacio alrededor del punto */
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .timeline__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12%;
    box-sizing: border-box;
    background: white;
  }

  .timeline__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .timeline__role {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .timeline__period {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .timeline__company {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0 0 0.75rem 0;
  }

  .timeline__desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 100%;
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag--small {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
  }

  /* ── Certificaciones ────────────────────────────────────────────────────── */
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-tag-bg);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  
  .cert-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .cert-card__icon {
    flex-shrink: 0;
    color: var(--color-accent);
    padding: 0.5rem;
    background: var(--color-bg);
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cert-card__name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .cert-card__issuer {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .cert-card__dot {
    opacity: 0.5;
    margin: 0 0.25rem;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 6rem;
    }
    .timeline::before {
      left: 3rem;
    }
    .timeline__marker {
      width: 4.5rem;
      height: 4.5rem;
      left: -5.25rem; /* 3rem - 2.25rem = 0.75rem relative to timeline. 0.75rem - 6rem = -5.25rem */
    }
    .timeline__item {
      min-height: 4.5rem;
    }
  }

  @media (max-width: 600px) {
    .timeline__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .certs-grid {
      grid-template-columns: 1fr;
    }
    
    .timeline {
      padding-left: 4rem;
    }
    .timeline::before {
      left: 2rem;
    }
    .timeline__marker {
      width: 3.5rem;
      height: 3.5rem;
      left: -3.75rem; /* 2rem - 1.75rem = 0.25rem relative to timeline. 0.25rem - 4rem = -3.75rem */
    }
    .timeline__item {
      min-height: 3.5rem;
    }
  }
</style>
