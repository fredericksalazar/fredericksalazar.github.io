---
/**
 * experiencia.astro — Timeline laboral y certificaciones
 * URL: /experiencia
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";

const title = "Experiencia como Data Engineer";
const description =
  "+11 años diseñando arquitecturas de datos, pipelines ETL/ELT y soluciones de Big Data. Senior Data Engineer en Globant y otras compañías en Colombia.";

const habilidades = [
  "Senior Data Engineer",
  "Data Architect",
  "Data Governance",
  "Machine Learning",
  "Artificial Intelligence",
];

const experienciaSoftware = [
  {
    empresa: "Fasttrack SAS",
    url: "https://www.fasttrack.com.co",
    rol: "Software Developer",
    periodo: "ene. 2017 — abr. 2017",
    sector: "Desarrollo de Software",
    descripcion:
      "Desarrollo y Mantenimiento de software Empresarial en Java EE, además de Mantenimiento de la base de datos Oracle con PL/SQL",
    tecnologias: ["Java", "POO", "Oracle", "PL/SQL"],
    logo: "/logos/Fasttrack.png",
  },
  {
    empresa: "Codesa",
    url: "https://www.codesa.com.co",
    rol: "Software Developer",
    periodo: "nov. 2015 — dic. 2016",
    sector: "Desarrollo de Software",
    descripcion:
      "Desarrollo y mantenimiento de software Transaccional de SuperGiros en JavaSE y Oracle PLSQL, se logro la implementación de varios módulso especialmente el de verificación de seguridad con Biometria dactilar para el pago de transacciones.",
    tecnologias: ["Java", "PL/SQL", "Oracle", "Scrum"],
    logo: "/logos/codesa.png",
  },
  {
    empresa: "EPS SOS",
    url: "https://www.epssos.com.co",
    rol: "Administrador BD SIAM",
    periodo: "feb. 2014 — jul. 2015",
    sector: "HealthCare",
    descripcion:
      "Operación, administración y mantenimiento de la base dedatos SIAM para la movilidad de afiliados entre EPS, se logro automatizar el proceso mediante procesos de ETL",
    tecnologias: ["SQL Server", "Bases de datos", "ETL", "SIAM"],
    logo: "/logos/eps_sos.png",
  },
];

const experienciaData = [
  {
    empresa: "Globant",
    url: "https://www.globant.com",
    rol: "Senior Data Engineer",
    periodo: "nov. 2024 — Presente",
    sector: "Consultoría IT",
    descripcion:
      "BanReservas: Consultor experto en arquitectura e ingeniería de datos para el sector bancario. Personalización de experiencia de cliente basada en transacciones usando modelos de ML.",
    tecnologias: [
      "Estrategia de datos",
      "Machine Learning",
      "Arquitectura de Datos",
      "Azure",
    ],
    logo: "/logos/globant.png",
  },
  {
    empresa: "Mercado Libre",
    url: "https://www.mercadolibre.com.co",
    rol: "Senior Data Engineer",
    periodo: "nov. 2023 — oct. 2024",
    sector: "E-Commerce",
    descripcion:
      "Integración de datos de billing de diferentes proveedores cloud para el proceso de FinOps. Permite identificar costos y uso de servicios en tiempo real.",
    tecnologias: [
      "Estrategia de datos",
      "Google BigQuery",
      "FinOps",
      "Cloud Computing",
      "Composer",
      "Tableau",
      "Airflow",
    ],
    logo: "/logos/mercado_libre.svg",
  },
  {
    empresa: "UBITS",
    url: "https://www.ubits.co",
    rol: "Senior Data Engineer",
    periodo: "abr. 2023 — nov. 2023",
    sector: "EdTech",
    descripcion:
      "Desarrollo e implementación de soluciones de ingeniería de datos para la plataforma de capacitación corporativa más grande de LATAM.",
    tecnologias: ["NoSQL", "PySpark", "Data Engineering", "MongoDB"],
    logo: "/logos/ubits.svg",
  },
  {
    empresa: "DERCO COLOMBIA",
    url: "https://www.derco.com.co",
    rol: "Data Engineer",
    periodo: "feb. 2022 — abr. 2023",
    sector: "Retail Automotriz",
    descripcion:
      "Construcción de pipelines y procesos de análisis de datos para el sector automotriz y retail",
    tecnologias: ["Databricks", "Azure Data Factory", "SQL", "Delta Lake"],
    logo: "/logos/derco_colombia.png",
  },
  {
    empresa: "Arkano Software",
    url: "https://www.arkanosoftware.com",
    rol: "Data Engineer",
    periodo: "oct. 2021 — feb. 2022",
    sector: "Consultoría IT",
    descripcion:
      "Diseño e implementación de arquitectura de datos y soluciones analíticas para clientes externos en múltiples sectores.",
    tecnologias: ["Arquitectura de datos", "PySpark", "Cloud AWS", "Data Lake"],
    logo: "/logos/arkano_software.png",
  },
  {
    empresa: "Olimpia IT",
    url: "https://www.olimpia-it.com",
    rol: "Data Engineer",
    periodo: "mar. 2021 — oct. 2021",
    sector: "Tecnología",
    descripcion:
      "Desarrollo de procesos de integración y transformación de datos empresariales para el sector tecnológico.",
    tecnologias: ["Arquitectura de datos", "PySpark", "SQL", "Cloud"],
    logo: "/logos/olimpia_it.png",
  },
  {
    empresa: "SuperGIROS",
    url: "https://www.supergiros.com.co",
    rol: "Coordinador unidad de gestión de información",
    periodo: "ago. 2019 — feb. 2021",
    sector: "Fintech",
    descripcion:
      "Liderazgo del equipo de datos. Estrategia de información para toda la organización. Implementación de cultura data-driven.",
    tecnologias: ["QlikView", "Análisis de datos", "Liderazgo", "BI"],
    logo: "/logos/supergiros.svg",
  },
  {
    empresa: "SuperGIROS",
    url: "https://www.supergiros.com.co",
    rol: "Ingeniero de datos",
    periodo: "abr. 2017 — jul. 2019",
    sector: "Fintech",
    descripcion:
      "Desarrollo de modelos de datos e integración de sistemas para la red de giros más grande de Colombia. Creación de dashboards ejecutivos para toma de decisiones.",
    tecnologias: ["QlikView", "PostgreSQL", "ETL", "Data Warehouse"],
    logo: "/logos/supergiros.svg",
  },
];
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- Hero Section -->
  <Hero
    badge={{ text: "Trayectoria profesional" }}
    title="Experiencia Profesional"
    subtitle="+11 años transformando datos en decisiones estratégicas. Desde administrador de bases de datos hasta Senior Data Engineer en los mayores proyectos de LATAM."
    kpis={[
      { value: "11+", label: "Años" },
      { value: "8", label: "Compañías" },
      { value: "3", label: "Cloud" },
    ]}
  >
    <Fragment slot="visual">
      <div class="exp-hero__companies">
        <div class="exp-hero__company-logo" title="Globant">
          <img src="/logos/globant.png" alt="Globant" width="40" height="40" />
        </div>
        <div class="exp-hero__company-logo" title="Mercado Libre">
          <img src="/logos/mercado_libre.svg" alt="Mercado Libre" width="40" height="40" />
        </div>
        <div class="exp-hero__company-logo" title="SuperGIROS">
          <img src="/logos/supergiros.svg" alt="SuperGIROS" width="40" height="40" />
        </div>
        <div class="exp-hero__company-logo" title="UBITS">
          <img src="/logos/ubits.svg" alt="UBITS" width="40" height="40" />
        </div>
        <div class="exp-hero__company-logo" title="DERCO Colombia">
          <img src="/logos/derco_colombia.png" alt="DERCO Colombia" width="40" height="40" />
        </div>
        <div class="exp-hero__company-logo" title="Arkano Software">
          <img src="/logos/arkano_software.png" alt="Arkano Software" width="40" height="40" />
        </div>
      </div>
    </Fragment>
  </Hero>

  <!-- ── Resumen ejecutivo ── -->
  <section class="exp-summary" aria-label="Resumen de trayectoria">
    <p class="exp-summary__lead">
      Mi trayectoria profesional combina más de <strong>11 años de experiencia</strong> en
      ingeniería de software, administración de bases de datos, ingeniería de datos y
      arquitectura de datos. Empecé como desarrollador Java EE construyendo aplicaciones
      empresariales y administrando bases de datos Oracle PL/SQL, pasé por la administración
      de sistemas sectoriales en salud (EPS SOS) y, desde 2017, mi carrera giró completamente
      hacia el mundo del dato.
    </p>
    <p>
      En los últimos años he liderado equipos de datos, definido estrategias de información a
      nivel organizacional y diseñado arquitecturas para Fintech (SuperGIROS, la red de giros
      más grande de Colombia), retail automotriz (DERCO), EdTech (UBITS), e-commerce a escala
      (Mercado Libre) y consultoría bancaria para clientes corporativos (BanReservas, desde
      Globant). Cada uno de estos contextos exigió decisiones de arquitectura distintas — desde
      modelar un Data Warehouse para QlikView, hasta diseñar pipelines de FinOps en BigQuery,
      pasando por Delta Lake sobre Databricks y procesos PySpark en AWS.
    </p>
    <p>
      Mi stack actual cubre los tres principales clouds (<strong>Azure</strong>,
      <strong>Google Cloud</strong> y <strong>AWS</strong>), procesamiento distribuido con
      Apache Spark y Databricks, orquestación con Airflow y Composer, modelado con dbt, y un
      fuerte componente de Machine Learning aplicado a problemas concretos de negocio. En
      paralelo, mantengo un perfil técnico cercano al código — Python y SQL son herramientas
      diarias — y un interés constante por gobernanza de datos, calidad del dato y diseño de
      plataformas Data Lakehouse.
    </p>
  </section>

  <!-- ── Data Experience Era ── -->
  <section class="timeline-section" aria-labelledby="data-heading">
    <h2 id="data-heading" class="section-title">
      <span class="era-pill era-pill--accent">Data Experience</span>
    </h2>
    <br />
    <div class="timeline timeline--data">
      {
        experienciaData.map((item, index) => {
          const markerClass = [
            "timeline__marker",
            index === 0 ? "timeline__marker--current" : "",
            item.empresa === "Mercado Libre" ? "timeline__marker--meli" : "",
            item.empresa === "Globant" ? "timeline__marker--globant" : "",
            item.empresa === "Olimpia IT" ? "timeline__marker--olimpia" : "",
            item.empresa === "Arkano Software"
              ? "timeline__marker--arkano"
              : "",
            item.empresa === "DERCO COLOMBIA" ? "timeline__marker--derco" : "",
            item.empresa === "UBITS" ? "timeline__marker--ubits" : "",
            item.empresa === "SuperGIROS" ? "timeline__marker--supergiros" : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <div class="timeline__item">
              <div class={markerClass}>
                <img
                  src={item.logo}
                  alt={`Logo ${item.empresa}`}
                  class="timeline__logo"
                  width="100"
                  height="100"
                  style="width: 100%; height: 100%; object-fit: contain; padding: 12%; box-sizing: border-box; background: white;"
                  onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${item.empresa.replace(/\\s+/g, "+")}&background=random';`}
                  loading="lazy"
                />
              </div>
              <div class="timeline__content">
                <div class="timeline__header">
                  <h3 class="timeline__role">{item.rol}</h3>
                  <span class="timeline__period">{item.periodo}</span>
                </div>
                <p class="timeline__company">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.empresa}
                  </a>
                </p>
                {item.sector && (
                  <div class="timeline__sector">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>{item.sector}</span>
                  </div>
                )}
                <p class="timeline__desc">{item.descripcion}</p>
                <div class="timeline__tags">
                  {item.tecnologias.map((tech) => (
                    <span class="tag tag--small">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ── Software Engineer Era ── -->
  <section class="timeline-section" aria-labelledby="software-heading">
    <h2 id="software-heading" class="section-title">
      <span class="era-pill">Software Engineer</span>
    </h2>
    <br />

    <div class="timeline">
      {
        experienciaSoftware.map((item) => {
          const markerClass = [
            "timeline__marker",
            item.empresa === "Fasttrack SAS"
              ? "timeline__marker--fasttrack"
              : "",
            item.empresa === "Codesa" ? "timeline__marker--codesa" : "",
            item.empresa === "EPS SOS" ? "timeline__marker--sos" : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <div class="timeline__item">
              <div class={markerClass}>
                <img
                  src={item.logo}
                  alt={`Logo ${item.empresa}`}
                  class="timeline__logo"
                  width="100"
                  height="100"
                  style="width: 100%; height: 100%; object-fit: contain; padding: 12%; box-sizing: border-box; background: white;"
                  onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${item.empresa.replace(/\\s+/g, "+")}&background=random';`}
                  loading="lazy"
                />
              </div>
              <div class="timeline__content">
                <div class="timeline__header">
                  <h3 class="timeline__role">{item.rol}</h3>
                  <span class="timeline__period">{item.periodo}</span>
                </div>
                <p class="timeline__company">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.empresa}
                  </a>
                </p>
                {item.sector && (
                  <div class="timeline__sector">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>{item.sector}</span>
                  </div>
                )}
                <p class="timeline__desc">{item.descripcion}</p>
                <div class="timeline__tags">
                  {item.tecnologias.map((tech) => (
                    <span class="tag tag--small">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Animaciones de entrada ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Logos circulares de empresas ── */
  .exp-hero__companies {
    position: absolute;
    right: 8%;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding: 1rem;
  }

  .exp-hero__company-logo {
    width: 162px;
    height: 162px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
    cursor: default;
  }

  .exp-hero__company-logo img {
    width: 97px;
    height: 97px;
    object-fit: contain;
    filter: grayscale(0.3);
  }

  .exp-hero__company-logo:hover {
    transform: scale(1.08);
  }

  .exp-hero__company-logo:hover img {
    filter: grayscale(0);
  }

  /* ── Skills ── */
  .exp-hero__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: rgba(37, 99, 235, 0.15);
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #60a5fa;
  }

  /* ── Resumen ejecutivo ── */
  .exp-summary {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .exp-summary p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }
  .exp-summary__lead {
    font-size: 1.15rem;
    color: var(--color-text-primary);
  }
  @media (max-width: 768px) {
    .exp-summary { padding: 2rem 1.5rem 0; }
  }

  /* ── Section Title ── */
  .section-title {
    font-size: 1.6rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .era-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1rem;
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 100px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #2563eb;
  }

  .era-pill--accent {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
    color: #16a34a;
  }

  /* ── Timeline ── */
  .timeline-section {
    max-width: 900px;
    margin: 4rem auto 4.5rem;
    padding: 0 1.5rem;
  }

  .timeline {
    position: relative;
    padding-left: 8rem;
  }

  /* Línea vertical */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 4rem;
    width: 2px;
    background: var(--color-border);
    border-radius: 2px;
  }

  .timeline__item {
    position: relative;
    margin-bottom: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  .timeline__item:last-child {
    margin-bottom: 0;
  }

  /* Punto en la línea */
  .timeline__marker {
    position: absolute;
    top: 0;
    left: -7.125rem;
    width: 6.25rem;
    height: 6.25rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    box-shadow: 0 0 0 4px var(--color-bg);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .timeline__marker--sos,
  .timeline__marker--meli,
  .timeline__marker--ubits,
  .timeline__marker--arkano,
  .timeline__marker--derco,
  .timeline__marker--supergiros,
  .timeline__marker--fasttrack,
  .timeline__marker--codesa {
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 10px rgba(0, 0, 0, 0.12) !important;
  }

  .timeline--data .timeline__marker {
    border-color: var(--color-accent);
  }

  .timeline__marker--current {
    border: 3px solid #22c55e !important;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 16px rgba(34, 197, 94, 0.4) !important;
  }

  .timeline__marker--meli {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #ffcb00, #2563eb) border-box !important;
  }

  .timeline__marker--ubits {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #1e3a5f, #9ca3af) border-box !important;
  }

  .timeline__marker--meli {
    border-color: #ffcb00 !important;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 12px rgba(255, 203, 0, 0.25) !important;
  }

  .timeline__marker--olimpia {
    border-color: #ef4444 !important;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 12px rgba(239, 68, 68, 0.25) !important;
  }

  .timeline__marker--arkano {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #8b5cf6, #a78bfa) border-box !important;
  }

  .timeline__marker--derco {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #ef4444, #f87171) border-box !important;
  }

  .timeline__marker--supergiros {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #38bdf8, #7dd3fc) border-box !important;
  }

  .timeline__marker--fasttrack {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #0ea5e9, #38bdf8) border-box !important;
  }

  .timeline__marker--codesa {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #991b1b, #dc2626) border-box !important;
  }

  .timeline__marker--sos {
    border: 2px solid transparent !important;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(to right, #ef4444, #2563eb) border-box !important;
  }

  .timeline__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12%;
    box-sizing: border-box;
    background: white;
  }

  .timeline__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .timeline__role {
    font-size: 1.2rem;
  }

  .timeline__period {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .timeline__company {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0 0 0.25rem 0;
  }

  .timeline__company a {
    color: #2563eb;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .timeline__company a:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  .timeline__sector {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #a78bfa;
