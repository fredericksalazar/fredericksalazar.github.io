---
/**
 * certificaciones.astro — Certificaciones agrupadas por empresa
 * URL: /certificaciones
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Certificaciones — Frederick Salazar";
const description =
  "Certificaciones profesionales en Azure, Google Cloud, Databricks, MongoDB, Meta y más.";

const empresas = [
  {
    nombre: "Microsoft",
    logo: "/logos/microsoft.svg",
    certificaciones: [
      {
        titulo: "Azure Data Engineer Associate",
        ano: "2021",
        url: "https://www.credly.com/badges/3451c68b-985a-4094-b7dc-dec41644e747/linked_in_profile",
        tecnologias: [
          "Azure Data Factory",
          "Azure Synapse",
          "Data Engineering",
        ],
        badge: "/badges/azure_de.png",
      },
      {
        titulo: "Azure AI Fundamentals",
        ano: "2023",
        url: "https://www.credly.com/badges/02c0c899-a64a-44d9-90b6-534753e9f79a/linked_in_profile",
        tecnologias: ["Azure AI", "Machine Learning", "Computer Vision"],
        badge: "/badges/azure_ai.png",
      },
      {
        titulo: "Azure Data Fundamentals",
        ano: "2023",
        url: "https://www.credly.com/badges/21e86391-db6e-4bec-a45f-41a75523d0c4/linked_in_profile",
        tecnologias: ["Azure SQL", "Azure Storage", "Data Concepts"],
        badge: "/badges/azure_df.png",
      },
    ],
  },
  {
    nombre: "Google",
    logo: "/logos/google.svg",
    certificaciones: [
      {
        titulo: "Google AI Professional Certificate",
        ano: "2026",
        url: "https://www.credly.com/badges/5dbbfc8a-ec1d-4b2d-a0cc-7c17535e66e9/linked_in_profile",
        tecnologias: [
          "Inteligencia Artificial",
          "Prompt Engineering",
          "Google AI",
        ],
        badge: "/badges/google_ai.png",
      },
      {
        titulo: "Google Project Management Certificate",
        ano: "2026",
        url: "https://www.credly.com/badges/f6316070-fab5-4449-b367-ef84f65a54c9/linked_in_profile",
        tecnologias: ["Gestión de Proyectos", "Metodologías Ágiles", "Scrum"],
        badge: "/badges/google_pm.png",
      },
      {
        titulo: "Google Cloud Big Data & ML Fundamentals",
        ano: "2024",
        url: "https://www.skills.google/public_profiles/d7cbe2d3-cc94-4605-9a3c-bccb63d46f4e/badges/8253556",
        tecnologias: ["Google BigQuery", "Google Cloud", "Machine Learning"],
        badge: "/logos/google.svg",
        logo: "/logos/google.svg",
      },
    ],
  },
  {
    nombre: "Databricks",
    logo: "/logos/databricks.png",
    certificaciones: [
      {
        titulo: "Databricks Lakehouse Fundamentals",
        ano: "2022",
        url: "https://credentials.databricks.com/f1ff1d6b-55ff-474f-9b3d-17e5dd08c328#acc.WybUe9CG",
        tecnologias: ["Databricks", "Delta Lake", "Apache Spark"],
        badge: "/badges/databricks_fundamentals.png",
      },
    ],
  },
  {
    nombre: "MongoDB",
    logo: "/logos/mongodb.svg",
    certificaciones: [
      {
        titulo: "MongoDB SI Associate",
        ano: "2026",
        url: "https://learn.mongodb.com/c/yM7PJFTzQv2IH0rwxhyIxg",
        tecnologias: ["MongoDB", "NoSQL", "Base de Datos"],
        badge: "/badges/mongodb_si.png",
      },
    ],
  },
  {
    nombre: "Otros",
    logo: "/logos/google.svg",
    certificaciones: [
      {
        titulo: "Statistics Foundations",
        emisor: "Meta",
        ano: "2025",
        url: "https://www.coursera.org/account/accomplishments/verify/WN21HZM96ATQ",
        tecnologias: ["Estadística", "Análisis de Datos", "Probabilidad"],
        badge: null,
        logo: "/logos/meta.svg",
      },
      {
        titulo: "Prompt Engineering",
        emisor: "Vanderbilt University",
        ano: "2024",
        url: "https://www.coursera.org/account/accomplishments/verify/6Z5FSMOXQ9SW",
        tecnologias: ["Prompt Engineering", "IA Generativa", "LLMs"],
        badge: null,
        logo: "/logos/Vanderbilt-University-Logo.png",
      },
    ],
  },
];

const totalCertificaciones = empresas.reduce(
  (acc, empresa) => acc + empresa.certificaciones.length,
  0,
);
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- Header Hero -->
  <section class="cert-hero">
    <div class="cert-hero__grid"></div>

<div class="cert-hero__content">
      <h1 class="cert-hero__title">Certificaciones</h1>
      <p class="cert-hero__subtitle">
        Credenciales verificables en ingeniería de datos, inteligencia artificial y cloud computing.
      </p>
      
      <div class="cert-hero__stats">
        <span class="cert-hero__stat">
          <strong>{totalCertificaciones}</strong>
          Certificaciones
        </span>
        <span class="cert-hero__stat">
          <strong>{empresas.length}</strong>
          Proveedores
        </span>
      </div>
      
      <div class="cert-hero__providers">
        <img src="/logos/microsoft.svg" alt="Microsoft" class="provider-logo" />
        <img src="/logos/google.svg" alt="Google" class="provider-logo" />
        <img
          src="/logos/databricks.png"
          alt="Databricks"
          class="provider-logo"
        />
        <img src="/logos/mongodb.svg" alt="MongoDB" class="provider-logo" />
      </div>
    </div>
  </section>

  <!-- Certificaciones por Empresa -->
  <section class="cert-section">
    {
      empresas.map((empresa) => (
        <div class="cert-group">
          <h2 class="cert-group__title">
            <img
              src={empresa.logo}
              alt={empresa.nombre}
              class="cert-group__logo"
            />
            {empresa.nombre}
          </h2>

          <div class="cert-group__cards">
            {empresa.certificaciones.map((cert) => (
              <div class="cert-card">
                {cert.badge && (
                  <div class="cert-card__badge">
                    <span class="cert-card__ano">{cert.ano}</span>
                    <img src={cert.badge} alt={cert.titulo} loading="lazy" />
                  </div>
                )}
                {!cert.badge && cert.logo && (
                  <div class="cert-card__logo">
                    <span class="cert-card__ano">{cert.ano}</span>
                    <img
                      src={cert.logo}
                      alt={cert.emisor || empresa.nombre}
                      loading="lazy"
                    />
                  </div>
                )}

<div class="cert-card__content">
                <h3 class="cert-card__title">{cert.titulo}</h3>

                  <div class="cert-card__tags">
                    {cert.tecnologias.map((t) => (
                      <span class="cert-tag">{t}</span>
                    ))}
                  </div>
                </div>

                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-card__link"
                >
                  Ver credencial
                </a>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .cert-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at center,
        rgba(56, 189, 248, 0.08) 0%,
        transparent 50%
      ),
      linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
    padding: 5rem 2rem 4rem;
    display: flex;
    align-items: center;
    margin-bottom: 3rem;
  }

  .cert-hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.15) 1px,
      transparent 1px
    );
    background-size: 25px 25px;
    opacity: 0.5;
    pointer-events: none;
  }

  .cert-hero__content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .cert-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .cert-hero__subtitle {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 600px;
  }

  .cert-hero__stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .cert-hero__stat {
    font-size: 0.9rem;
    color: #64748b;
  }

  .cert-hero__stat strong {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.5rem;
    margin-right: 0.25rem;
  }

  .cert-hero__providers {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .provider-logo {
    height: 32px;
    width: auto;
  }

  .cert-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Group ── */
  .cert-group__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cert-group__logo {
    height: 28px;
    width: auto;
  }

  .cert-group__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* ── Card ── */
  .cert-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }

  .cert-card:hover {
    border-color: var(--color-accent);
  }

  .cert-card__badge {
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    padding: 1rem;
    position: relative;
  }

  .cert-card__badge img {
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  .cert-card__ano {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: #2563eb;
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.2);
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
  }

  .cert-card__logo {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .cert-card__logo img {
    height: 60px;
    width: auto;
    object-fit: contain;
  }

  .cert-card__content {
    padding: 1rem 1.25rem;
    flex: 1;
  }

  .cert-card__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  .cert-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cert-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 100px;
    color: #8b5cf6;
  }

  .cert-card__link {
    display: block;
    padding: 0.75rem 1.25rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cert-card__link:hover {
    color: var(--color-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .cert-hero {
      padding: 4rem 1.5rem 3rem;
    }

    .cert-section {
      padding: 0 1.5rem 3rem;
    }

    .cert-group__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
