---
/**
 * certificaciones.astro — Certificaciones agrupadas por empresa
 * URL: /certificaciones
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";

const title = "Certificaciones de Azure, GCP y Databricks";
const description =
  "Certificaciones profesionales en Azure Data Engineer, Google Cloud, Databricks, MongoDB y Meta. Credenciales verificadas de Frederick Salazar, Data Engineer en Colombia.";

const empresas = [
  {
    nombre: "Microsoft",
    logo: "/logos/microsoft.svg",
    certificaciones: [
      {
        titulo: "Azure Data Engineer Associate",
        ano: "2021",
        url: "https://www.credly.com/badges/3451c68b-985a-4094-b7dc-dec41644e747/linked_in_profile",
        tecnologias: [
          "Azure Data Factory",
          "Azure Synapse",
          "Data Engineering",
        ],
        badge: "/badges/azure_de.png",
      },
      {
        titulo: "Azure AI Fundamentals",
        ano: "2023",
        url: "https://www.credly.com/badges/02c0c899-a64a-44d9-90b6-534753e9f79a/linked_in_profile",
        tecnologias: ["Azure AI", "Machine Learning", "Computer Vision"],
        badge: "/badges/azure_ai.png",
      },
      {
        titulo: "Azure Data Fundamentals",
        ano: "2023",
        url: "https://www.credly.com/badges/21e86391-db6e-4bec-a45f-41a75523d0c4/linked_in_profile",
        tecnologias: ["Azure SQL", "Azure Storage", "Data Concepts"],
        badge: "/badges/azure_df.png",
      },
    ],
  },
  {
    nombre: "Google",
    logo: "/logos/google.svg",
    certificaciones: [
      {
        titulo: "Google AI Professional Certificate",
        ano: "2026",
        url: "https://www.credly.com/badges/5dbbfc8a-ec1d-4b2d-a0cc-7c17535e66e9/linked_in_profile",
        tecnologias: [
          "Inteligencia Artificial",
          "Prompt Engineering",
          "Google AI",
        ],
        badge: "/badges/google_ai.png",
      },
      {
        titulo: "Google Project Management Certificate",
        ano: "2026",
        url: "https://www.credly.com/badges/f6316070-fab5-4449-b367-ef84f65a54c9/linked_in_profile",
        tecnologias: ["Gestión de Proyectos", "Metodologías Ágiles", "Scrum"],
        badge: "/badges/google_pm.png",
      },
      {
        titulo: "Google Cloud Big Data & ML Fundamentals",
        ano: "2024",
        url: "https://www.skills.google/public_profiles/d7cbe2d3-cc94-4605-9a3c-bccb63d46f4e/badges/8253556",
        tecnologias: ["Google BigQuery", "Google Cloud", "Machine Learning"],
        badge: "/logos/google.svg",
        logo: "/logos/google.svg",
      },
    ],
  },
  {
    nombre: "Databricks",
    logo: "/logos/databricks.png",
    certificaciones: [
      {
        titulo: "Databricks Lakehouse Fundamentals",
        ano: "2022",
        url: "https://credentials.databricks.com/f1ff1d6b-55ff-474f-9b3d-17e5dd08c328#acc.WybUe9CG",
        tecnologias: ["Databricks", "Delta Lake", "Apache Spark"],
        badge: "/badges/databricks_fundamentals.png",
      },
    ],
  },
  {
    nombre: "MongoDB",
    logo: "/logos/mongodb.svg",
    certificaciones: [
      {
        titulo: "MongoDB SI Associate",
        ano: "2026",
        url: "https://learn.mongodb.com/c/yM7PJFTzQv2IH0rwxhyIxg",
        tecnologias: ["MongoDB", "NoSQL", "Base de Datos"],
        badge: "/badges/mongodb_si.png",
      },
    ],
  },
  {
    nombre: "Otros",
    logo: "/logos/google.svg",
    certificaciones: [
      {
        titulo: "Statistics Foundations",
        emisor: "Meta",
        ano: "2025",
        url: "https://www.coursera.org/account/accomplishments/verify/WN21HZM96ATQ",
        tecnologias: ["Estadística", "Análisis de Datos", "Probabilidad"],
        badge: undefined,
        logo: "/logos/meta.svg",
      },
      {
        titulo: "Prompt Engineering",
        emisor: "Vanderbilt University",
        ano: "2024",
        url: "https://www.coursera.org/account/accomplishments/verify/6Z5FSMOXQ9SW",
        tecnologias: ["Prompt Engineering", "IA Generativa", "LLMs"],
        badge: undefined,
        logo: "/logos/Vanderbilt-University-Logo.png",
      },
    ],
  },
];

const totalCertificaciones = empresas.reduce(
  (acc, empresa) => acc + empresa.certificaciones.length,
  0,
);
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- Hero Section -->
  <Hero
    badge={{ text: "Credenciales verificadas" }}
    title="Certificaciones"
    subtitle="Credenciales verificables en ingeniería de datos, inteligencia artificial y cloud computing."
    kpis={[
      { value: totalCertificaciones, label: "Certificaciones" },
      { value: empresas.length, label: "Proveedores" },
    ]}
  >
    <Fragment slot="visual">
      <img
        src="/images/certs-hero.png"
        alt="Certificaciones"
        class="cert-hero__image"
        loading="eager"
      />
    </Fragment>
  </Hero>

  <!-- Certificaciones por Empresa -->
  <section class="cert-section">
    {
      empresas.map((empresa) => (
        <div class="cert-group">
          <h2 class="cert-group__title">
            <img
              src={empresa.logo}
              alt={empresa.nombre}
              class="cert-group__logo"
            />
            {empresa.nombre}
          </h2>

          <div class="cert-group__cards">
            {empresa.certificaciones.map((cert) => {
              const imageAlt = "emisor" in cert && cert.emisor ? cert.emisor : empresa.nombre;
              return (
                <Card
                  variant="cert"
                  href={cert.url}
                  badge={cert.badge}
                  logo={cert.logo}
                  imageAlt={imageAlt}
                  title={cert.titulo}
                  tags={cert.tecnologias}
                  year={cert.ano}
                  externalLinkText="Ver credencial"
                />
              );
            })}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  /* ── Animaciones de entrada ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Imagen hero integrada con blueprint ── */
  .cert-hero__image {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: center center;
    display: block;
    pointer-events: none;
    animation: fadeInRight 0.8s ease-out backwards;
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateY(-50%) translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }

  /* ── Section ── */
  .cert-section {
    max-width: 1000px;
    margin: 4rem auto;
    padding: 0 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Group ── */
  .cert-group__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cert-group__logo {
    height: 28px;
    width: auto;
  }

  .cert-group__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .cert-section {
      padding: 0 1.5rem 3rem;
    }

    .cert-group__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
