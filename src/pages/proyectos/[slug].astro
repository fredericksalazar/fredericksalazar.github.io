---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { urls, absUrls, SITE_URL } from '../../lib/urls';
import { trail, sectionCrumb, PERSON_ID } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('proyectos');
  return projects.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);

const hasGithub = proyecto.data.github && proyecto.data.github !== '';
const hasDemo   = proyecto.data.demo   && proyecto.data.demo   !== '';

const isDataCompass = proyecto.id === 'datacompass';
const isTilo = proyecto.id === 'tilo';

const tiloKeywords =
  'tilo, nueva pestaña chrome, new tab chrome extension, accesos directos chrome, marcadores sincronizados, tareas nueva pestaña, prueba de velocidad chrome, extension sin rastreo, frederick salazar, open source mit';

const softwareSchema = isDataCompass ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DataCompass',
  alternateName: 'Data Compass',
  description: 'Plataforma web gratuita que evalúa la madurez del gobierno de datos de tu organización con el framework CMMI y entrega un diagnóstico ejecutivo accionable en menos de 10 minutos.',
  url: 'https://data-compass-app.web.app',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Data Governance Assessment',
  operatingSystem: 'Web',
  inLanguage: 'es',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: 'Frederick Salazar',
    url: SITE_URL,
  },
  creator: {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: 'Frederick Salazar',
    url: SITE_URL,
  },
  image: proyecto.data.imagen ? new URL(proyecto.data.imagen, SITE_URL).href : undefined,
  screenshot: [
    new URL('/images/proyectos/datacompass-dashboard.png', SITE_URL).href,
    new URL('/images/proyectos/datacompass-roadmap.png', SITE_URL).href,
    new URL('/images/proyectos/datacompass-summary.png', SITE_URL).href,
  ],
  featureList: [
    'Evaluación de madurez basada en framework CMMI',
    'Score global y radar por dominios',
    'Roadmap de los 5 niveles de madurez',
    'Resumen ejecutivo con recomendaciones priorizadas',
    'Diagnóstico en menos de 10 minutos',
  ],
  keywords: 'gobierno de datos, data governance, madurez de datos, CMMI, evaluación de datos, diagnóstico de datos, calidad de datos, arquitectura de datos',
} : isTilo ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tilo',
  alternateName: 'tilo',
  description: proyecto.data.descripcion,
  url: absUrls.proyecto('tilo'),
  applicationCategory: 'BrowserApplication',
  applicationSubCategory: 'New Tab Extension',
  softwareVersion: '2.2.0',
  operatingSystem: 'Chrome, Brave, Chromium',
  inLanguage: ['es', 'en', 'fr', 'it', 'de', 'pt', 'ja', 'ko', 'zh-CN'],
  isAccessibleForFree: true,
  license: 'https://opensource.org/licenses/MIT',
  copyrightYear: 2026,
  copyrightHolder: {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: 'Frederick Salazar',
    url: SITE_URL,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: 'Frederick Salazar',
    url: SITE_URL,
  },
  creator: {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: 'Frederick Salazar',
    url: SITE_URL,
  },
  image: proyecto.data.imagen ? new URL(proyecto.data.imagen, SITE_URL).href : undefined,
  screenshot: [
    new URL('/images/proyectos/tilo-portada.png', SITE_URL).href,
    new URL('/images/proyectos/tilo-panel.png', SITE_URL).href,
    new URL('/images/proyectos/tilo-oscuro.png', SITE_URL).href,
    new URL('/images/proyectos/tilo-velocidad.png', SITE_URL).href,
    new URL('/images/proyectos/tilo-degradado.png', SITE_URL).href,
  ],
  featureList: [
    'Hasta 100 accesos directos sincronizados con tus marcadores de Chrome sin cuenta adicional',
    'Atajo rápido ⌥⇧D (Alt+Mayús+D en Windows), clic derecho o icono de la extensión',
    'Selector de motor de búsqueda: por defecto de Chrome, Google, Bing, DuckDuckGo, Brave, Ecosia, Perplexity o Yahoo!',
    'Fondo animado con aura de color, 12 colores sólidos, 15 degradados o imagen propia con desenfoque',
    'Tema claro, oscuro o automático según el dispositivo',
    'Lista de tareas y subtareas integrada en la pestaña',
    'Clima opcional por ubicación o ciudad escrita manualmente',
    'Prueba de velocidad integrada (descarga, subida, latencia y jitter en 15 segundos)',
  ],
  keywords: tiloKeywords,
} : null;
---

<BaseLayout
  title={proyecto.data.tituloSeo ?? proyecto.data.titulo}
  description={proyecto.data.descripcion}
  image={proyecto.data.imagen}
  keywords={isTilo ? tiloKeywords : undefined}
  breadcrumbs={trail(sectionCrumb.proyectos, { name: proyecto.data.titulo, url: absUrls.proyecto(proyecto.id) })}
>
  {softwareSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  )}

  <nav class={`breadcrumb ${isTilo ? 'breadcrumb--wide' : ''}`}><a href={urls.proyectos()}>← Proyectos</a></nav>

  <article class={isTilo ? 'article--product' : ''}>

    <!-- ── Header del proyecto ──────────────────────────────────────── -->
    <header class="proj-header">
      <h1 class="proj-title">{proyecto.data.titulo}</h1>
      <p class="proj-description">{proyecto.data.descripcion}</p>

      <!-- Tech stack -->
      {proyecto.data.tecnologias.length > 0 && (
        <div class="proj-stack">
          {proyecto.data.tecnologias.map((tech: string) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      )}

      <!-- Links de acción -->
      <div class="proj-links">
        {hasGithub && (
          <a
            href={proyecto.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
            </svg>
            Ver código
          </a>
        )}
        {hasDemo && (
          <a
            href={proyecto.data.demo}
            target="_blank"
            rel="noopener noreferrer"
            class={`btn ${hasGithub ? 'btn--outline' : 'btn--primary'}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Ver demo
          </a>
        )}
      </div>
    </header>

    <!-- ── Imagen destacada (omitida en vista producto cuando tiene hero propio) ── -->
    {proyecto.data.imagen && !isTilo && (
      <div class="proj-cover">
        <img
          src={proyecto.data.imagen}
          alt={proyecto.data.titulo}
          loading="eager"
        />
      </div>
    )}

    <!-- ── Contenido Markdown ──────────────────────────────────────── -->
    <div class="prose">
      <Content />
    </div>

    <footer class="proj-footer">
      <a href={urls.proyectos()} class="back-link">← Volver a proyectos</a>
    </footer>

  </article>
</BaseLayout>

<style>
  .breadcrumb { margin-bottom: 1.5rem; font-size: 0.85rem; max-width: 800px; margin-left: auto; margin-right: auto; }
  .breadcrumb--wide { max-width: 1080px; }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent-text); }

  article {
    max-width: 800px;
    margin: 0 auto;
  }

  .article--product {
    max-width: 1080px;
  }

  .proj-header { margin-bottom: 2rem; }

  .proj-title {
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    font-weight: 700; line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .proj-description {
    font-size: 1.05rem; color: var(--color-text-secondary);
    line-height: 1.65; margin-bottom: 1.25rem; max-width: 640px;
  }

  .proj-stack {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .proj-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.55rem 1.1rem; border-radius: 0.5rem;
    font-size: 0.875rem; font-weight: 500;
    text-decoration: none; cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn--primary {
    background: var(--color-accent-fill); color: var(--color-on-accent);
    border: 1px solid transparent;
  }
  .btn--primary:hover { background: var(--color-accent-fill-hover); color: var(--color-on-accent); }

  .btn--outline {
    background: transparent; color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }
  .btn--outline:hover {
    border-color: var(--color-accent); color: var(--color-accent-text);
  }

  .proj-cover {
    margin-bottom: 2rem; border-radius: 0.75rem;
    overflow: hidden; border: 1px solid var(--color-border);
  }
  .proj-cover img {
    width: 100%; height: auto;
    max-height: 480px; object-fit: cover; display: block;
  }

  /* ── Prose (reutilizado del blog) ────────────────────────────────── */
  .prose {
    color: var(--color-text-secondary);
    font-size: 1.05rem; line-height: 1.8; max-width: 100%;
  }
  .prose :global(h2) {
    font-size: 1.4rem; font-weight: 700; color: var(--color-text-primary);
    margin: 2.25rem 0 0.75rem;
    padding-bottom: 0.4rem; border-bottom: 1px solid var(--color-border);
  }
  .prose :global(h3) {
    font-size: 1.15rem; font-weight: 600; color: var(--color-text-primary);
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p) { margin-bottom: 1.15rem; }
  .prose :global(a) { color: var(--color-accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { margin: 0.75rem 0 1.15rem 1.5rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(img) {
    max-width: 100%; height: auto; border-radius: 0.5rem;
    margin: 1.75rem auto; display: block; border: 1px solid var(--color-border);
    max-height: 500px; object-fit: contain;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0; color: var(--color-text-muted); font-style: italic;
  }
  .prose :global(code) {
    font-family: var(--font-mono); font-size: 0.85em;
    background: var(--color-tag-bg); border: 1px solid var(--color-tag-border);
    padding: 0.15rem 0.4rem; border-radius: 0.3rem;
  }
  .prose :global(pre) {
    background: var(--color-tag-bg); border: 1px solid var(--color-tag-border);
    border-radius: 0.5rem; padding: 1.25rem; overflow-x: auto; margin: 1.5rem 0;
  }
  .prose :global(pre code) { background: none; border: none; padding: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border); padding: 0.5rem 0.85rem; }
  .prose :global(th) { background: var(--color-hover); font-weight: 600; color: var(--color-text-primary); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 2rem 0; }
  .prose :global(strong) { color: var(--color-text-primary); font-weight: 600; }

  .prose :global(.cta-wrap) {
    margin: 2rem 0;
    text-align: center;
  }
  .prose :global(.cta-button) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 12px var(--color-accent-glow);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .prose :global(.cta-button:hover) {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.28);
  }

  .proj-footer {
    margin-top: 3rem; padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .back-link { font-size: 0.875rem; color: var(--color-text-muted); text-decoration: none; }
  .back-link:hover { color: var(--color-accent-text); }

  /* ── Vista de Producto (Tilo) ────────────────────────────────────── */
  .prose :global(.tilo-product) {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 1rem;
  }

  .prose :global(.tilo-hero) {
    background: var(--color-sidebar);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 2rem 2.25rem;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .prose :global(.tilo-hero__top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .prose :global(.tilo-brand) {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .prose :global(.tilo-brand__icon) {
    flex-shrink: 0;
  }

  .prose :global(.tilo-brand__wordmark) {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .prose :global(.tilo-brand__version) {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent-text);
    background: var(--color-active-bg);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .prose :global(.tilo-subnav) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .prose :global(.tilo-subnav a) {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .prose :global(.tilo-subnav a:hover) {
    color: var(--color-accent-text);
    background: var(--color-hover);
  }

  .prose :global(.tilo-hero__body) {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2rem;
  }

  .prose :global(.tilo-hero__headline) {
    font-size: clamp(1.8rem, 3.8vw, 2.75rem);
    font-weight: 800;
    color: var(--color-accent-text);
    letter-spacing: -0.025em;
    line-height: 1.1;
    border: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }

  .prose :global(.tilo-hero__subtitle) {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0 0 1.5rem;
  }

  .prose :global(.tilo-hero__cta-group) {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .prose :global(a.tilo-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
  }

  .prose :global(a.tilo-btn p) {
    margin: 0;
  }

  .prose :global(a.tilo-btn svg) {
    flex-shrink: 0;
  }

  .prose :global(a.tilo-btn--primary) {
    background: var(--color-accent-fill);
    color: var(--color-on-accent);
    border: 1px solid var(--color-accent);
    box-shadow: 0 4px 12px var(--color-accent-glow);
  }

  .prose :global(a.tilo-btn--primary:hover) {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-on-accent);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px var(--color-accent-glow);
  }

  .prose :global(a.tilo-btn--secondary) {
    background: var(--color-sidebar);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .prose :global(a.tilo-btn--secondary:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
    background: var(--color-hover);
    transform: translateY(-1px);
  }

  .prose :global(a.tilo-btn--ghost) {
    background: var(--color-bg);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .prose :global(a.tilo-btn--ghost:hover) {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
    background: var(--color-hover);
    transform: translateY(-1px);
  }

  .prose :global(.tilo-hero__trust) {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
  }

  .prose :global(.tilo-hero__figure) {
    margin: 0;
  }

  .prose :global(.tilo-hero__figure img) {
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    display: block;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .prose :global(.tilo-section) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .prose :global(.tilo-section__header) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .prose :global(.tilo-section__title) {
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text-primary);
    border: none;
    margin: 0;
    padding: 0;
  }

  .prose :global(.tilo-section__subtitle) {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-accent-text);
    margin: 0;
  }

  .prose :global(.tilo-section__desc) {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0.25rem 0 0;
  }

  .prose :global(.tilo-features-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .prose :global(.tilo-card) {
    background: var(--color-sidebar);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .prose :global(.tilo-card:hover) {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    transform: translateY(-2px);
  }

  .prose :global(.tilo-card__icon) {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-active-bg);
    color: var(--color-accent-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .prose :global(.tilo-card__title) {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0.25rem 0 0;
    line-height: 1.3;
  }

  .prose :global(.tilo-card__text) {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .prose :global(.tilo-card__text kbd) {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--color-hover);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.1rem 0.35rem;
    color: var(--color-text-primary);
  }

  .prose :global(.tilo-gallery) {
    display: grid;
