---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Card from "../../components/Card.astro";

const title = "Proyectos de Data Engineering y ML";
const description =
  "Proyectos de Data Engineering, Big Data, Machine Learning y Analytics - Portafolio de Frederick Salazar. OllamaFX, DinaWall, análisis de datos con Python, Apache Spark y más.";

const allProyectos = await getCollection("proyectos");
const proyectos = allProyectos.sort((a, b) => a.data.orden - b.data.orden);

const countByCategoria = {
  "data-analysis": proyectos.filter((p) => p.data.categoria === "data-analysis").length,
  "ml": proyectos.filter((p) => p.data.categoria === "ml").length,
  "software": proyectos.filter((p) => p.data.categoria === "software").length,
  "data-engineering": proyectos.filter((p) => p.data.categoria === "data-engineering").length,
};
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <Hero class="hero--constellation">
    <Fragment slot="content">
      <span class="proj-badge">
        <span class="proj-badge-dot"></span>
        Portafolio técnico
      </span>

      <h1 class="proj-title">Proyectos</h1>

      <p class="proj-subtitle">
        Software open source, análisis de datos y soluciones de inteligencia artificial.
      </p>

      <div class="proj-kpis">
        <div class="proj-kpi">
          <span class="proj-kpi-value">{proyectos.length}</span>
          <span class="proj-kpi-label">Proyectos</span>
        </div>
        {countByCategoria["data-analysis"] > 0 && (
          <div class="proj-kpi">
            <span class="proj-kpi-value">{countByCategoria["data-analysis"]}</span>
            <span class="proj-kpi-label">Data Analysis</span>
          </div>
        )}
        {countByCategoria["ml"] > 0 && (
          <div class="proj-kpi">
            <span class="proj-kpi-value">{countByCategoria["ml"]}</span>
            <span class="proj-kpi-label">ML / NLP</span>
          </div>
        )}
        {countByCategoria["software"] > 0 && (
          <div class="proj-kpi">
            <span class="proj-kpi-value">{countByCategoria["software"]}</span>
            <span class="proj-kpi-label">Software</span>
          </div>
        )}
      </div>
    </Fragment>

    <Fragment slot="visual">
      <div class="proj-constellation">
        <img src="/logos/apache-spark.png" alt="Spark" class="proj-logo proj-logo--spark" />
        <img src="/logos/apache-airflow.png" alt="Airflow" class="proj-logo proj-logo--airflow" />
        <img src="/logos/python.svg"  alt="Python"  class="proj-logo proj-logo--python"  />
        <img src="/logos/java.svg"    alt="Java"    class="proj-logo proj-logo--java"    />
        <img src="/logos/mongodb.svg" alt="MongoDB" class="proj-logo proj-logo--mongodb" />
        <img src="/logos/git.svg"     alt="Git"     class="proj-logo proj-logo--git"     />
        <img src="/logos/github.svg"  alt="GitHub"  class="proj-logo proj-logo--github"  />
        <img src="/logos/tableau-logo.png" alt="Tableau" class="proj-logo proj-logo--tableau" />
        <img src="/logos/google.svg"  alt="Google"  class="proj-logo proj-logo--google"  />
        <img src="/logos/plotly.svg"  alt="Plotly"  class="proj-logo proj-logo--plotly"  />
        <img src="/logos/pandas.svg"  alt="Pandas"  class="proj-logo proj-logo--pandas"  />
      </div>
    </Fragment>
  </Hero>

  <!-- Intro del portafolio -->
  <section class="proj-intro" aria-label="Sobre este portafolio">
    <p>
      Proyectos personales y open source en cuatro líneas de trabajo:
      <strong>Software</strong>, <strong>Data Analysis</strong>,
      <strong>Machine Learning / NLP</strong> y <strong>Data Engineering</strong>.
      Cada proyecto incluye repositorio público en GitHub y, cuando aplica, demo en vivo
      o dashboard interactivo. Para colaborar, abre un issue en el repo correspondiente o
      escríbeme a <a href="mailto:fsalazars@uoc.edu">fsalazars@uoc.edu</a>.
    </p>
  </section>

  <!-- Todos los proyectos con filtros -->
  <section class="all-projects-section">
    <div class="filter-bar">
      <button class="filter-btn filter-btn--active" data-filter="all">Todos ({proyectos.length})</button>
      {countByCategoria["data-analysis"] > 0 && (
        <button class="filter-btn" data-filter="data-analysis">Data Analysis ({countByCategoria["data-analysis"]})</button>
      )}
      {countByCategoria["ml"] > 0 && (
        <button class="filter-btn" data-filter="ml">ML / NLP ({countByCategoria["ml"]})</button>
      )}
      {countByCategoria["software"] > 0 && (
        <button class="filter-btn" data-filter="software">Software ({countByCategoria["software"]})</button>
      )}
      {countByCategoria["data-engineering"] > 0 && (
        <button class="filter-btn" data-filter="data-engineering">Data Engineering ({countByCategoria["data-engineering"]})</button>
      )}
    </div>

    {proyectos.length === 0 ? (
      <p class="empty-state">Los proyectos se cargarán pronto desde los archivos Markdown.</p>
    ) : (
      <div class="projects-grid" id="projects-grid">
        {proyectos.map((proyecto) => (
          <Card
            variant="project"
            href={`/proyectos/${proyecto.id}/`}
            image={proyecto.data.imagen}
            imageAlt={`Imagen de ${proyecto.data.titulo}`}
            title={proyecto.data.titulo}
            description={proyecto.data.descripcion}
            category={proyecto.data.categoria}
            date={proyecto.data.fecha}
            tags={proyecto.data.tecnologias}
            overlayText="Ver proyecto →"
            headingLevel="h2"
            data-categoria={proyecto.data.categoria}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".card[data-categoria]");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;

      filterBtns.forEach((b) => b.classList.remove("filter-btn--active"));
      btn.classList.add("filter-btn--active");

      cards.forEach((card) => {
        if (filter === "all" || card.dataset.categoria === filter) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  /* ── Override Hero badge → cobalt blue ───────────────────────────── */
  .proj-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.2);
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #2563eb;
    letter-spacing: 0.01em;
    animation: fadeInUp 0.5s ease-out backwards;
  }

  .proj-badge-dot {
    width: 6px;
    height: 6px;
    background: #2563eb;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  /* ── Override Hero title ─────────────────────────────────────────── */
  .proj-title {
    font-family: "Google Sans Flex", "Google Sans", "Product Sans", sans-serif;
    font-size: clamp(2.5rem, 5.2vw, 5.5rem);
    font-weight: 700;
    font-stretch: 100%;
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin: 0;
    color: #2563eb;
    animation: fadeInUp 0.6s ease-out 0.1s backwards;
  }

  /* ── Override Hero subtitle ──────────────────────────────────────── */
  .proj-subtitle {
    font-size: 1rem;
    font-weight: 400;
    color: #475569;
    line-height: 1.55;
    margin: 0.25rem 0 0;
    max-width: 480px;
    animation: fadeInUp 0.5s ease-out 0.18s backwards;
  }

  /* ── KPIs — all cobalt blue ──────────────────────────────────────── */
  .proj-kpis {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    animation: fadeInUp 0.5s ease-out 0.25s backwards;
  }

  .proj-kpi {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .proj-kpi-value {
    font-size: 2rem;
    font-weight: 700;
    color: #2563eb;
    line-height: 1;
  }

  .proj-kpi-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Organic Floating Constellation ────────────────────────────────── */
  .proj-constellation {
    position: relative;
    width: 100%;
    min-height: 600px;
  }

  .proj-logo {
    position: absolute;
    display: block;
    filter: brightness(0.85) saturate(0.9);
    opacity: 0;
    animation: fadeInLogo 0.6s ease-out forwards;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    object-fit: contain;
  }

  .proj-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .proj-logo:hover {
    filter: brightness(1) saturate(1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transform: scale(1.08);
  }

  /* ── Tier 10 — Spark: núcleo central (200px) ─────────────────────── */
  .proj-logo--spark {
    width: 200px; height: 200px;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: fadeInLogo 0.6s ease-out 0.05s forwards;
  }
  .proj-logo--spark:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* ── Tier 9 — Órbita cercana (150px) ─────────────────────────────── */
  .proj-logo--airflow {
    width: 150px; height: 150px;
    top: 0%; left: 50%;
    transform: translateX(-50%);
    animation: fadeInLogo 0.6s ease-out 0.1s forwards;
  }
  .proj-logo--airflow:hover {
    transform: translateX(-50%) scale(1.08);
  }

  .proj-logo--python {
    width: 150px; height: 150px;
    top: 12%; left: 5%;
    animation: fadeInLogo 0.6s ease-out 0.15s forwards;
  }

  .proj-logo--java {
    width: 150px; height: 150px;
    top: 68%; left: 5%;
    animation: fadeInLogo 0.6s ease-out 0.2s forwards;
  }

  .proj-logo--mongodb {
    width: 150px; height: 150px;
    top: 68%; left: 68%;
    animation: fadeInLogo 0.6s ease-out 0.25s forwards;
  }

  /* ── Tier 8 — Órbita media (100px) ───────────────────────────────── */
  .proj-logo--github {
    width: 100px; height: 100px;
    top: 45%; left: 2%;
    animation: fadeInLogo 0.6s ease-out 0.3s forwards;
  }

  .proj-logo--tableau {
    width: 100px; height: 100px;
    top: 45%; left: 82%;
    animation: fadeInLogo 0.6s ease-out 0.35s forwards;
  }

  .proj-logo--git {
    width: 100px; height: 100px;
    top: 8%; left: 78%;
    animation: fadeInLogo 0.6s ease-out 0.4s forwards;
  }

  /* ── Tier 7 — Órbita exterior (60px) ─────────────────────────────── */
  .proj-logo--pandas {
    width: 60px; height: 60px;
    top: 30%; left: 32%;
    animation: fadeInLogo 0.6s ease-out 0.45s forwards;
  }

  .proj-logo--google {
    width: 60px; height: 60px;
    top: 85%; left: 38%;
    animation: fadeInLogo 0.6s ease-out 0.5s forwards;
  }

  .proj-logo--plotly {
    width: 60px; height: 60px;
    top: 85%; left: 62%;
    animation: fadeInLogo 0.6s ease-out 0.55s forwards;
  }

  /* ── Responsive — Mobile ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    .proj-constellation {
      min-height: 420px;
      --constellation-scale: 0.7;
    }
  }

  @media (max-width: 480px) {
    .proj-constellation {
      min-height: 330px;
      --constellation-scale: 0.55;
    }
  }

  .proj-constellation {
    --constellation-scale: 1;
    transform: scale(var(--constellation-scale));
    transform-origin: center center;
  }

  /* ── Category Badges ──────────────────────────────────────────────── */
  .cat-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
  }

  .cat-badge--data-analysis    { background: rgba(37, 99, 235, 0.08); color: #2563eb; }
  .cat-badge--ml               { background: rgba(37, 99, 235, 0.12); color: #1d4ed8; }
  .cat-badge--software         { background: rgba(37, 99, 235, 0.06); color: #3b82f6; }
  .cat-badge--data-engineering { background: rgba(37, 99, 235, 0.15); color: #1e40af; }

  .proj-date {
    font-size: 0.75rem;
    color: #64748b;
  }

  /* ── Intro ────────────────────────────────────────────────────────── */
  .proj-intro {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .proj-intro p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }
  @media (max-width: 768px) {
    .proj-intro { padding: 1.5rem 1rem 0; }
  }

  /* ── All Projects Section ─────────────────────────────────────────── */
  .all-projects-section {
    padding: 3rem 2rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Filter Bar ───────────────────────────────────────────────────── */
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .filter-btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 2rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: var(--color-hover);
    color: var(--color-text-primary);
    border-color: var(--color-accent);
  }

  .filter-btn--active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  /* ── Projects Grid ────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    font-size: 1rem;
    font-style: italic;
  }

  /* ── Animations ───────────────────────────────────────────────────── */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInLogo {
    from { opacity: 0; transform: scale(0.8) translateY(12px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
    .featured-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .projects-grid { grid-template-columns: 1fr; }
    .all-projects-section,
    .featured-section { padding-left: 1rem; padding-right: 1rem; }
  }
</style>
