---
/**
 * /salarios/{cargo}/ — ¿Cuánto gana un {cargo} en Colombia?
 * Página programática por grupo ocupacional (CIUO-08 A.C.) desde
 * data_salarios_cargos.json. SEO build-time; gráfico client-side (REGLA 2).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import { urls, absUrls } from "../../lib/urls";
import { getIngresos, getSalariosCargos } from "../../lib/observatorio/data";

export function getStaticPaths() {
  return getSalariosCargos().cargos.map((cargo) => ({
    params: { slug: cargo.slug },
    props: { cargo },
  }));
}

const { cargo } = Astro.props;
const ing = getIngresos();
const data = getSalariosCargos();

const fmtCOP = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 0 });
const fmtDec = new Intl.NumberFormat("es-CO", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const anio = data.smlv_referencia.anio;
const smlv = data.smlv_referencia.valor;
const medianaNacional = ing.indicadores.mediana.actual.valor ?? 0;
const vsNacional = fmtDec.format(cargo.mediana / medianaNacional);
const enSmlv = fmtDec.format(cargo.mediana / smlv);
const sharePct = fmtDec.format(cargo.share_empleo_pct);

const title = `¿Cuánto gana ${cargo.nombre_corto} en Colombia? Salario ${anio} (DANE)`;
const description = `El grupo "${cargo.nombre}" gana una mediana de $${fmtCOP.format(cargo.mediana)} al mes en Colombia (GEIH ${anio}, DANE). El rango típico va de $${fmtCOP.format(cargo.p25)} a $${fmtCOP.format(cargo.p75)}, es decir ${enSmlv} salarios mínimos.`;

const faqs = [
  {
    q: `¿Cuál es el salario de "${cargo.nombre_corto}" en Colombia?`,
    a: `La mediana es $${fmtCOP.format(cargo.mediana)} mensuales: la mitad del grupo gana menos y la mitad más. El rango típico (percentil 25 a 75) va de $${fmtCOP.format(cargo.p25)} a $${fmtCOP.format(cargo.p75)}, y el 10% mejor pagado supera $${fmtCOP.format(cargo.p90)}.`,
  },
  {
    q: "¿De dónde salen estos datos?",
    a: `De los microdatos públicos de la GEIH ${anio} del DANE: ${fmtCOP.format(cargo.n_muestra)} ocupados de este grupo reportaron su ingreso laboral durante los 12 meses del año, ponderados por el factor de expansión de la encuesta. Este grupo representa el ${sharePct}% del empleo del país.`,
  },
  {
    q: "¿Cómo se compara con el resto del país?",
    a: `La mediana del grupo equivale a ${vsNacional} veces la mediana nacional ($${fmtCOP.format(medianaNacional)}) y a ${enSmlv} salarios mínimos de ${anio}.`,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      description,
      author: { "@type": "Person", name: "Frederick Salazar", url: absUrls.home() },
      dateModified: data.metadata.ultima_actualizacion,
      mainEntityOfPage: absUrls.salarioCargo(cargo.slug),
      about: [
        { "@type": "Thing", name: cargo.nombre },
        { "@type": "Place", name: "Colombia" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} image="/images/observatorio.png">
  <article class="sal">
    <header class="sal__header">
      <nav class="sal__breadcrumb" aria-label="Miga de pan">
        <a href={urls.salarios()}>Salarios en Colombia</a> <span aria-hidden="true">/</span> {cargo.nombre_corto}
      </nav>
      <h1 class="sal__titulo">¿Cuánto gana "{cargo.nombre_corto}" en Colombia?</h1>
      <p class="sal__lead">
        El grupo ocupacional <strong>"{cargo.nombre}"</strong> gana una mediana de
        <strong> ${fmtCOP.format(cargo.mediana)}</strong> mensuales en Colombia
        (GEIH {anio}, DANE). La mitad del grupo está entre
        <strong> ${fmtCOP.format(cargo.p25)}</strong> y
        <strong> ${fmtCOP.format(cargo.p75)}</strong>, y el 10% mejor pagado supera
        <strong> ${fmtCOP.format(cargo.p90)}</strong>.
      </p>
    </header>

    <div class="sal__stats">
      <div class="sal-stat">
        <span class="sal-stat__valor">${fmtCOP.format(cargo.mediana)}</span>
        <span class="sal-stat__label">mediana mensual del grupo</span>
      </div>
      <div class="sal-stat">
        <span class="sal-stat__valor">{enSmlv}×</span>
        <span class="sal-stat__label">salarios mínimos de {anio} (${fmtCOP.format(smlv)})</span>
      </div>
      <div class="sal-stat">
        <span class="sal-stat__valor">{vsNacional}×</span>
        <span class="sal-stat__label">la mediana nacional (${fmtCOP.format(medianaNacional)})</span>
      </div>
      <div class="sal-stat">
        <span class="sal-stat__valor">{sharePct}%</span>
        <span class="sal-stat__label">del empleo del país está en este grupo</span>
      </div>
    </div>

    <div class="sal__chart-card">
      <h2 class="sal__chart-titulo">Distribución salarial del grupo vs. el país</h2>
      <div
        id="sal-cargo-chart"
        data-slug={cargo.slug}
        style="height: 320px;"
        role="img"
        aria-label={`Rango salarial de ${cargo.nombre_corto} comparado con la mediana nacional`}
      ></div>
    </div>

    <div class="sal__cta">
      <p>
        ¿Quieres saber en qué percentil estás tú y a qué clase social pertenece tu hogar?
      </p>
      <a class="sal__cta-btn" href={`${urls.calculadora("cuanto-ganas")}?cargo=${cargo.slug}`}>
        Compárate con la calculadora →
      </a>
    </div>

    <section class="sal__faq">
      <h2>Preguntas frecuentes</h2>
      {
        faqs.map((f) => (
          <details class="sal__faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <p class="sal__metodologia">
        <strong>Nota metodológica:</strong> los grupos son los grandes subgrupos de la
        CIUO-08 A.C. (clasificación de ocupaciones adaptada para Colombia); las cifras son
        del ingreso laboral reportado, no del salario contractual. Ver
        <a href={urls.salarios()}>todas las ocupaciones</a>.
      </p>
    </section>
  </article>

  <PlotlyLoader bundle="full" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
  import { loadSalariosCargos, loadIngresos } from "../../lib/observatorio/data-client";
  import { mountPlotly, purgeChart } from "../../lib/observatorio/plotly-mount";
  import { COLORS, baseLayout } from "../../lib/observatorio/charts";
  import { cargoPorSlug } from "../../lib/calculadoras/ingresos";

  const CHART_ID = "sal-cargo-chart";

  async function render(): Promise<void> {
    const el = document.getElementById(CHART_ID);
    if (!el) return;
    const slug = el.dataset.slug ?? "";
    const [cargosData, ing] = await Promise.all([loadSalariosCargos(), loadIngresos()]);
    const cargo = cargoPorSlug(cargosData, slug);
    if (!cargo) return;
    const medianaNac = ing.indicadores.mediana.actual.valor ?? 0;

    await mountPlotly(CHART_ID, {
      traces: [
        {
          type: "box",
          x: [cargo.p25, cargo.mediana, cargo.p75, cargo.p90],
          name: cargo.nombre_corto,
          orientation: "h",
          marker: { color: COLORS.brand },
          line: { color: COLORS.brand },
          boxpoints: false,
          hoverinfo: "x",
        },
      ],
      layout: baseLayout({
        margin: { l: 24, r: 24, t: 16, b: 44 },
        showlegend: false,
        xaxis: {
          tickformat: ",.0f", ticksuffix: "",
          tickfont: { size: 11, color: "#636c76" },
          showgrid: true, gridcolor: "rgba(208, 215, 220, 0.4)",
        },
        yaxis: { showticklabels: false },
        shapes: [{
          type: "line", xref: "x", x0: medianaNac, x1: medianaNac, yref: "paper", y0: 0, y1: 1,
          line: { color: "#dc2626", width: 2, dash: "dash" }, layer: "above",
        }],
        annotations: [{
          xref: "x", yref: "paper", x: medianaNac, y: 1.02, yanchor: "bottom",
          text: "<b>Mediana nacional</b>", showarrow: false,
          font: { size: 10, color: "#ffffff" },
          bgcolor: "#dc2626", bordercolor: "#b91c1c", borderwidth: 1, borderpad: 3,
        }],
      }),
    });
  }

  function init(): void {
    render().catch((err) => console.error("[sal-cargo]", err));
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => purgeChart(CHART_ID));
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init, { once: true });
</script>

<style>
  .sal { padding: 2.5rem 0 3rem; }
  .sal__breadcrumb {
    font-size: 0.78rem;
    color: var(--color-text-muted, #636c76);
    margin-bottom: 1rem;
  }
  .sal__breadcrumb a { color: var(--color-accent, #2563eb); text-decoration: none; }
  .sal__titulo {
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    font-weight: 700;
    line-height: 1.18;
    margin: 0 0 0.9rem;
    color: var(--color-text-primary, #1f2328);
  }
  .sal__lead {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #475569);
    max-width: 720px;
    margin-bottom: 1.75rem;
  }

  .sal__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .sal-stat {
    padding: 1.1rem 1.25rem;
    background: var(--color-sidebar, #f6f8fa);
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .sal-stat__valor {
    font-size: 1.35rem;
    font-weight: 700;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    color: var(--color-text-primary, #1f2328);
  }
  .sal-stat__label { font-size: 0.78rem; line-height: 1.45; color: var(--color-text-muted, #636c76); }

  .sal__chart-card {
    padding: 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 18px;
    margin-bottom: 1.5rem;
  }
  .sal__chart-titulo {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary, #1f2328);
  }

  .sal__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(37, 99, 235, 0.3);
    background: rgba(37, 99, 235, 0.04);
    border-radius: 16px;
    margin-bottom: 2rem;
  }
  .sal__cta p { margin: 0; font-size: 0.95rem; color: var(--color-text-secondary, #475569); }
  .sal__cta-btn {
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.6rem 1.3rem;
    background: var(--color-accent, #2563eb);
    color: #fff;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
  }
  .sal__cta-btn:hover { background: #1d4ed8; }

  .sal__faq { margin-top: 2rem; max-width: 720px; }
  .sal__faq h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text-primary, #1f2328);
  }
  .sal__faq-item {
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 12px;
    padding: 0.85rem 1.1rem;
    margin-bottom: 0.6rem;
    background: var(--color-sidebar, #f6f8fa);
  }
  .sal__faq-item summary {
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text-primary, #1f2328);
  }
  .sal__faq-item p {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #475569);
  }
  .sal__metodologia {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-text-muted, #636c76);
  }
  .sal__metodologia a { color: var(--color-accent, #2563eb); }
</style>
