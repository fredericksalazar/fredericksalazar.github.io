---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import EleccionesNav from "../../components/observatorio/EleccionesNav.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import IndicadorPanel from "../../components/observatorio/IndicadorPanel.astro";
import Chart from "../../components/observatorio/Chart.astro";
import DashboardFooter from "../../components/observatorio/DashboardFooter.astro";

import { getPres2022_2v, getPres2022_1v } from "../../lib/observatorio/data";

const eleccion = getPres2022_2v();
const eleccion1v = getPres2022_1v();
const fecha = eleccion.eleccion?.fecha || "2022-06-19";

const nacional = eleccion.agregados.nacional;
const nacional1v = eleccion1v.agregados.nacional;
const fmtCompact = (n: number) => new Intl.NumberFormat("es-CO", { notation: "compact", maximumFractionDigits: 1 }).format(n);
const fmtPct = (n: number) => `${(n * 100).toFixed(1)}%`;
const fmtSignedCompact = (n: number) => `${n >= 0 ? "+" : "−"}${fmtCompact(Math.abs(n))}`;
const fmtSignedPctPp = (n: number) => `${n >= 0 ? "+" : "−"}${(Math.abs(n) * 100).toFixed(2)} pp`;
const fmtSignedPctRel = (n: number) => `${n >= 0 ? "+" : "−"}${(Math.abs(n) * 100).toFixed(1)}%`;

const deltaCenso = nacional.censo - nacional1v.censo;
const deltaCensoPct = nacional1v.censo ? deltaCenso / nacional1v.censo : 0;
const deltaParticipacion = nacional.participacion - nacional1v.participacion;
const deltaValidos = nacional.validos - nacional1v.validos;
const deltaValidosPct = nacional1v.validos ? deltaValidos / nacional1v.validos : 0;
const deltaAbstencion = nacional.abstencion - nacional1v.abstencion;

const kpis = [
  {
    titulo: "Censo electoral",
    valor: fmtCompact(nacional.censo),
    sub: `1ª vuelta: ${fmtCompact(nacional1v.censo)} · Potencial sufragantes`,
    delta: deltaCenso,
    deltaTxt: `${fmtSignedCompact(deltaCenso)} (${fmtSignedPctRel(deltaCensoPct)}) vs 1ª V`,
  },
  {
    titulo: "Participación",
    valor: fmtPct(nacional.participacion),
    sub: `1ª vuelta: ${fmtPct(nacional1v.participacion)} · Abstención ${fmtPct(nacional.abstencion)}`,
    delta: deltaParticipacion,
    deltaTxt: `${fmtSignedPctPp(deltaParticipacion)} vs 1ª V`,
  },
  {
    titulo: "Votos válidos",
    valor: fmtCompact(nacional.validos),
    sub: `1ª vuelta: ${fmtCompact(nacional1v.validos)} · ${fmtCompact(nacional.nulos)} nulos`,
    delta: deltaValidos,
    deltaTxt: `${fmtSignedCompact(deltaValidos)} (${fmtSignedPctRel(deltaValidosPct)}) vs 1ª V`,
  },
  {
    titulo: "Abstención",
    valor: fmtPct(nacional.abstencion),
    sub: `1ª vuelta: ${fmtPct(nacional1v.abstencion)} · Más votantes → menos abstención`,
    delta: deltaAbstencion,
    deltaTxt: `${fmtSignedPctPp(deltaAbstencion)} vs 1ª V`,
    invertColor: true,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "name": "Resultados Elecciones Presidenciales Colombia 2022 — 2ª Vuelta",
      "description": "Dataset consolidado de los resultados oficiales del balotaje presidencial de Colombia 2022 a nivel nacional y departamental.",
      "creator": { "@type": "Person", "name": "Frederick Salazar", "url": "https://fredericksalazar.github.io/" },
      "isBasedOn": [
        { "@type": "CreativeWork", "name": "Registraduría Nacional del Estado Civil", "url": "https://www.registraduria.gov.co/" },
        { "@type": "CreativeWork", "name": "Wikipedia", "url": "https://en.wikipedia.org/wiki/2022_Colombian_presidential_election" }
      ],
      "spatialCoverage": { "@type": "Place", "name": "Colombia" },
      "temporalCoverage": "2022-06-19/2022-06-19",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@type": "Article",
      "headline": "Análisis estratégico del balotaje 2022 — censo, abstención, votos válidos y movimiento del voto departamental",
      "datePublished": "2026-06-01",
      "author": { "@type": "Person", "name": "Frederick Salazar" }
    }
  ]
};
---
<BaseLayout
  title="Elecciones Presidenciales Colombia 2022 — Análisis 2ª Vuelta"
  description="Análisis estratégico del balotaje 2022: censo, abstención, votos válidos y de qué departamentos salieron los votos adicionales que le dieron la victoria a Petro."
  image="/images/observatorio.png"
  imageAlt="Observatorio · Análisis del balotaje presidencial Colombia 2022"
  type="article"
  fullWidth={true}
  keywords="elecciones presidenciales colombia 2022, balotaje 2022, segunda vuelta petro hernandez, analisis electoral colombia, voto por departamento colombia, abstencion electoral 2022, registraduria, observatorio electoral colombia"
  publishedTime="2026-06-01T00:00:00+00:00"
  articleSection="Análisis político y electoral"
  articleTags={["Elecciones Colombia", "Segunda vuelta 2022", "Gustavo Petro", "Rodolfo Hernández", "Análisis electoral", "Datos políticos"]}
>
  <Hero
    badge={{ text: `Escrutinio definitivo · ${fecha}` }}
    title="Elecciones Presidenciales 2022 — Balotaje"
    subtitle="Segunda vuelta · 19 de junio de 2022"
  />
  <EleccionesNav active="2022-2v" />
  <PlotlyLoader />

  <main class="observatorio-container">
    <section class="kpi-row" aria-label="Indicadores generales 2022 2ª vuelta">
      {kpis.map((k) => (
        <article class="kpi-card">
          <p class="kpi-card__label">{k.titulo}</p>
          <p class="kpi-card__value">{k.valor}</p>
          <p class="kpi-card__sub">{k.sub}</p>
          <div class="kpi-card__divider" />
          <p class={`kpi-card__delta-pill ${
            ((k as any).invertColor ? k.delta <= 0 : k.delta >= 0) ? "is-up" : "is-down"
          }`}>
            <span class="kpi-card__delta-arrow">{k.delta >= 0 ? "▲" : "▼"}</span>
            <span class="kpi-card__delta-txt">{k.deltaTxt}</span>
          </p>
        </article>
      ))}
    </section>

    <IndicadorPanel numero="1" eyebrow="Votación" titulo="Panorama general del balotaje" lead="Cómo se descompuso el sufragio en la 2ª vuelta: válidos, nulos y no marcados.">
      <Chart slot="visual" id="pres-2022-2v-composicion-votos" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="2" eyebrow="Candidatos" titulo="Resultado del balotaje" lead="Petro vs Hernández. Diferencia nacional de poco más de 700 mil votos en favor de Petro.">
      <Chart slot="visual" id="pres-2022-2v-votos-candidato" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="3" eyebrow="Censo y abstención" titulo="Cómo se movió el electorado entre 1ª y 2ª vuelta" lead="El censo electoral entre vueltas es prácticamente el mismo; lo que cambió fue cuántas personas decidieron salir a votar. La 2ª vuelta movilizó cerca de 1,9 millones de votantes adicionales y la abstención cayó alrededor de 4 puntos porcentuales — ese excedente es el que define el resultado.">
      <Chart slot="visual" id="pres-2022-2v-movimiento-nacional" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="4" eyebrow="Geografía" titulo="Mapa por departamento — Ganador y variación por candidato" lead="Selecciona una vista: «Ganador» muestra el candidato que ganó cada departamento; «Petro» y «Hernández» muestran la variación de votos de ese candidato entre 1ª y 2ª vuelta (más oscuro = mayor crecimiento).">
      <Chart slot="visual" id="pres-2022-2v-mapa-variacion-candidato" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="5" eyebrow="Activación territorial" titulo="Δ votos válidos por departamento (2V − 1V)" lead="Dónde se activó el electorado entre las dos vueltas. Los departamentos con mayor crecimiento de votos válidos son los que cambiaron el ánimo nacional del balotaje.">
      <Chart slot="visual" id="pres-2022-2v-delta-validos-depto" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="6" eyebrow="Origen de la victoria" titulo="Δ votos Petro por departamento (2V − 1V)" lead="El gráfico clave del análisis: qué departamentos le pusieron a Petro los votos adicionales para ganar. La Costa Caribe (Atlántico, Magdalena, Bolívar, Córdoba, Sucre) y los grandes centros urbanos (Bogotá, Valle, Cundinamarca) concentran el aporte decisivo.">
      <Chart slot="visual" id="pres-2022-2v-delta-petro-depto" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="7" eyebrow="Voto no-Petro" titulo="¿Heredó Hernández la suma de derecha + centro de la 1V?" lead="Comparativo por departamento entre el voto total de derecha y centro en 1ª vuelta y el voto efectivo por Hernández en la 2ª vuelta. Donde la barra amarilla queda corta frente a la gris, el voto anti-Petro no se consolidó — y ese diferencial es parte de la explicación de la derrota de Hernández.">
      <Chart slot="visual" id="pres-2022-2v-consolidacion-antipetro" embedded={true} />
    </IndicadorPanel>

    <DashboardFooter
      fuentes={[
        { nombre: "Registraduría Nacional del Estado Civil", url: "https://www.registraduria.gov.co/", indicador: "Resultados oficiales" },
        { nombre: "Wikipedia (en)", url: "https://en.wikipedia.org/wiki/2022_Colombian_presidential_election", indicador: "Tablas departamentales" },
        { nombre: "Cálculo propio", url: "https://github.com/fredericksalazar/fredericksalazar.github.io", indicador: "Clasificación ideológica" },
      ]}
      cobertura="Elección 2022 2ª vuelta"
      ultimaActualizacion={eleccion.metadata.ultima_actualizacion}
    />
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .observatorio-container { width: 100%; max-width: 1280px; margin: 0 auto; padding: 2rem; }
  .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 0 0 2rem; }

  .kpi-card {
    background: var(--card-bg, #fff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 14px;
    padding: 1.25rem 1.35rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: box-shadow 0.18s ease;
  }
  .kpi-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); }

  .kpi-card__label {
    font-size: 0.72rem;
    color: var(--text-muted, #6b7280);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.45rem;
    font-weight: 600;
  }
  .kpi-card__value {
    font-size: 1.9rem;
    font-weight: 800;
    margin: 0;
    color: var(--color-accent, #2563eb);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .kpi-card__sub {
    font-size: 0.78rem;
    color: var(--text-muted, #6b7280);
    margin: 0.3rem 0 0;
    line-height: 1.4;
  }

  .kpi-card__divider {
    height: 1px;
    background: var(--border, #e5e7eb);
    margin: 0.85rem 0 0.75rem;
    border: none;
  }

  .kpi-card__delta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    width: fit-content;
    line-height: 1.3;
    border: 1.5px solid transparent;
  }
  .kpi-card__delta-pill.is-up {
    background: rgba(22, 163, 74, 0.12);
    color: #15803d;
    border-color: rgba(22, 163, 74, 0.35);
  }
  .kpi-card__delta-pill.is-down {
    background: rgba(220, 38, 38, 0.10);
    color: #b91c1c;
    border-color: rgba(220, 38, 38, 0.30);
  }
  .kpi-card__delta-arrow { font-size: 0.7rem; line-height: 1; }
  .kpi-card__delta-txt { white-space: nowrap; }

  @media (max-width: 1024px) { .kpi-row { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .kpi-row { grid-template-columns: 1fr; } }
</style>
