---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import EleccionesNav from "../../components/observatorio/EleccionesNav.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import IndicadorPanel from "../../components/observatorio/IndicadorPanel.astro";
import Chart from "../../components/observatorio/Chart.astro";
import DashboardFooter from "../../components/observatorio/DashboardFooter.astro";

import { getPres2026_1v, getPres2022_1v, getPresCandidatos } from "../../lib/observatorio/data";
import type { IdeologiaBloque } from "../../lib/observatorio/types";

const eleccion = getPres2026_1v();
const eleccion2022 = getPres2022_1v();
const catalogo = getPresCandidatos();
const fecha = eleccion.eleccion?.fecha || "2026-05-31";

type FilaCandidato = { id: string; nombre: string; partido: string; ideologia: IdeologiaBloque; votos: number; share: number };

function filasCandidatos(e: typeof eleccion, lista: typeof catalogo.candidatos["2022-1v"]): FilaCandidato[] {
  const totalValidos = e.agregados.nacional.validos;
  return [...e.resultados]
    .sort((a, b) => b.votos - a.votos)
    .map(r => {
      const meta = lista.find(c => c.id === r.id);
      return {
        id: r.id,
        nombre: meta?.nombre ?? r.id,
        partido: meta?.partido ?? "—",
        ideologia: meta?.ideologia ?? "centro",
        votos: r.votos,
        share: r.votos / totalValidos,
      };
    });
}

const filas2022 = filasCandidatos(eleccion2022, catalogo.candidatos["2022-1v"]);
const filas2026 = filasCandidatos(eleccion, catalogo.candidatos["2026-1v"]);

const bloques: IdeologiaBloque[] = ["izquierda", "centro", "derecha"];
function agregarPorBloque(filas: FilaCandidato[]): Record<IdeologiaBloque, { votos: number; share: number }> {
  const acc = { izquierda: { votos: 0, share: 0 }, centro: { votos: 0, share: 0 }, derecha: { votos: 0, share: 0 } };
  for (const f of filas) {
    acc[f.ideologia].votos += f.votos;
    acc[f.ideologia].share += f.share;
  }
  return acc;
}
const bloques2022 = agregarPorBloque(filas2022);
const bloques2026 = agregarPorBloque(filas2026);
const variacionBloques = bloques.map(b => ({
  bloque: b,
  votos2022: bloques2022[b].votos,
  share2022: bloques2022[b].share,
  votos2026: bloques2026[b].votos,
  share2026: bloques2026[b].share,
  deltaShare: bloques2026[b].share - bloques2022[b].share,
}));

const fmtMiles = (n: number) => new Intl.NumberFormat("es-CO").format(n);

// ── Variación por tendencia × departamento (1V 2022 → 1V 2026) ────────────
type FilaDepto = {
  cod: string;
  nombre: string;
  votos22: number;
  votos26: number;
  delta: number;
  pct: number; // variación relativa
};

const deptos22Map = new Map(eleccion2022.agregados.departamentos.map(d => [d.cod_depto, d]));
const filasPorTendencia: Record<IdeologiaBloque, FilaDepto[]> = { izquierda: [], centro: [], derecha: [] };

for (const d26 of eleccion.agregados.departamentos) {
  const d22 = deptos22Map.get(d26.cod_depto);
  for (const b of bloques) {
    const v26 = d26.votos_por_ideologia[b] ?? 0;
    const v22 = d22?.votos_por_ideologia[b] ?? 0;
    const delta = v26 - v22;
    const pct = v22 > 0 ? (delta / v22) * 100 : (v26 > 0 ? Infinity : 0);
    filasPorTendencia[b].push({
      cod: d26.cod_depto,
      nombre: d26.nombre_depto,
      votos22: v22,
      votos26: v26,
      delta,
      pct,
    });
  }
}

// Ordenar cada tabla por Δ absoluto descendente
for (const b of bloques) {
  filasPorTendencia[b].sort((a, b2) => b2.delta - a.delta);
}

// ── Resumen estratégico por tendencia ───────────────────────────────────
type ResumenTendencia = {
  bloque: IdeologiaBloque;
  votos22Total: number;
  votos26Total: number;
  deltaTotal: number;
  pctNacional: number;        // variación a nivel nacional
  promedioPctDeptos: number;  // promedio de los Δ% por departamento (capando ±)
  deptosCrecio: number;
  deptosDecrecio: number;
  topDepto: FilaDepto;
  bottomDepto: FilaDepto;
};

const resumen: ResumenTendencia[] = bloques.map(b => {
  const filas = filasPorTendencia[b];
  const votos22Total = filas.reduce((acc, f) => acc + f.votos22, 0);
  const votos26Total = filas.reduce((acc, f) => acc + f.votos26, 0);
  const deltaTotal = votos26Total - votos22Total;
  const pctNacional = votos22Total > 0 ? (deltaTotal / votos22Total) * 100 : 0;
  const finitos = filas.filter(f => Number.isFinite(f.pct));
  const promedioPctDeptos = finitos.length
    ? finitos.reduce((acc, f) => acc + f.pct, 0) / finitos.length
    : 0;
  // Ranking por Δ % (sólo donde es finito), usando ese mismo criterio para top/bottom.
  const porPct = [...finitos].sort((a, b2) => b2.pct - a.pct);
  return {
    bloque: b,
    votos22Total,
    votos26Total,
    deltaTotal,
    pctNacional,
    promedioPctDeptos,
    deptosCrecio: filas.filter(f => f.delta > 0).length,
    deptosDecrecio: filas.filter(f => f.delta < 0).length,
    topDepto: porPct[0] ?? filas[0],
    bottomDepto: porPct[porPct.length - 1] ?? filas[filas.length - 1],
  };
});

const fmtSignedInt = (n: number) =>
  `${n >= 0 ? "+" : "−"}${new Intl.NumberFormat("es-CO").format(Math.abs(n))}`;
const fmtSignedPct = (n: number) => {
  if (!Number.isFinite(n)) return n > 0 ? "+∞" : "—";
  return `${n >= 0 ? "+" : "−"}${Math.abs(n).toFixed(1)}%`;
};

const nacional = eleccion.agregados.nacional;
const nacional2022 = eleccion2022.agregados.nacional;
const fmtCompact = (n: number) => new Intl.NumberFormat("es-CO", { notation: "compact", maximumFractionDigits: 1 }).format(n);
const fmtPct = (n: number) => `${(n * 100).toFixed(1)}%`;
const fmtDec = (n: number) => n.toFixed(2);

const pol2026 = eleccion.indicadores.polarizacion ?? 0;
const pol2022 = eleccion2022.indicadores.polarizacion ?? 0;

const deltaCenso = nacional.censo - nacional2022.censo;
const deltaCensoPct = deltaCenso / nacional2022.censo;
const deltaParticipacion = nacional.participacion - nacional2022.participacion;
const deltaValidos = nacional.validos - nacional2022.validos;
const deltaValidosPct = deltaValidos / nacional2022.validos;
const deltaPolarizacion = pol2026 - pol2022;
const deltaPolarizacionPct = pol2022 !== 0 ? deltaPolarizacion / pol2022 : 0;

const fmtSignedCompact = (n: number) => `${n >= 0 ? "+" : "−"}${fmtCompact(Math.abs(n))}`;
const fmtSignedPctPp = (n: number) => `${n >= 0 ? "+" : "−"}${(Math.abs(n) * 100).toFixed(2)} pp`;
const fmtSignedPctRel = (n: number) => `${n >= 0 ? "+" : "−"}${(Math.abs(n) * 100).toFixed(1)}%`;
const fmtSignedDec = (n: number) => `${n >= 0 ? "+" : "−"}${Math.abs(n).toFixed(2)}`;

const kpis = [
  {
    titulo: "Censo electoral",
    valor: fmtCompact(nacional.censo),
    sub: `2022: ${fmtCompact(nacional2022.censo)} · Potencial sufragantes`,
    delta: deltaCenso,
    deltaTxt: `${fmtSignedCompact(deltaCenso)} (${fmtSignedPctRel(deltaCensoPct)}) vs 2022`,
  },
  {
    titulo: "Participación",
    valor: fmtPct(nacional.participacion),
    sub: `2022: ${fmtPct(nacional2022.participacion)} · Abstención ${fmtPct(nacional.abstencion)}`,
    delta: deltaParticipacion,
    deltaTxt: `${fmtSignedPctPp(deltaParticipacion)} vs 2022`,
  },
  {
    titulo: "Votos válidos",
    valor: fmtCompact(nacional.validos),
    sub: `2022: ${fmtCompact(nacional2022.validos)} · ${fmtCompact(nacional.nulos)} nulos`,
    delta: deltaValidos,
    deltaTxt: `${fmtSignedCompact(deltaValidos)} (${fmtSignedPctRel(deltaValidosPct)}) vs 2022`,
  },
  {
    titulo: "Polarización",
    valor: fmtDec(pol2026),
    sub: `Índice (0 = consenso · 1 = máx.)`,
    delta: deltaPolarizacion,
    deltaTxt: `${fmtSignedDec(deltaPolarizacion)} (${fmtSignedPctRel(deltaPolarizacionPct)}) vs 2022`,
    hideDelta: true,
    statusText: pol2026 > 0.7 ? "Crítica (Alta)" : pol2026 > 0.4 ? "Media" : "Baja",
    statusColor: pol2026 > 0.7 ? "danger" : pol2026 > 0.4 ? "warning" : "success",
  },
];

const kpisComparativo = [
  { titulo: "Δ Censo electoral",   valor: fmtSignedCompact(deltaCenso),        delta: deltaCenso,        deltaTipo: "abs" as const },
  { titulo: "Δ Participación",     valor: fmtSignedPctPp(deltaParticipacion),   delta: deltaParticipacion, deltaTipo: "pp"  as const },
  { titulo: "Δ Votos válidos",     valor: fmtSignedCompact(deltaValidos),       delta: deltaValidos,       deltaTipo: "abs" as const },
  { titulo: "Δ Polarización",      valor: fmtSignedDec(deltaPolarizacion),      delta: deltaPolarizacion,  deltaTipo: "dec" as const },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "name": "Resultados Elecciones Presidenciales Colombia 2026 — 1ª Vuelta",
      "description": "Dataset consolidado de los resultados oficiales de la primera vuelta presidencial de Colombia 2026 a nivel nacional y departamental, con comparativo contra 2022.",
      "creator": { "@type": "Person", "name": "Frederick Salazar", "url": "https://fredericksalazar.github.io/" },
      "isBasedOn": [
        { "@type": "CreativeWork", "name": "Registraduría Nacional del Estado Civil", "url": "https://www.registraduria.gov.co/" },
        { "@type": "CreativeWork", "name": "Wikipedia", "url": "https://es.wikipedia.org/wiki/Elecciones_presidenciales_de_Colombia_de_2026" }
      ],
      "spatialCoverage": { "@type": "Place", "name": "Colombia" },
      "temporalCoverage": "2026-05-31/2026-05-31",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "distribution": [{ "@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": "https://fredericksalazar.github.io/data/data_pres_2026_1v.json" }]
    },
    {
      "@type": "Article",
      "headline": "Análisis Elecciones Presidenciales Colombia 2026 — 1ª Vuelta",
      "datePublished": "2026-06-01",
      "author": { "@type": "Person", "name": "Frederick Salazar" },
      "about": [
        {
          "@type": "Event",
          "name": "Elecciones Presidenciales Colombia 2026 — 1ª Vuelta",
          "description": "Primera vuelta de las elecciones presidenciales de Colombia, celebrada el 31 de mayo de 2026.",
          "startDate": "2026-05-31",
          "endDate": "2026-05-31",
          "eventStatus": "https://schema.org/EventScheduled",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "location": {
            "@type": "Country",
            "name": "Colombia",
            "address": { "@type": "PostalAddress", "addressCountry": "CO" }
          },
          "organizer": {
            "@type": "GovernmentOrganization",
            "name": "Registraduría Nacional del Estado Civil",
            "url": "https://www.registraduria.gov.co/"
          },
          "image": "https://fredericksalazar.github.io/images/observatorio.png"
        },
        { "@type": "Place", "name": "Colombia" }
      ]
    }
  ]
};
---
<BaseLayout
  title="Elecciones Presidenciales Colombia 2026 — Análisis 1ª Vuelta"
  description="Análisis descriptivo de los resultados oficiales de la primera vuelta presidencial de Colombia 2026, nacional y departamental, con comparativo frente a 2022."
  image="/images/observatorio.png"
  imageAlt="Observatorio · Análisis de la primera vuelta presidencial Colombia 2026"
  type="article"
  fullWidth={true}
  keywords="elecciones presidenciales colombia 2026, primera vuelta 2026, candidatos 2026, analisis electoral colombia, variacion del voto por departamento, izquierda centro derecha colombia, observatorio electoral colombia, registraduria, datos politicos"
  publishedTime="2026-06-01T00:00:00+00:00"
  articleSection="Análisis político y electoral"
  articleTags={["Elecciones Colombia", "Primera vuelta 2026", "Análisis electoral", "Datos políticos", "Variación del voto", "Tendencias políticas"]}
>
  <Hero
    badge={{ text: `Actualizado · ${fecha}` }}
    title="Elecciones Presidenciales 2026"
    subtitle="Primera vuelta · Análisis descriptivo y comparativo con 2022"
  />
  <EleccionesNav active="2026-1v" />
  <PlotlyLoader />

  <main class="observatorio-container">
    <section class="kpi-row" aria-label="Indicadores generales 2026">
      {kpis.map((k) => (
        <article class="kpi-card">
          <p class="kpi-card__label">{k.titulo}</p>
          <p class={`kpi-card__value ${(k as any).statusColor ? `color-${(k as any).statusColor}` : ""}`}>{k.valor}</p>
          <p class="kpi-card__sub">{k.sub}</p>
          {(k as any).hideDelta ? (
            <>
              <div class="kpi-card__divider" />
              <p class={`kpi-card__status-pill status-${(k as any).statusColor}`}>
                <span class="kpi-card__status-dot">●</span>
                <span class="kpi-card__status-txt">{(k as any).statusText}</span>
              </p>
            </>
          ) : (
            <>
              <div class="kpi-card__divider" />
              <p class={`kpi-card__delta-pill ${
                ((k as any).invertColor ? k.delta <= 0 : k.delta >= 0) ? "is-up" : "is-down"
              }`}>
                <span class="kpi-card__delta-arrow">{k.delta >= 0 ? "▲" : "▼"}</span>
                <span class="kpi-card__delta-txt">{k.deltaTxt}</span>
              </p>
            </>
          )}
        </article>
      ))}
    </section>

    <IndicadorPanel numero="1" eyebrow="Votación" titulo="Panorama general 2026" lead="Cómo votó Colombia: censo, participación, votos válidos, nulos y no marcados.">
      <div slot="visual" class="charts-row-2">
        <Chart id="pres-2026-composicion-votos" embedded={true} />
        <Chart id="pres-2026-participacion-historico" embedded={true} />
      </div>
    </IndicadorPanel>

    <IndicadorPanel numero="2" eyebrow="Candidatos" titulo="Votos por candidato" lead="Distribución total de votos válidos. Color por bloque ideológico.">
      <Chart slot="visual" id="pres-2026-votos-candidato" embedded={true} />
    </IndicadorPanel>

    <IndicadorPanel numero="3" eyebrow="Geografía" titulo="Ganador por departamento — 2022 vs 2026" lead="Color del bloque ideológico del candidato ganador en cada departamento. Izquierda: 2022 · Derecha: 2026.">
      <div slot="visual" class="mapas-comparativo">
        <div class="mapa-col">
          <p class="mapa-col__label">2022 · 1ª Vuelta</p>
          <Chart id="pres-2022-1v-mapa-depto-ganador" embedded={true} />
        </div>
        <div class="mapa-col">
          <p class="mapa-col__label">2026 · 1ª Vuelta</p>
          <Chart id="pres-2026-mapa-depto-ganador" embedded={true} />
        </div>
      </div>
    </IndicadorPanel>

    <IndicadorPanel numero="4" eyebrow="Tendencia" titulo="Variación del voto por tendencia" lead="Porcentaje de variación de votos por tendencia política (izquierda, centro, derecha) en 2026 comparado con 2022. Selecciona la tendencia para ver el detalle por departamento.">
      <div slot="visual">
        <Chart id="pres-2026-mapa-variacion-tendencia" embedded={true} />

        <div class="tendencia-resumen">
          {resumen.map((r) => (
            <article class={`tendencia-card tendencia-card--${r.bloque}`}>
              <p class="tendencia-card__label"><span class={`chip chip--${r.bloque}`}>{r.bloque}</span></p>
              <p class="tendencia-card__big">{fmtSignedPct(r.pctNacional)}</p>
              <p class="tendencia-card__sub">Δ nacional · {fmtSignedInt(r.deltaTotal)} votos</p>
              <ul class="tendencia-card__list">
                <li>Promedio Δ por departamento: <strong>{fmtSignedPct(r.promedioPctDeptos)}</strong></li>
                <li>Creció en <strong>{r.deptosCrecio}</strong> deptos · cayó en <strong>{r.deptosDecrecio}</strong></li>
                <li>Mayor crecimiento: <strong>{r.topDepto.nombre}</strong> ({fmtSignedPct(r.topDepto.pct)})</li>
                <li>Mayor caída: <strong>{r.bottomDepto.nombre}</strong> ({fmtSignedPct(r.bottomDepto.pct)})</li>
              </ul>
            </article>
          ))}
        </div>

        <div class="lectura-estrategica">
          <h3>Lectura estratégica</h3>
          <ul>
            <li>
              A nivel nacional la <strong>izquierda</strong> varía <strong>{fmtSignedPct(resumen[0].pctNacional)}</strong>
              ({fmtSignedInt(resumen[0].deltaTotal)} votos), con un promedio departamental de
              <strong> {fmtSignedPct(resumen[0].promedioPctDeptos)}</strong> — diferencia que indica si el crecimiento es
              concentrado en pocos departamentos o disperso.
            </li>
            <li>
              El <strong>centro</strong> registra <strong>{fmtSignedPct(resumen[1].pctNacional)}</strong>
              ({fmtSignedInt(resumen[1].deltaTotal)} votos). Cuando el centro crece más en territorios donde la izquierda
              también crece, suele indicar movilización del voto urbano joven; cuando crece donde la derecha cae,
              está absorbiendo votantes desencantados con la derecha tradicional.
            </li>
            <li>
              La <strong>derecha</strong> muestra <strong>{fmtSignedPct(resumen[2].pctNacional)}</strong>
              ({fmtSignedInt(resumen[2].deltaTotal)} votos). Los departamentos donde más crece son su nuevo techo
              electoral; los departamentos donde cae son los que abren espacio a centro o izquierda en 2ª vuelta.
            </li>
            <li>
              Bloques con <strong>promedio departamental</strong> muy distinto del <strong>nacional</strong>
              indican un cambio territorial: si el nacional crece pero el promedio depto es menor, el crecimiento se
              concentra en los departamentos más poblados (Bogotá, Antioquia, Valle).
            </li>
          </ul>
        </div>

        <div class="tablas-tendencias">
          {bloques.map((b) => (
            <div class="tabla-wrap tendencia-tabla">
              <h3 class="tabla-titulo">
                <span class={`chip chip--${b}`}>{b}</span> — variación por departamento
                <span class="tabla-titulo__hint">· clic en una columna para ordenar</span>
              </h3>
              <div class="tabla-scroll">
                <table class="tabla-detalle tabla-sortable" data-sort-table>
                  <thead>
                    <tr>
                      <th data-sort-key="nombre" data-sort-type="text">Departamento <span class="sort-arrow"></span></th>
                      <th class="num" data-sort-key="votos22" data-sort-type="num">Votos 2022 <span class="sort-arrow"></span></th>
                      <th class="num" data-sort-key="votos26" data-sort-type="num">Votos 2026 <span class="sort-arrow"></span></th>
                      <th class="num" data-sort-key="delta" data-sort-type="num" data-sort-default="desc">Δ votos <span class="sort-arrow">▼</span></th>
                      <th class="num" data-sort-key="pct" data-sort-type="num">Δ % <span class="sort-arrow"></span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {filasPorTendencia[b].map((f) => (
                      <tr
                        data-nombre={f.nombre}
                        data-votos22={f.votos22}
                        data-votos26={f.votos26}
                        data-delta={f.delta}
                        data-pct={Number.isFinite(f.pct) ? f.pct : (f.pct > 0 ? Number.MAX_VALUE : -Number.MAX_VALUE)}
                      >
                        <td>{f.nombre}</td>
                        <td class="num">{fmtMiles(f.votos22)}</td>
                        <td class="num">{fmtMiles(f.votos26)}</td>
                        <td class={`num ${f.delta >= 0 ? "is-up" : "is-down"}`}>{fmtSignedInt(f.delta)}</td>
                        <td class={`num ${f.delta >= 0 ? "is-up" : "is-down"}`}>{fmtSignedPct(f.pct)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      </div>
    </IndicadorPanel>

    <IndicadorPanel numero="5" eyebrow="Ideología" titulo="Bloques ideológicos — 2022 vs 2026" lead="Agrupando candidatos por ideología, ¿hacia dónde se movió el país?">
      <div slot="visual">
        <div class="charts-row-2">
          <Chart id="pres-ideologia-2022" embedded={true} />
          <Chart id="pres-ideologia-2026" embedded={true} />
        </div>

        <div class="tabla-wrap variacion">
          <h3 class="tabla-titulo">Variación por bloque ideológico (2022 → 2026)</h3>
          <table class="tabla-detalle">
            <thead>
              <tr>
                <th>Bloque</th>
                <th class="num">Votos 2022</th>
                <th class="num">% 2022</th>
                <th class="num">Votos 2026</th>
                <th class="num">% 2026</th>
                <th class="num">Δ pp</th>
              </tr>
            </thead>
            <tbody>
              {variacionBloques.map((v) => (
                <tr>
                  <td><span class={`chip chip--${v.bloque}`}>{v.bloque}</span></td>
                  <td class="num">{fmtMiles(v.votos2022)}</td>
                  <td class="num">{(v.share2022 * 100).toFixed(2)}%</td>
                  <td class="num">{fmtMiles(v.votos2026)}</td>
                  <td class="num">{(v.share2026 * 100).toFixed(2)}%</td>
                  <td class={`num ${v.deltaShare >= 0 ? "is-up" : "is-down"}`}>
                    {v.deltaShare >= 0 ? "▲" : "▼"} {Math.abs(v.deltaShare * 100).toFixed(2)} pp
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="tablas-grid">
          {[
            { anio: "2022 — 1ª vuelta", filas: filas2022, total: eleccion2022.agregados.nacional.validos },
            { anio: "2026 — 1ª vuelta", filas: filas2026, total: eleccion.agregados.nacional.validos },
          ].map((t) => (
            <div class="tabla-wrap">
              <h3 class="tabla-titulo">{t.anio}</h3>
              <table class="tabla-detalle">
                <thead>
                  <tr><th>Candidato</th><th>Partido</th><th>Bloque</th><th class="num">Votos</th><th class="num">% válidos</th></tr>
                </thead>
                <tbody>
                  {t.filas.map((f) => (
                    <tr>
                      <td>{f.nombre}</td>
                      <td class="muted">{f.partido}</td>
                      <td><span class={`chip chip--${f.ideologia}`}>{f.ideologia}</span></td>
                      <td class="num">{fmtMiles(f.votos)}</td>
                      <td class="num">{(f.share * 100).toFixed(2)}%</td>
                    </tr>
                  ))}
                  <tr class="tot">
                    <td colspan="3">Total válidos</td>
                    <td class="num">{fmtMiles(t.total)}</td>
                    <td class="num">100.00%</td>
                  </tr>
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </div>
    </IndicadorPanel>

