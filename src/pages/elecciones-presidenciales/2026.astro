  <script is:inline>
    (function initSortableTables() {
      function init() {
        document.querySelectorAll("table[data-sort-table]").forEach(function (table) {
          if (table.__sortBound) return;
          table.__sortBound = true;
          const ths = table.querySelectorAll("thead th[data-sort-key]");
          ths.forEach(function (th) {
            th.addEventListener("click", function () {
              const key = th.dataset.sortKey;
              const type = th.dataset.sortType || "text";
              const currentDir = th.dataset.sortDir || "";
              const nextDir = currentDir === "asc" ? "desc" : "asc";
              ths.forEach(function (other) {
                if (other !== th) {
                  other.dataset.sortDir = "";
                  const arr = other.querySelector(".sort-arrow");
                  if (arr) arr.textContent = "";
                }
              });
              th.dataset.sortDir = nextDir;
              const arrow = th.querySelector(".sort-arrow");
              if (arrow) arrow.textContent = nextDir === "asc" ? "▲" : "▼";
              const tbody = table.querySelector("tbody");
              const rows = Array.from(tbody.querySelectorAll("tr"));
              rows.sort(function (a, b) {
                const av = a.dataset[key];
                const bv = b.dataset[key];
                if (type === "num") {
                  const an = parseFloat(av);
                  const bn = parseFloat(bv);
                  return nextDir === "asc" ? an - bn : bn - an;
                }
                const cmp = String(av).localeCompare(String(bv), "es");
                return nextDir === "asc" ? cmp : -cmp;
              });
              rows.forEach(function (r) { tbody.appendChild(r); });
            });
          });
        });
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</BaseLayout>

