---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import EleccionesNav from "../../components/observatorio/EleccionesNav.astro";
import PlotlyLoader from "../../components/observatorio/PlotlyLoader.astro";
import IndicadorPanel from "../../components/observatorio/IndicadorPanel.astro";
import Chart from "../../components/observatorio/Chart.astro";
import DashboardFooter from "../../components/observatorio/DashboardFooter.astro";

import {
  getPres2022_1v, getPres2022_2v, getPres2026_1v, getPresCandidatos,
} from "../../lib/observatorio/data";
import { simular2026_2V, construirInputs, montecarlo2026_2V } from "../../lib/observatorio/simulacion-2026-2v";

const fecha = "2026-06-01";

const e22_1v = getPres2022_1v();
const e22_2v = getPres2022_2v();
const e26    = getPres2026_1v();
const cat    = getPresCandidatos();

const sim = simular2026_2V(e26, e22_1v, e22_2v, cat);
const mc = montecarlo2026_2V(construirInputs(e26, e22_1v, e22_2v, cat));

const fmtMiles = (n: number) => new Intl.NumberFormat("es-CO").format(n);
const fmtCompact = (n: number) => new Intl.NumberFormat("es-CO", { notation: "compact", maximumFractionDigits: 2 }).format(n);
const fmtSigned = (n: number) => new Intl.NumberFormat("es-CO", { signDisplay: "always" }).format(n);
const fmtPct = (n: number) => `${n.toFixed(2)}%`;

const total2v = sim.nacional.cepeda + sim.nacional.abelardo;
const shareCep = (sim.nacional.cepeda / total2v) * 100;
const shareAbe = (sim.nacional.abelardo / total2v) * 100;

const probGanador = sim.nacional.ganador === "cepeda" ? mc.probCepeda : mc.probAbelardo;

// ── Datos comparativos 1V 2022 vs 1V 2026 (mismo espectro de bloques) ────────
const blo = (e: ReturnType<typeof getPres2022_1v>, lista: { id: string; ideologia: string }[]) => {
  const map = new Map(lista.map(c => [c.id, c.ideologia]));
  const acc: { izquierda: number; centro: number; derecha: number } = { izquierda: 0, centro: 0, derecha: 0 };
  for (const r of e.resultados) {
    const ideo = (map.get(r.id) ?? "centro") as "izquierda" | "centro" | "derecha";
    acc[ideo] += r.votos;
  }
  const tot = acc.izquierda + acc.centro + acc.derecha;
  return { ...acc, tot };
};
const blo22 = blo(e22_1v, cat.candidatos["2022-1v"]);
const blo26 = blo(e26, cat.candidatos["2026-1v"]);
const comparativo1v = [
  { bloque: "izquierda", v22: blo22.izquierda, s22: blo22.izquierda / blo22.tot, v26: blo26.izquierda, s26: blo26.izquierda / blo26.tot },
  { bloque: "centro",    v22: blo22.centro,    s22: blo22.centro / blo22.tot,    v26: blo26.centro,    s26: blo26.centro / blo26.tot },
  { bloque: "derecha",   v22: blo22.derecha,   s22: blo22.derecha / blo22.tot,   v26: blo26.derecha,   s26: blo26.derecha / blo26.tot },
];

// ── Tablas y KPIs derivados de la simulación ────────────────────────────
const top5Cepeda = [...sim.departamentos]
  .filter(d => d.ganador === "cepeda")
  .sort((a, b) => b.margen - a.margen)
  .slice(0, 5);
const top5Abelardo = [...sim.departamentos]
  .filter(d => d.ganador === "abelardo")
  .sort((a, b) => a.margen - b.margen)
  .slice(0, 5);
const bisagra = [...sim.departamentos]
  .map(d => ({
    ...d,
    margenPp: ((d.margen) / Math.max(d.cepedaProj + d.abelardoProj, 1)) * 100,
  }))
  .sort((a, b) => Math.abs(a.margenPp) - Math.abs(b.margenPp))
  .slice(0, 8);

const ganadorNac = sim.nacional.ganador === "cepeda" ? "Iván Cepeda" : "Abelardo de la Espriella";
const ganadorColor = sim.nacional.ganador === "cepeda" ? "#dc2626" : "#2563eb";
---
<BaseLayout
  title="Pronóstico Electoral 2026 — Segunda Vuelta Colombia"
  description="Análisis técnico, estratégico y prospectivo para la segunda vuelta presidencial de Colombia 2026 entre Abelardo de la Espriella e Iván Cepeda, basado en modelado cuantitativo del comportamiento territorial 2022."
  image="/images/observatorio.png"
  imageAlt="Observatorio · Pronóstico segunda vuelta presidencial Colombia 2026"
  type="article"
  fullWidth={true}
  keywords="pronostico electoral colombia 2026, segunda vuelta 2026, abelardo de la espriella, ivan cepeda, simulador departamental, modelo cuantitativo electoral, analisis electoral colombia, estrategia electoral"
  publishedTime="2026-06-01T00:00:00+00:00"
  articleSection="Pronóstico político"
  articleTags={["Pronóstico electoral", "Segunda vuelta 2026", "Abelardo de la Espriella", "Iván Cepeda", "Simulador electoral", "Estrategia política", "IA política"]}
>
  <Hero
    badge={{ text: "Experimento · Agente IA + Datos oficiales" }}
    title="Pronóstico Segunda Vuelta 2026"
    subtitle="Modelo cuantitativo para la segunda vuelta presidencial"
  />
  <EleccionesNav active="pronostico" />
  <PlotlyLoader />

  <main class="observatorio-container">
    <!-- ── KPIs nacionales del pronóstico ── -->
    <section class="forecast-kpis" aria-label="Resultado nacional proyectado">
      <article class="kpi-card kpi-card--cepeda">
        <p class="kpi-card__label">Iván Cepeda (Izquierda)</p>
        <p class="kpi-card__value">{fmtCompact(sim.nacional.cepeda)}</p>
        <p class="kpi-card__sub">{fmtPct(shareCep)} de los votos válidos proyectados</p>
      </article>
      <article class="kpi-card kpi-card--abelardo">
        <p class="kpi-card__label">Abelardo de la Espriella (Derecha)</p>
        <p class="kpi-card__value">{fmtCompact(sim.nacional.abelardo)}</p>
        <p class="kpi-card__sub">{fmtPct(shareAbe)} de los votos válidos proyectados</p>
      </article>
      <article class="kpi-card kpi-card--margen" style={`border-left-color: ${ganadorColor}`}>
        <p class="kpi-card__label">Ganador proyectado (escenario central)</p>
        <p class="kpi-card__value" style={`color: ${ganadorColor}`}>{ganadorNac}</p>
        <p class="kpi-card__sub">Margen {Math.abs(sim.nacional.margenPp).toFixed(2)} pp ({fmtSigned(sim.nacional.margenAbs)} votos)</p>
      </article>
      <article class="kpi-card kpi-card--prob" style={`border-left-color: ${ganadorColor}`}>
        <p class="kpi-card__label">Probabilidad de victoria (Monte Carlo)</p>
        <p class="kpi-card__value" style={`color: ${ganadorColor}`}>{(probGanador * 100).toFixed(1)}%</p>
        <p class="kpi-card__sub">{ganadorNac} en {Math.round(probGanador * mc.runs).toLocaleString("es-CO")} de {mc.runs.toLocaleString("es-CO")} corridas</p>
      </article>
    </section>

    <!-- PANEL 1: METODOLOGÍA COMPLETA -->
    <IndicadorPanel
      numero="1"
      eyebrow="Metodología"
      titulo="¿Cómo se llegó a este pronóstico?"
      lead="El modelo no extrapola sumas estáticas: calibra el comportamiento real entre la 1ª y la 2ª vuelta de 2022 y lo aplica —de forma moderada— a la base electoral de 2026 por departamento. Aquí está cada paso del razonamiento."
    >
      <div slot="visual" class="metodologia">
        <div class="metodo-pasos">
          <article class="metodo-card">
            <span class="metodo-num">A</span>
            <h3>Análisis de 2022 (1ª y 2ª vuelta)</h3>
            <p>En la 1V 2022 la izquierda (Petro) partió de 8.53M. En la 2V llegó a 11.28M: un crecimiento del <strong>+32%</strong> que <strong>no</strong> fue uniforme, sino concentrado en la periferia (Caribe y Pacífico) donde la abstención se politizó. Por su parte, la derecha sumó ~11M en 1V pero sólo consolidó 10.58M detrás de Hernández en 2V: hubo <strong>fuga</strong> hacia el voto en blanco y la abstención. Esos dos comportamientos —multiplicador de movilización de izquierda y tasa de transferencia de derecha— se miden departamento por departamento.</p>
          </article>
          <article class="metodo-card">
            <span class="metodo-num">B</span>
            <h3>Comparativo 1V 2022 vs 1V 2026 (mismo espectro)</h3>
            <p>El punto de partida de 2026 es estructuralmente parecido al de 2022: un país tripartito con una izquierda fuerte, una derecha mayoritaria pero fragmentada y un centro pequeño. La diferencia clave: en 2026 la izquierda <strong>arranca más arriba</strong> (Cepeda 2º con una base mucho mayor que la de Petro en 2022 relativo al líder), lo que cambia el punto de aplicación de los multiplicadores.</p>
            <div class="comparativo-mini">
              <table class="tabla-detalle">
                <thead>
                  <tr><th>Bloque</th><th class="num">1V 2022</th><th class="num">1V 2026</th><th class="num">Δ pp</th></tr>
                </thead>
                <tbody>
                  {comparativo1v.map(c => (
                    <tr>
                      <td><span class={`chip chip--${c.bloque}`}>{c.bloque}</span></td>
                      <td class="num">{fmtPct(c.s22 * 100)}</td>
                      <td class="num">{fmtPct(c.s26 * 100)}</td>
                      <td class={`num ${c.s26 - c.s22 >= 0 ? "is-up" : "is-down"}`}>{(c.s26 - c.s22 >= 0 ? "+" : "")}{((c.s26 - c.s22) * 100).toFixed(2)} pp</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
          <article class="metodo-card">
            <span class="metodo-num">C</span>
            <h3>Moderación (lo que evita el sobre-optimismo)</h3>
            <p>El balotaje de 2022 fue atípico (Petro vs un outsider antisistema, polarización récord). El modelo modera ese efecto pero calibra cada supuesto con criterio político, no con prudencia ciega:</p>
            <ul>
              <li><strong>Amortigua</strong> el multiplicador de izquierda con regresión a la media (λ=0.72) y techo <strong>1.32x</strong> — promedio aplicado: <strong>{sim.totales.multIzqPromedio.toFixed(3)}x</strong>. No lo aplasta: la izquierda sí moviliza en 2ª vuelta.</li>
              <li>Modela la transferencia de la derecha con <strong>piso 0.82</strong>: De la Espriella es una figura polarizante de alto rechazo y transfiere <em>peor</em> que un candidato tradicional — promedio aplicado: <strong>{sim.totales.transfDerPromedio.toFixed(3)}</strong>.</li>
              <li>Reparte el centro <strong>57/43</strong> hacia Cepeda: el centro (Fajardo) rechaza a un candidato de extrema derecha, como Fajardo→Petro en 2022.</li>
            </ul>
          </article>
          <article class="metodo-card">
            <span class="metodo-num">D</span>
            <h3>Factores técnicos considerados</h3>
            <ul>
              <li>Voto por candidato y por bloque ideológico en los 33 departamentos × 3 elecciones.</li>
              <li>Multiplicador de movilización periférica (Caribe/Pacífico vs interior).</li>
              <li>Tasa de transferencia y fuga del bloque de derecha.</li>
              <li>Reparto del centro y candidatos sin continuidad en 2V.</li>
              <li>Incertidumbre de los 4 supuestos vía Monte Carlo (4.000 corridas).</li>
            </ul>
          </article>
        </div>

        <div class="charts-row-2">
          <Chart id="pres-2026-2v-pronostico-composicion" embedded={true} />
          <Chart id="pres-2026-2v-pronostico-mapa-ganador" embedded={true} />
        </div>
      </div>
    </IndicadorPanel>

    <IndicadorPanel
      numero="2"
      eyebrow="Geografía del balotaje"
      titulo="Dónde se decide la elección — margen por departamento"
      lead="Los departamentos en rojo se proyectan para Cepeda; los azules para De la Espriella. Mientras más larga la barra, más claro el resultado en ese territorio."
    >
      <Chart slot="visual" id="pres-2026-2v-pronostico-margen-depto" embedded={true} />
    </IndicadorPanel>

    <!-- PANEL: PROBABILIDAD MONTE CARLO -->
    <IndicadorPanel
      numero="3"
      eyebrow="Probabilidad"
      titulo="¿Qué tan probable es que se cumpla la predicción?"
      lead="Una predicción puntual no basta. Se muestrean los 4 supuestos clave (amortiguación, techo, reparto del centro y consolidación de la derecha) con distribuciones acotadas y se corre el modelo 4.000 veces. La probabilidad de victoria es la fracción de corridas que gana cada candidato."
    >
      <div slot="visual" class="prob-grid">
        <div class="prob-side">
          <div class="prob-big" style={`color: ${ganadorColor}`}>{(probGanador * 100).toFixed(1)}%</div>
          <p class="prob-cap">probabilidad de victoria de <strong>{ganadorNac}</strong></p>
          <ul class="prob-list">
            <li>Margen mediano: <strong>{mc.margenPpP50.toFixed(2)} pp</strong></li>
            <li>Rango P10–P90: <strong>{mc.margenPpP10.toFixed(1)} a {mc.margenPpP90.toFixed(1)} pp</strong></li>
            <li>Prob. Cepeda: <strong>{(mc.probCepeda * 100).toFixed(1)}%</strong> · Prob. Abelardo: <strong>{(mc.probAbelardo * 100).toFixed(1)}%</strong></li>
            <li>Corridas: <strong>{mc.runs.toLocaleString("es-CO")}</strong></li>
          </ul>
          <p class="prob-note">Interpretación: el favorito {Math.abs(mc.margenPpP10) < 1 || (mc.margenPpP10 < 0 && mc.margenPpP90 > 0) ? "no tiene la elección asegurada — el rango de incertidumbre cruza el empate" : "mantiene la ventaja en la gran mayoría de escenarios, aunque no es una certeza"}.</p>
        </div>
        <Chart id="pres-2026-2v-pronostico-montecarlo" embedded={true} />
      </div>
    </IndicadorPanel>

    <!-- PANEL 4: BISAGRA -->
    <IndicadorPanel
      numero="4"
      eyebrow="Departamentos bisagra"
      titulo="Los 8 departamentos que pueden cambiar el resultado"
      lead="Aquí el margen proyectado es menor al 5% del voto local — pequeños movimientos de movilización los voltean. La campaña que gane se decide por la operación electoral en estas plazas."
    >
      <div slot="visual" class="tabla-wrap">
        <table class="tabla-detalle">
          <thead>
            <tr>
              <th>Departamento</th>
              <th class="num">Cepeda proj</th>
              <th class="num">Abelardo proj</th>
              <th class="num">Margen</th>
              <th class="num">Margen %</th>
              <th>Favorito</th>
            </tr>
          </thead>
          <tbody>
            {bisagra.map(d => (
              <tr>
                <td><strong>{d.nombre}</strong></td>
                <td class="num">{fmtMiles(d.cepedaProj)}</td>
                <td class="num">{fmtMiles(d.abelardoProj)}</td>
                <td class={`num ${d.ganador === "cepeda" ? "is-up" : "is-down"}`}>{fmtSigned(d.margen)}</td>
                <td class={`num ${d.ganador === "cepeda" ? "is-up" : "is-down"}`}>{d.margenPp >= 0 ? "+" : ""}{d.margenPp.toFixed(2)}%</td>
                <td><span class={`chip chip--${d.ganador === "cepeda" ? "cepeda" : "abelardo"}`}>{d.ganador === "cepeda" ? "Cepeda 🔴" : "Abelardo 🔵"}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </IndicadorPanel>

    <!-- PANEL 5: PROYECCIÓN DETALLADA -->
    <IndicadorPanel
      numero="5"
      eyebrow="Proyección departamental completa"
      titulo="Tabla maestra — los 33 departamentos"
      lead="Multiplicador izquierda y tasa de transferencia derecha calculados con 2022. Proyección de votos en 2V para cada candidato y margen resultante."
    >
      <div slot="visual" class="tabla-wrap">
        <div class="tabla-scroll" style="max-height: 480px;">
          <table class="tabla-detalle tabla-sortable" data-sort-table>
            <thead>
              <tr>
                <th data-sort-key="nombre" data-sort-type="text">Departamento <span class="sort-arrow"></span></th>
                <th class="num" data-sort-key="multIzq" data-sort-type="num">Mult. izq <span class="sort-arrow"></span></th>
                <th class="num" data-sort-key="transfDer" data-sort-type="num">Transf. der <span class="sort-arrow"></span></th>
                <th class="num" data-sort-key="cepedaProj" data-sort-type="num">Cepeda 2V <span class="sort-arrow"></span></th>
                <th class="num" data-sort-key="abelardoProj" data-sort-type="num">Abelardo 2V <span class="sort-arrow"></span></th>
                <th class="num" data-sort-key="margen" data-sort-type="num">Margen <span class="sort-arrow"></span></th>
              </tr>
            </thead>
            <tbody>
              {sim.departamentos.map(d => (
                <tr
                  data-nombre={d.nombre}
                  data-mult-izq={d.multIzq}
                  data-transf-der={d.transfDer}
                  data-cepeda-proj={d.cepedaProj}
                  data-abelardo-proj={d.abelardoProj}
                  data-margen={d.margen}
                >
                  <td>{d.nombre}</td>
                  <td class="num" style="font-family: monospace;">{d.multIzq.toFixed(3)}</td>
                  <td class="num" style="font-family: monospace;">{d.transfDer.toFixed(3)}</td>
                  <td class="num" style="color: #b91c1c; font-weight: 600;">{fmtMiles(d.cepedaProj)}</td>
                  <td class="num" style="color: #1d4ed8;">{fmtMiles(d.abelardoProj)}</td>
                  <td class={`num ${d.ganador === "cepeda" ? "is-up" : "is-down"}`}>{fmtSigned(d.margen)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </IndicadorPanel>

    <!-- PANEL 6: VEREDICTO + ESTRATEGIA -->
    <IndicadorPanel
      numero="6"
      eyebrow="Veredicto y ruta crítica"
      titulo="Predicción final y jugadas estratégicas"
      lead="La lectura política del modelo: por qué gana quien gana, dónde se decide y qué tendría que hacer el perdedor para revertirlo."
    >
      <div slot="visual" class="veredicto">
        <div class="veredicto-card" style={`border-left-color: ${ganadorColor}`}>
          <h3 class="veredicto-card__title">Veredicto del modelo</h3>
          <p class="veredicto-card__big" style={`color: ${ganadorColor}`}>{ganadorNac}</p>
          <p>Bajo los supuestos centrales <em>realistas</em> (multiplicador de izquierda amortiguado λ=0.72 con techo 1.32x, transferencia de derecha con piso 0.82 por el alto rechazo de De la Espriella, centro 57/43 hacia Cepeda), el modelo proyecta una victoria de <strong>{ganadorNac}</strong> con un margen de <strong>{Math.abs(sim.nacional.margenPp).toFixed(2)} pp</strong> ({fmtSigned(sim.nacional.margenAbs)} votos). La simulación Monte Carlo (4.000 corridas) le asigna una <strong>probabilidad de {(probGanador * 100).toFixed(1)}%</strong>, con un margen que en el 80% central de los escenarios va de {mc.margenPpP10.toFixed(1)} a {mc.margenPpP90.toFixed(1)} pp. No es una certeza: es un favoritismo cuantificado.</p>
        </div>

        <div class="grid-2col">
          <div class="est-card izq">
            <h4>¿Por qué gana Cepeda según el modelo?</h4>
            <ol>
              <li><strong>Multiplicador amortiguado:</strong> el multiplicador de izquierda aplicado (ya moderado) promedia {sim.totales.multIzqPromedio.toFixed(3)}x. Aun amortiguado, amplía la base de Cepeda más de lo que la derecha logra consolidar.</li>
              <li><strong>Costa Caribe y Pacífico:</strong> los departamentos donde Cepeda gana con más holgura son {top5Cepeda.map(d => d.nombre).join(", ")} — ahí concentra el grueso del margen.</li>
              <li><strong>Centro a su favor:</strong> el reparto 57/43 sobre los ~{fmtCompact(sim.totales.baseCentro26)} votos del centro 2026 refleja el rechazo del centro a la extrema derecha y suma a la ventaja.</li>
            </ol>
          </div>
          <div class="est-card der">
            <h4>¿Por qué falla De la Espriella?</h4>
            <ol>
              <li><strong>Desgaste de transferencia:</strong> aun con piso de consolidación 0.90, la transferencia promedio aplicada es {sim.totales.transfDerPromedio.toFixed(3)}. Sobre su base 2026 (~{fmtCompact(sim.totales.baseDer26)}), la fuga ronda los {fmtCompact(Math.round(sim.departamentos.reduce((a, d) => a + d.baseDer26 * (1 - d.transfDer), 0)))} votos.</li>
              <li><strong>Plazas fuertes pero acotadas:</strong> gana con holgura en {top5Abelardo.map(d => d.nombre).join(", ")}, pero su techo en la periferia es estructuralmente bajo.</li>
              <li><strong>Centro no neutraliza:</strong> incluso con 40% del centro, no compensa el multiplicador de izquierda en los departamentos populosos.</li>
            </ol>
          </div>
        </div>

        <div class="grid-2col">
          <div class="est-card izq">
            <h4>🔴 Ruta al triunfo · Cepeda</h4>
            <ol>
              <li>Operación electoral extrema en bisagras: {bisagra.slice(0, 4).map(d => d.nombre).join(", ")}.</li>
              <li>Endoso explícito y activo del centro (Fajardo, Claudia López) — inclinar el reparto del centro a su favor.</li>
              <li>Movilización porta-a-puerta en Costa Caribe para superar la abstención histórica.</li>
            </ol>
          </div>
          <div class="est-card der">
            <h4>🔵 Ruta al triunfo · De la Espriella</h4>
            <ol>
              <li>Cerrar la fuga de transferencia: alianza pública con Paloma Valencia, Daniel Palacios, Miguel Uribe.</li>
              <li>Disputarle el centro: bajar el supuesto a 50/50 ya cambia significativamente el margen.</li>
              <li>Capear el multiplicador de izquierda en plazas grandes (Bogotá, Valle, Atlántico) con campaña de control del clima emocional.</li>
            </ol>
          </div>
        </div>

        <div class="lectura-estrategica">
          <h3>Sensibilidad — ¿qué cambia si los supuestos se mueven?</h3>
          <ul>
            <li>Si el <strong>centro se reparte 50/50</strong> en lugar de 57/43, el margen de Cepeda se reduce en aproximadamente {Math.round(sim.totales.baseCentro26 * 0.14 / 1000)}k votos. Con un margen actual de {fmtSigned(sim.nacional.margenAbs)} votos, el resultado {Math.abs(sim.nacional.margenAbs) < sim.totales.baseCentro26 * 0.14 ? "se voltea" : "se mantiene"}.</li>
            <li>Si la <strong>transferencia de derecha</strong> alcanza el 100% (sin fuga), De la Espriella suma ~{fmtCompact(Math.round(sim.departamentos.reduce((a, d) => a + d.baseDer26 * (1 - d.transfDer), 0)))} votos adicionales — el escenario más favorable para la derecha.</li>
            <li>El <strong>rango Monte Carlo P10–P90</strong> del margen ({mc.margenPpP10.toFixed(1)} a {mc.margenPpP90.toFixed(1)} pp) resume toda la incertidumbre conjunta: {mc.margenPpP10 < 0 ? "incluye escenarios donde el resultado se invierte" : "incluso el escenario pesimista mantiene al favorito arriba"}.</li>
          </ul>
        </div>
      </div>
    </IndicadorPanel>

