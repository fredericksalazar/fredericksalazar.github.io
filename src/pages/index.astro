---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Frederick Salazar — Senior Data Engineer";
const description =
  "Senior Data Engineer & Arquitecto de Datos con +11 años de experiencia.";

// Proyectos destacados
const allProyectos = await getCollection("proyectos");
const topProyectos = allProyectos
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);

// Últimos artículos del blog
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("es-CO", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

// Tecnologías para cada proyecto
const techBadges: Record<string, string[]> = {
  ollamafx: ["JavaFX", "Java", "RAG", "LLM", "Ollama"],
  "dinawall-app-2": ["JavaFX", "Java", "Linux", "Windows", "macOS"],
  "analisis-machine-learning-elecciones-presidenciales-colombia-2022": [
    "Python",
    "NLP",
    "ML",
    "Twitter API",
    "Pandas",
  ],
  "analysis-indicadores-economia-de-colombia": [
    "Python",
    "Pandas",
    "World Bank",
    "Plotly",
    "Matplotlib",
  ],
  "data-analysis-world-population": [
    "Python",
    "Pandas",
    "Plotly",
    "Seaborn",
    "World Bank",
  ],
  "analisis-elecciones-congreso-colombia-2026": [
    "D3.js",
    "Chart.js",
    "Python",
    "Data Visualization",
    "Electoral Data",
  ],
};

// Certificaciones con imágenes reales
const certifications = [
  {
    name: "Azure Data Engineer",
    img: "/badges/azure_de.png",
    alt: "Microsoft Certified: Azure Data Engineer Associate",
  },
  {
    name: "Azure Data Fundamentals",
    img: "/badges/azure_df.png",
    alt: "Azure Data Fundamentals",
  },
  {
    name: "Azure AI Fundamentals",
    img: "/badges/azure_ai.png",
    alt: "Azure AI Fundamentals",
  },
  {
    name: "Databricks",
    img: "/badges/databricks_fundamentals.png",
    alt: "Databricks Lakehouse Fundamentals",
  },
  {
    name: "Google AI",
    img: "/badges/google_ai.png",
    alt: "Google AI Essentials",
  },
  { name: "MongoDB", img: "/badges/mongodb_si.png", alt: "MongoDB Certified" },
];
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- ── Hero Section ── -->
  <section class="hero">
    <!-- Decoraciones de fondo -->
    <div class="hero__orb hero__orb--tl" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--br" aria-hidden="true"></div>
    <div class="hero__arc" aria-hidden="true"></div>
    <div class="hero__arc hero__arc--2" aria-hidden="true"></div>

    <!-- Fila superior (90%): marca + imagen -->
    <div class="hero__main">

      <!-- Izquierda: marca personal -->
      <div class="hero__main-content">
        <span class="hero__status">
          <span class="hero__status-pulse"></span>
          Disponible para nuevos proyectos
        </span>

        <p class="hero__role">
          <span class="hero__role-line"></span>
          Senior Data Engineer &amp; Data Architect
        </p>

        <h1 class="hero__name">
          <span class="hero__name-first">Frederick</span>
          <span class="hero__name-last">
            Salazar<span class="hero__name-dot">.</span>
          </span>
        </h1>

        <p class="hero__tagline">
          <span class="hero__tagline-accent">+11 años</span> transformando datos en
          <em>decisiones estratégicas</em> a través de arquitecturas cloud, pipelines escalables e inteligencia artificial.
        </p>

        <div class="hero__pills">
          <span class="hero__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3 2 9l10 6 10-6-10-6Z"/>
              <path d="m2 15 10 6 10-6"/>
              <path d="m2 12 10 6 10-6"/>
            </svg>
            Arquitectura
          </span>
          <span class="hero__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <ellipse cx="12" cy="5" rx="9" ry="3"/>
              <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
              <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>
            </svg>
            Data Engineering
          </span>
          <span class="hero__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>
              <path d="M5 3v4M19 17v4M3 5h4M17 19h4"/>
            </svg>
            AI &amp; Machine Learning
          </span>
          <span class="hero__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            </svg>
            Cloud
          </span>
        </div>
        </div>
      </div>

      <!-- Imagen pegada al borde derecho de la página -->
      <div class="hero__image-wrapper">
        <img
          src="/images/hero_image.png"
          alt="Arquitectura de datos isométrica"
          class="hero__main-img"
          loading="eager"
        />
      </div>

      <!-- Fila inferior (10%): partners cloud lineales -->
      <div class="hero__partners">
      <span class="hero__partners-label">Cloud Partners</span>
      <div class="hero__partners-divider" aria-hidden="true"></div>
      <div class="hero__partners-logos">
        <img src="/logos/aws.png" alt="AWS" class="hero__partner-logo hero__partner-logo--aws" />
        <img src="/logos/google.svg" alt="Google Cloud" class="hero__partner-logo hero__partner-logo--google" />
        <img src="/logos/microsoft.svg" alt="Microsoft Azure" class="hero__partner-logo hero__partner-logo--microsoft" />
        <img src="/logos/databricks-logo.png" alt="Databricks" class="hero__partner-logo hero__partner-logo--databricks" />
      </div>
    </div>
  </section>

<!-- ── Sobre mí + Tech Stack ── -->
  <section class="about-section">
    <div class="about-container">
      <!-- Fila 1: Foto + Descripción -->
      <div class="about-top">
        <div class="about-profile">
          <div class="about-profile__image-wrapper">
            <img
              src="/images/profile_globant.jpeg"
              alt="Frederick Salazar"
              class="about-profile__image"
            />
            <div class="about-profile__status">
              <span class="about-profile__status-dot"></span>
              Disponible
            </div>
          </div>
        </div>
        <div class="about-info">
          <span class="section__label">Sobre mí</span>
          <p class="about-text">
            Hola! Soy Frederick Salazar, inicie en el mundo de la tecnología como
            Software Developer en Java, luego conocí el apasionante mundo de los
            datos y todo cambió, actualmente me desempeño como Senior Data
            Engineer & Data Architect en Globant, estudie un Master en BigData
            Analytics en la Universitat Oberta de Catalunya (UOC), vivo en Cali,
            Colombia la capital mundia de la salsa.
          </p>
          <p class="about-text">
            Especializado en ecosistemas cloud como Azure, AWS y GCP,
            procesamiento distribuido y analítica avanzada. Apasionado por el open
            source, la enseñanza técnica y los proyectos de Machine Learning
            aplicado.
          </p>
          <div class="about-actions">
            <a href="/experiencia" class="about-link">
              Ver experiencia completa
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>
            <a href="/certificaciones" class="about-link about-link--muted"
              >Ver certificaciones →</a
            >
          </div>
        </div>
      </div>

      <!-- Fila 2: Tech Stack -->
      <div class="techstack">
        <div class="techstack__group">
          <span class="techstack__label">Data Engineering</span>
          <div class="techstack__pills">
            {
              [
                "Python",
                "Git",
                "GitHub",
                "Apache Spark",
                "SQL",
                "ETL / ELT",
                "Databricks",
                "Azure Data Factory",
                "Apache Airflow",
                "DataWarehouses",
                "DataLakes",
                "Data Lakehouses",
                "DataOps",
                "dbt",
                "Data Modeling",
                "Data Governance",
                "Artificial Intelligence",
              ].map((t) => <span class="techstack__pill">{t}</span>)
            }
          </div>
        </div>
        <div class="techstack__group">
          <span class="techstack__label">Analytics & ML</span>
          <div class="techstack__pills">
            {
              [
                "Pandas",
                "Plotly",
                "Matplotlib",
                "Machine Learning",
                "NLP",
                "Jupyter",
                "Sklearn",
                "SparkML",
                "MLOps",
              ].map((t) => <span class="techstack__pill">{t}</span>)
            }
          </div>
        </div>
        <div class="techstack__group">
          <span class="techstack__label">Cloud & Herramientas</span>
          <div class="techstack__pills">
            {
              [
                "Azure",
                "Google Cloud Platform",
                "Amazon Web Services",

                "GitHub",
                "MongoDB",
                "Linux",
                "Power BI",
              ].map((t) => <span class="techstack__pill">{t}</span>)
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Proyectos ── -->
  <section class="section">
    <div class="section__header">
      <div class="section__title-group">
        <span class="section__label">Portfolio</span>
        <h2 class="section__title">Proyectos destacados</h2>
      </div>
      <a href="/proyectos" class="section__link">
        Ver todos
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>
    </div>

    <div class="projects-grid">
      {
        topProyectos.map((proyecto, index) => {
          const techs = techBadges[proyecto.id] || [];
          return (
            <article class="project-card" style={`--delay: ${index * 100}ms`}>
              <a href={`/proyectos/${proyecto.id}`} class="project-card__link">
                <div class="project-card__img-wrapper">
                  <img
                    src={
                      proyecto.data.imagen ||
                      "https://via.placeholder.com/400x250"
                    }
                    alt={proyecto.data.titulo}
                    loading="lazy"
                  />
                  <div class="project-card__overlay">
                    <span class="project-card__view">Ver proyecto</span>
                  </div>
                </div>
                <div class="project-card__body">
                  <h3 class="project-card__title">{proyecto.data.titulo}</h3>
                  <p class="project-card__excerpt">
                    {proyecto.data.descripcion}
                  </p>
                  {techs.length > 0 && (
                    <div class="project-card__tech">
                      {techs.slice(0, 4).map((tech) => (
                        <span class="tech-badge">{tech}</span>
                      ))}
                      {techs.length > 4 && (
                        <span class="tech-badge tech-badge--more">
                          +{techs.length - 4}
                        </span>
                      )}
                    </div>
                  )}
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ── Blog ── -->
  <section class="section section--alt">
    <div class="section__header">
      <div class="section__title-group">
        <span class="section__label">Blog técnico</span>
        <h2 class="section__title">Últimas publicaciones</h2>
      </div>
      <a href="/blog" class="section__link">
        Ver todos
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>
    </div>

    <div class="blog-grid">
      {
        latestPosts.map((post, index) => (
          <article class="blog-card" style={`--delay: ${index * 100}ms`}>
            <a href={`/blog/${post.id}`} class="blog-card__link">
              <div class="blog-card__img-wrapper">
                <img
                  src={
                    post.data.imagen || "https://via.placeholder.com/400x250"
                  }
                  alt={post.data.titulo}
                  loading="lazy"
                />
              </div>
              <div class="blog-card__body">
                <time
                  class="blog-card__date"
                  datetime={post.data.fecha.toISOString()}
                >
                  {formatDate(post.data.fecha)}
                </time>
                <h3 class="blog-card__title">{post.data.titulo}</h3>
                <p class="blog-card__excerpt">{post.data.descripcion}</p>
                <span class="blog-card__read-more">
                  Leer más
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </>
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Animaciones ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* ──────────────────────────────────────────
   *  HERO — premium edition
   * ────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: visible;
    width: 100%;
    min-height: 660px;
    display: flex;
    align-items: stretch;
    font-family: "Google Sans Flex", "Google Sans", system-ui, -apple-system,
      sans-serif;
    background:
      radial-gradient(
        ellipse 70% 60% at 90% -10%,
        rgba(37, 99, 235, 0.07) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 50% at -10% 110%,
        rgba(96, 165, 250, 0.08) 0%,
        transparent 60%
      ),
      linear-gradient(180deg, #ffffff 0%, #fafbff 60%, #f5f8ff 100%);
    border-bottom: 1px solid rgba(37, 99, 235, 0.08);
  }

  /* Blueprint dots */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.16) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(
      ellipse 100% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  /* Decorative orbs (soft glows) */
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero__orb--tl {
    top: -180px;
    left: -180px;
    width: 480px;
    height: 480px;
    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.12) 0%,
      transparent 70%
    );
  }

  .hero__orb--br {
    bottom: -200px;
    right: 5%;
    width: 540px;
    height: 540px;
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.1) 0%,
      transparent 70%
    );
  }

  /* Decorative arcs */
  .hero__arc {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(37, 99, 235, 0.12);
    pointer-events: none;
    z-index: 0;
    bottom: -380px;
    right: -100px;
    width: 700px;
    height: 700px;
  }

  .hero__arc--2 {
    bottom: -420px;
    right: -50px;
    width: 800px;
    height: 800px;
    border-color: rgba(37, 99, 235, 0.07);
  }

  /* ── Layout 2-rows ── */
  .hero {
    flex-direction: column;
  }

  .hero__main {
    display: grid;
    grid-template-columns: 40% 1fr;
    width: 100%;
    z-index: 1;
    min-height: 0;
  }

  /* Izquierda: marca */
  .hero__main-content {
    padding: 3.5rem 1.5rem 3.5rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.1rem;
    position: relative;
    z-index: 0;
  }

  /* Imagen pegada al borde derecho */
  .hero__image-wrapper {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 60% !important;
    z-index: 1;
    pointer-events: none;
  }

  .hero__main-img {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: cover;
    object-position: right center;
    display: block;
    animation: fadeInRight 0.8s ease-out backwards;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #15803d;
    letter-spacing: 0.01em;
    animation: fadeInUp 0.5s ease-out backwards;
  }

  .hero__status-pulse {
    position: relative;
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
  }

  .hero__status-pulse::before {
    content: "";
    position: absolute;
    inset: -3px;
    background: rgba(34, 197, 94, 0.4);
    border-radius: 50%;
    animation: ping 2s ease-out infinite;
  }

  .hero__role {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #475569;
    text-transform: uppercase;
    margin: 0;
    animation: fadeInUp 0.5s ease-out 0.05s backwards;
  }

  .hero__role-line {
    width: 28px;
    height: 1.5px;
    background: linear-gradient(90deg, #2563eb, transparent);
    border-radius: 2px;
  }

  .hero__name {
    font-family: "Google Sans Flex", "Google Sans", "Product Sans", sans-serif;
    font-size: clamp(3rem, 5.2vw, 5.5rem);
    font-weight: 700;
    font-stretch: 100%;
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin: 0;
    display: flex;
    flex-direction: column;
    animation: fadeInUp 0.6s ease-out 0.1s backwards;
  }

  .hero__name-first {
    color: #0f172a;
  }

  .hero__name-last {
    color: #2563eb;
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 50%, #1e40af 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__name-dot {
    color: #fbbf24;
    -webkit-text-fill-color: #fbbf24;
  }

  .hero__tagline {
    font-size: 1rem;
    font-weight: 400;
    color: #475569;
    line-height: 1.55;
    margin: 0.25rem 0 0;
    max-width: 480px;
    animation: fadeInUp 0.5s ease-out 0.18s backwards;
  }

  .hero__tagline-accent {
    color: #2563eb;
    font-weight: 700;
  }

  .hero__tagline em {
    color: #0f172a;
    font-style: normal;
    font-weight: 600;
    border-bottom: 2px solid rgba(37, 99, 235, 0.25);
    padding-bottom: 1px;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
    animation: fadeInUp 0.5s ease-out 0.28s backwards;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: white;
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #2563eb;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero__pill:hover {
    border-color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.15);
  }

  /* ── Fila inferior: Cloud Partners (10%) ── */
  .hero__partners {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1.25rem 3rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(37, 99, 235, 0.12);
    position: relative;
    z-index: 2;
    animation: fadeInUp 0.5s ease-out 0.4s backwards;
  }

  .hero__partners-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #2563eb;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .hero__partners-divider {
    width: 1px;
    height: 28px;
    background: linear-gradient(
      to bottom,
