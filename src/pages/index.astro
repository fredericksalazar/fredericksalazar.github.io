---
/**
 * index.astro — Página principal / Sobre Mí
 * URL: /
 * 
 * Hero section + resumen profesional + stack de habilidades por categoría.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = 'Frederick Salazar — Data Engineer & Arquitecto de Datos en Colombia';
const description = 'Ingeniero y Arquitecto de Datos con +9 años de experiencia en Data Engineering, Big Data, IA y Analytics. Disponible para proyectos en Colombia y LATAM.';
---

<BaseLayout title={title} description={description}>

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-heading">
    <p class="hero__greeting">Hola, soy</p>
    <h1 id="hero-heading" class="hero__name">Frederick Salazar.</h1>
    <p class="hero__tagline">Construyo arquitecturas de datos<br />que generan valor real.</p>
    <p class="hero__description">
      Senior Data Engineer &amp; Arquitecto de Datos con más de 9 años de experiencia 
      diseñando pipelines escalables, plataformas de datos en la nube y soluciones de IA 
      para empresas en Colombia y LATAM. Actualmente en <strong>Mercado Libre</strong>.
    </p>
    <div class="hero__actions">
      <a href="/proyectos" id="cta-proyectos" class="btn btn--primary">Ver proyectos</a>
      <a href="/experiencia" id="cta-experiencia" class="btn btn--outline">Mi experiencia</a>
    </div>
  </section>

  <!-- ── Skills por categoría ───────────────────────────────────────────── -->
  <section class="skills" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="visually-hidden">Habilidades técnicas</h2>

    <div class="skill-category">
      <div class="skill-category__header">
        <div class="skill-category__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
        </div>
        <div>
          <h3 class="skill-category__title">Data Engineering</h3>
          <span class="section-label">Tecnologías & Herramientas</span>
        </div>
      </div>
      <div class="tags-row">
        {['Apache Spark', 'Databricks', 'Apache Kafka', 'dbt', 'Airflow', 'Delta Lake', 'SQL', 'Python'].map(t => <span class="tag">{t}</span>)}
      </div>
    </div>

    <div class="skill-category">
      <div class="skill-category__header">
        <div class="skill-category__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
        </div>
        <div>
          <h3 class="skill-category__title">Cloud & DevOps</h3>
          <span class="section-label">Tecnologías & Herramientas</span>
        </div>
      </div>
      <div class="tags-row">
        {['Azure', 'Azure Data Factory', 'Azure Synapse', 'Terraform', 'Docker', 'Kubernetes', 'GitHub Actions'].map(t => <span class="tag">{t}</span>)}
      </div>
    </div>

    <div class="skill-category">
      <div class="skill-category__header">
        <div class="skill-category__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <h3 class="skill-category__title">IA & Machine Learning</h3>
          <span class="section-label">Tecnologías & Herramientas</span>
        </div>
      </div>
      <div class="tags-row">
        {['Python', 'Pandas', 'Scikit-learn', 'Matplotlib', 'LLMs', 'Ollama', 'RAG'].map(t => <span class="tag">{t}</span>)}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────────── */
  .hero {
    margin-bottom: 3.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__greeting {
    font-size: 0.95rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .hero__name {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .hero__tagline {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--color-text-secondary);
    line-height: 1.25;
    margin-bottom: 1.25rem;
  }

  .hero__description {
    font-size: 0.975rem;
    color: var(--color-text-muted);
    max-width: 560px;
    line-height: 1.75;
    margin-bottom: 1.75rem;
  }

  .hero__description strong {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ── Buttons ─────────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .btn--primary {
    background: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
  }
  .btn--primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #fff;
    box-shadow: 0 0 16px var(--color-accent-glow);
  }
  .btn--outline {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }
  .btn--outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ── Skills ──────────────────────────────────────────────────────────────── */
  .skills {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-category__header {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .skill-category__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-tag-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .skill-category__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.15rem;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-left: 3.35rem;
  }

  /* ── Utilidades ──────────────────────────────────────────────────────────── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
