---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import IconArchitecture from "../components/icons/IconArchitecture.astro";
import IconDataEngineering from "../components/icons/IconDataEngineering.astro";
import IconAI from "../components/icons/IconAI.astro";
import IconCloud from "../components/icons/IconCloud.astro";

const title = "Frederick Salazar — Senior Data Engineer";
const description =
  "Senior Data Engineer & Arquitecto de Datos con +11 años de experiencia.";

const allProyectos = await getCollection("proyectos");
const topProyectos = allProyectos
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- ── Hero Section ── -->
  <Hero>
    <Fragment slot="content">
      <h1 class="hero__name">
        <span class="hero__name-first">Frederick</span>
        <span class="hero__name-last">
          Salazar<span class="hero__name-dot">.</span>
        </span>
      </h1>

      <p class="hero__role">
        <span class="hero__role-line"></span>
        Experto Data Strategist · Data Architect · Data Engineering
      </p>

      <p class="hero__tagline">
        <span class="hero__tagline-accent">+11 años</span> transformando datos en <em>decisiones estratégicas</em> con arquitecturas cloud y AI.
      </p>

      <div class="hero__pills">
        <span class="hero__pill">
          <IconArchitecture />
          Arquitectura
        </span>
        <span class="hero__pill">
          <IconDataEngineering />
          Data Engineering
        </span>
        <span class="hero__pill">
          <IconAI />
          AI &amp; Machine Learning
        </span>
        <span class="hero__pill">
          <IconCloud />
          Cloud
        </span>
      </div>
    </Fragment>

    <Fragment slot="visual">
      <img
        src="/images/hero_image.png"
        alt="Arquitectura de datos isométrica"
        class="hero__image"
        width="1536"
        height="1024"
        loading="eager"
      />
    </Fragment>
  </Hero>

  <!-- ── Sobre mí + Tech Stack ── -->
  <section class="about-section">
    <div class="about-container">
      <!-- Fila 1: Foto + Descripción -->
      <div class="about-top">
        <div class="about-profile">
          <div class="about-profile__image-wrapper">
            <img
              src="/images/profile_globant.jpeg"
              alt="Frederick Salazar"
              class="about-profile__image"
              width="260"
              height="260"
            />
            <div class="about-profile__status">
              <span class="about-profile__status-dot"></span>
              Disponible
            </div>
          </div>
        </div>
        <div class="about-info">
          <span class="section__label">Sobre mí</span>
          <p class="about-text">
            Hola! Soy Frederick Salazar, inicie en el mundo de la tecnología como
            Software Developer en Java, luego conocí el apasionante mundo de los
            datos y todo cambió, actualmente me desempeño como Senior Data
            Engineer & Data Architect en Globant, estudie un Master en BigData
            Analytics en la Universitat Oberta de Catalunya (UOC), vivo en Cali,
            Colombia la capital mundial de la salsa.
          </p>
          <p class="about-text">
            Especializado en ecosistemas cloud como Azure, AWS y GCP,
            procesamiento distribuido y analítica avanzada. Apasionado por el open
            source, la enseñanza técnica y los proyectos de Machine Learning
            aplicado.
          </p>
          <div class="about-actions">
            <a href="/experiencia" class="about-link">
              Ver experiencia completa
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>
            <a href="/certificaciones" class="about-link about-link--muted"
              >Ver certificaciones →</a
            >
          </div>
        </div>
      </div>

      <!-- Fila 2: Tech Stack -->
      <div class="techstack">
        <div class="techstack__group">
          <span class="techstack__label">Data Engineering</span>
          <div class="techstack__pills">
            {
              [
                "Python",
                "Git",
                "GitHub",
                "Apache Spark",
                "SQL",
                "ETL / ELT",
                "Databricks",
                "Azure Data Factory",
                "Apache Airflow",
                "DataWarehouses",
                "DataLakes",
                "Data Lakehouses",
                "DataOps",
                "dbt",
                "Data Modeling",
                "Data Governance",
                "Artificial Intelligence",
              ].map((t) => <span class="techstack__pill">{t}</span>)
            }
          </div>
        </div>
        <div class="techstack__group">
          <span class="techstack__label">Analytics & ML</span>
          <div class="techstack__pills">
            {
              [
                "Pandas",
                "Plotly",
                "Matplotlib",
                "Machine Learning",
                "NLP",
                "Jupyter",
                "Sklearn",
                "SparkML",
                "MLOps",
              ].map((t) => <span class="techstack__pill">{t}</span>)
            }
          </div>
        </div>
        <div class="techstack__group">
          <span class="techstack__label">Cloud & Herramientas</span>
          <div class="techstack__pills">
            {
              [
                "Azure",
                "Google Cloud Platform",
                "Amazon Web Services",
                "GitHub",
                "MongoDB",
                "Linux",
                "Power BI",
              ].map((t) => <span class="techstack__pill">{t}</span>)
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Proyectos ── -->
  <section class="section">
    <div class="section__inner">
      <div class="section__header">
        <div class="section__title-group">
          <span class="section__label">Portfolio</span>
          <h2 class="section__title">Proyectos destacados</h2>
        </div>
        <a href="/proyectos" class="section__link">
          Ver todos
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>

      <div class="projects-grid">
        {
          topProyectos.map((proyecto, index) => (
            <Card
              variant="project"
              href={`/proyectos/${proyecto.id}`}
              image={proyecto.data.imagen}
              imageAlt={proyecto.data.titulo}
              title={proyecto.data.titulo}
              description={proyecto.data.descripcion}
              tags={proyecto.data.tecnologias}
              delay={index * 100}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Blog ── -->
  <section class="section section--alt">
    <div class="section__inner">
      <div class="section__header">
        <div class="section__title-group">
          <span class="section__label">Blog técnico</span>
          <h2 class="section__title">Últimas publicaciones</h2>
        </div>
        <a href="/blog" class="section__link">
          Ver todos
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>

      <div class="blog-grid">
        {
          latestPosts.map((post, index) => (
            <Card
              variant="blog"
              href={`/blog/${post.id}`}
              image={post.data.imagen}
              imageAlt={post.data.titulo}
              title={post.data.titulo}
              description={post.data.descripcion}
              date={post.data.fecha}
              delay={index * 100}
            />
          ))
        }
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Animations ── */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Custom hero overrides for home ── */
  .hero__role {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #2563eb;
    text-transform: uppercase;
    margin: 0;
    animation: fadeInUp 0.5s ease-out 0.15s backwards;
  }

  .hero__role-line {
    width: 28px;
    height: 1.5px;
    background: linear-gradient(90deg, #2563eb, transparent);
    border-radius: 2px;
  }

  .hero__name {
    font-size: clamp(3rem, 5.2vw, 5.5rem);
    font-weight: 700;
    font-stretch: 100%;
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin: 0;
    display: flex;
    flex-direction: column;
    animation: fadeInUp 0.6s ease-out 0.05s backwards;
  }

  .hero__name-first {
    color: #2563eb;
  }

  .hero__name-last {
    color: #2563eb;
  }

  .hero__name-dot {
    color: #fbbf24;
    -webkit-text-fill-color: #fbbf24;
  }

  .hero__tagline {
    font-size: 1rem;
    font-weight: 400;
    color: #475569;
    line-height: 1.55;
    margin: 0.25rem 0 0;
    max-width: 480px;
    animation: fadeInUp 0.5s ease-out 0.22s backwards;
  }

  .hero__tagline-accent {
    color: #2563eb;
    font-weight: 700;
  }

  .hero__tagline em {
    color: #0f172a;
    font-style: normal;
    font-weight: 600;
    border-bottom: 2px solid rgba(37, 99, 235, 0.25);
    padding-bottom: 1px;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
    animation: fadeInUp 0.5s ease-out 0.3s backwards;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: white;
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #2563eb;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero__pill:hover {
    border-color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.15);
  }

  /* ── Secciones ── */
  .section {
    background: #f6f8fa;
    border-bottom: 1px solid var(--color-border);
    padding: 5rem 2rem;
  }

  .section__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section--alt {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 5rem 2rem;
  }

  .section__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .section__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2563eb;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section__title {
    font-size: 2rem;
    font-weight: 700;
    color: #1f2328;
  }

  .section__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #2563eb;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .section__link:hover {
    gap: 0.75rem;
  }

  /* ── Grillas ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  /* ── Sobre mí + Tech Stack ── */
  .about-section {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 5rem 2rem;
  }

  .about-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-top {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-profile {
    position: sticky;
    top: 2rem;
  }

  .about-profile__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 260px;
    aspect-ratio: 1;
    margin: 0 auto;
  }

  .about-profile__image {
    width: 100%;
    height: 100%;
    border-radius: 24px;
    object-fit: cover;
    object-position: top center;
    border: 4px solid var(--color-border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }

  .about-profile__status {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.95);
    backdrop-filter: blur(8px);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.4);
  }

  .about-profile__status-dot {
    width: 8px;
    height: 8px;
    background: #ffffff;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .about-info {
    padding-top: 0.5rem;
  }

  .about-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .about-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .about-link:hover {
    gap: 0.65rem;
  }

  .about-link--muted {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .about-link--muted:hover {
    color: var(--color-text-secondary);
  }

  .techstack {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .techstack__label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.6rem;
  }

  .techstack__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .techstack__pill {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: 6px;
    color: #2563eb;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }

  .techstack__pill:hover {
    border-color: #2563eb;
    color: #1d4ed8;
    background: rgba(37, 99, 235, 0.15);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .about-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-profile {
      position: static;
      max-width: 240px;
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .hero__name {
      font-size: 2.75rem;
    }

    .section {
      padding: 3rem 1.5rem;
    }

    .section__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .projects-grid,
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
