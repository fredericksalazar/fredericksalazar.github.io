---
/**
 * BaseLayout.astro
 * Layout principal: Sidebar fijo izquierdo + área de contenido derecha.
 * Incluye ViewTransitions (ClientRouter) para navegación fluida tipo SPA
 * con arquitectura MPA estática y máxima indexabilidad SEO.
 */
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import InformePopup from '../components/observatorio/InformePopup.astro';
import type { Crumb } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  fullWidth?: boolean;
  noindex?: boolean;
  keywords?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
  /** Ruta de migas (absolutas) → BreadcrumbList JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Emite WebSite JSON-LD (solo la home). */
  website?: boolean;
}

const {
  title, description, image, imageAlt, type,
  fullWidth = false, noindex = false,
  keywords, publishedTime, modifiedTime, articleAuthor, articleSection, articleTags,
  breadcrumbs, website = false,
} = Astro.props;

// El popup del informe aparece en todo el sitio salvo en las propias páginas
// de informe (donde el usuario ya está en destino).
const isInformePage = Astro.url.pathname.startsWith('/observatorio/informes');
---

<!doctype html>
<html lang="es-CO">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      keywords={keywords}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleAuthor={articleAuthor}
      articleSection={articleSection}
      articleTags={articleTags}
      breadcrumbs={breadcrumbs}
      website={website}
    />
    <!-- Google Sans Flex: las etiquetas <link> de fuentes viven en SEOHead
         (preconnect + stylesheet). No duplicar aquí. -->
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZFSVVSZG6K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Desactivamos el page_view automático: lo emitimos manualmente en cada
      // navegación con View Transitions para no contar doble la primera carga.
      gtag('config', 'G-ZFSVVSZG6K', { send_page_view: false });

      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', {
          page_path: window.location.pathname,
          page_location: window.location.href,
          page_title: document.title,
        });
      });

      // Event-delegation para medir descargas e interacciones con CTAs.
      // Cualquier elemento con data-ga-event dispara ese evento GA4; los demás
      // atributos data-ga-* se mandan como parámetros. El listener se registra
      // una sola vez (el document persiste entre navegaciones con View Transitions).
      document.addEventListener('click', (e) => {
        const el = e.target.closest && e.target.closest('[data-ga-event]');
        if (!el) return;
        const params = { transport_type: 'beacon' };
        for (const attr of el.attributes) {
          if (attr.name.startsWith('data-ga-') && attr.name !== 'data-ga-event') {
            params[attr.name.slice(8).replace(/-/g, '_')] = attr.value;
          }
        }
        gtag('event', el.getAttribute('data-ga-event'), params);
      });
    </script>
    <!-- ── Estado del sidebar: se aplica antes del primer paint para evitar
         un flash del sidebar abierto cuando el usuario lo dejó plegado. ── -->
    <script is:inline>
      (() => {
        const applySidebarState = () => {
          let collapsed = false;
          try {
            collapsed = localStorage.getItem('sidebar-collapsed') === '1';
          } catch {}
          document.documentElement.toggleAttribute('data-sidebar-collapsed', collapsed);
        };
        applySidebarState();
        if (!window.__sidebarStateBound) {
          window.__sidebarStateBound = true;
          // ClientRouter reemplaza los atributos de <html> en cada navegación.
          document.addEventListener('astro:after-swap', applySidebarState);
        }
      })();
    </script>
    <!-- ── Tema: se aplica antes del primer paint para evitar el destello del
         tema equivocado. La lógica completa vive en src/lib/theme-client.ts. ── -->
    <script is:inline>
      (() => {
        const STORAGE_KEY = 'theme-preference';
        const root = document.documentElement;
        const mq = window.matchMedia('(prefers-color-scheme: dark)');

        const readPreference = () => {
          try {
            const stored = localStorage.getItem(STORAGE_KEY);
            return stored === 'auto' || stored === 'light' || stored === 'dark'
              ? stored
              : 'auto';
          } catch {
            return 'auto';
          }
        };

        const resolve = (preference) => {
          if (preference === 'light') return 'light';
          if (preference === 'dark') return 'dark';
          return mq.matches ? 'dark' : 'light';
        };

        const apply = () => {
          const preference = readPreference();
          const theme = resolve(preference);
          root.dataset.theme = theme;
          root.dataset.themePreference = preference;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute('content', theme === 'dark' ? '#0b1120' : '#f6f8fa');
          }
        };

        apply();
        if (!window.__themePrePaintBound) {
          window.__themePrePaintBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <!-- ── View Transitions: navegación fluida con MPA estático ── -->
    <ClientRouter />
  </head>

  <body>
    <!-- ── Skip to content (accesibilidad): primer elemento enfocable ─── -->
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <div class="layout">
      <!-- ── Sidebar fijo ─────────────────────────────────────────── -->
      <Sidebar />

      <!-- ── Toggle del sidebar (anclado al borde) ────────────────── -->
      <button
        id="sidebar-toggle"
        type="button"
        class="sidebar-toggle"
        aria-controls="site-sidebar"
        aria-expanded="true"
        aria-label="Ocultar menú lateral"
        title="Ocultar menú lateral"
      >
        <svg class="sidebar-toggle__icon sidebar-toggle__icon--close" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg>
        <svg class="sidebar-toggle__icon sidebar-toggle__icon--open" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/></svg>
      </button>

      <!-- ── Contenido principal ──────────────────────────────────── -->
      <main id="main-content" class="layout__main" transition:animate="fade">
        <div class={`layout__content ${fullWidth ? 'layout__content--full' : ''}`}>
          <slot />
        </div>
      </main>
    </div>

    <Footer />

    {!isInformePage && <InformePopup />}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const isCollapsed = () => root.hasAttribute('data-sidebar-collapsed');

        // Refleja el estado en el botón: el mismo control cambia de significado,
        // así que la etiqueta accesible y el tooltip cambian con él.
        const syncToggle = () => {
          const btn = document.getElementById('sidebar-toggle');
          if (!btn) return;
          const collapsed = isCollapsed();
          const label = collapsed ? 'Mostrar menú lateral' : 'Ocultar menú lateral';
          btn.setAttribute('aria-expanded', String(!collapsed));
          btn.setAttribute('aria-label', label);
          btn.setAttribute('title', label);
        };

        if (!window.__sidebarToggleBound) {
          window.__sidebarToggleBound = true;

          document.addEventListener('click', (e) => {
            const btn = e.target.closest && e.target.closest('#sidebar-toggle');
            if (!btn) return;
            const collapsed = !isCollapsed();
            root.toggleAttribute('data-sidebar-collapsed', collapsed);
            try {
              localStorage.setItem('sidebar-collapsed', collapsed ? '1' : '0');
            } catch {}
            syncToggle();
          });

          document.addEventListener('astro:page-load', syncToggle);
        }

        syncToggle();
      })();
    </script>
  </body>
</html>

<style is:global>
  /* ── Design Tokens (Light only) ────────────────────────────────────────── */
  :root {
    --color-bg:           #f6f8fa;
    --color-sidebar:      #ffffff;
    --color-border:       #d0d7de;
    --color-hover:        #eaeef2;
    --color-active-bg:    rgba(37, 99, 235, 0.08);

    --color-text-primary:   #1f2328;
    --color-text-secondary: #424a53;
    --color-text-muted:     #636c76;

    --color-accent:       #2563eb;
    --color-accent-hover: #1d4ed8;
    --color-accent-glow:  rgba(37, 99, 235, 0.15);

    --color-tag-bg:     #eaeef2;
    --color-tag-border: #d0d7de;
    --color-tag-text:   #424a53;

    /* Superficies y código */
    --color-surface:         #ffffff;
    --color-surface-raised:  #ffffff;
    --color-surface-sunken:  #f6f8fa;
    --color-surface-overlay: rgba(255, 255, 255, 0.96);
    --color-code-bg:         #f6f8fa;
    --color-code-border:     #d0d7de;

    /* Acento: texto vs. relleno */
    --color-accent-text:       #2563eb;
    --color-accent-text-hover: #1d4ed8;
    --color-accent-fill:       #2563eb;
    --color-accent-fill-hover: #1d4ed8;
    --color-on-accent:         #ffffff;
    --color-focus:             #2563eb;

    /* Estados */
    --color-status-positive: #16a34a;
    --color-status-warning:  #d97706;
    --color-status-danger:   #dc2626;
    --color-status-info:     #2563eb;

    /* Gráficos */
    --color-chart-grid:      rgba(208, 215, 220, 0.4);
    --color-chart-axis:      #d0d7de;
    --color-chart-hover-bg:  #ffffff;
    --color-chart-text:      #1f2328;
    --color-chart-muted:     #636c76;
    --color-chart-reference: #64748b;

    /* Blueprint / hero */
    --color-blueprint-bg-start: #ffffff;
    --color-blueprint-bg-end:   #f5f8ff;
    --color-blueprint-dot:      rgba(37, 99, 235, 0.18);
    --color-blueprint-border:   rgba(37, 99, 235, 0.18);
    --color-blueprint-glow:     rgba(37, 99, 235, 0.07);
    --color-blueprint-soft:        #dbe5ff;
    --color-blueprint-soft-strong: #cbd5ff;

    /* Texto de estado (deltas, chips) */
    --color-text-success: #15803d;
    --color-text-danger:  #b91c1c;
    --color-text-violet:  #8b5cf6;

    /* Sombras */
    --color-shadow:        rgba(15, 23, 42, 0.08);
    --color-shadow-strong: rgba(15, 23, 42, 0.16);

    /* Ancho físico del sidebar (constante) vs. el hueco que reserva el
       contenido (0 cuando está plegado). Separarlos permite animar el
       desplazamiento sin deformar el propio sidebar. */
    --sidebar-size: 240px;
    --sidebar-width: var(--sidebar-size);
    --sidebar-toggle-left: calc(var(--sidebar-size) - 16px);
    --content-max-width: 90%;

    --font-sans: 'Google Sans Flex', 'Google Sans', system-ui, -apple-system, sans-serif;
    --font-serif: 'Google Sans Flex', 'Google Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'Google Sans Flex', 'Google Sans', system-ui, -apple-system, sans-serif;

    color-scheme: light;
  }

  /* ── Design Tokens (Dark) ──────────────────────────────────────────────── */
  :root[data-theme="dark"] {
    --color-bg:           #0b1120;
    --color-sidebar:      #131c2e;
    --color-border:       #2a3649;
    --color-hover:        #1c2638;
    --color-active-bg:    rgba(96, 165, 250, 0.14);

    --color-text-primary:   #f1f5f9;
    --color-text-secondary: #cbd5e1;
    --color-text-muted:     #94a3b8;

    --color-accent:       #2563eb;
    --color-accent-hover: #3b82f6;
    --color-accent-glow:  rgba(96, 165, 250, 0.18);

    --color-tag-bg:     #1a2438;
    --color-tag-border: #2a3649;
    --color-tag-text:   #cbd5e1;

    --color-surface:         #131c2e;
    --color-surface-raised:  #1a2438;
    --color-surface-sunken:  #0a0f1c;
    --color-surface-overlay: rgba(11, 17, 32, 0.92);
    --color-code-bg:         #0a0f1c;
    --color-code-border:     #2a3649;

    --color-accent-text:       #60a5fa;
    --color-accent-text-hover: #93c5fd;
    --color-accent-fill:       #2563eb;
    --color-accent-fill-hover: #3b82f6;
    --color-on-accent:         #ffffff;
    --color-focus:             #60a5fa;

    --color-status-positive: #4ade80;
    --color-status-warning:  #fbbf24;
    --color-status-danger:   #f87171;
    --color-status-info:     #60a5fa;

    --color-chart-grid:      rgba(148, 163, 184, 0.18);
    --color-chart-axis:      #334155;
    --color-chart-hover-bg:  #1a2438;
    --color-chart-text:      #f1f5f9;
    --color-chart-muted:     #94a3b8;
    --color-chart-reference: #94a3b8;

    --color-blueprint-bg-start: #0d1427;
    --color-blueprint-bg-end:   #13203d;
    --color-blueprint-dot:      rgba(96, 165, 250, 0.22);
    --color-blueprint-border:   rgba(96, 165, 250, 0.25);
    --color-blueprint-glow:     rgba(59, 130, 246, 0.12);
    --color-blueprint-soft:        #1c2a4a;
    --color-blueprint-soft-strong: #24365e;

    --color-text-success: #4ade80;
    --color-text-danger:  #f87171;
    --color-text-violet:  #c4b5fd;

    --color-shadow:        rgba(0, 0, 0, 0.45);
    --color-shadow-strong: rgba(0, 0, 0, 0.6);

    color-scheme: dark;
  }

  /* Sin JavaScript: seguir la preferencia del sistema. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --color-bg:           #0b1120;
      --color-sidebar:      #131c2e;
      --color-border:       #2a3649;
      --color-hover:        #1c2638;
      --color-active-bg:    rgba(96, 165, 250, 0.14);

      --color-text-primary:   #f1f5f9;
      --color-text-secondary: #cbd5e1;
      --color-text-muted:     #94a3b8;

      --color-accent:       #2563eb;
      --color-accent-hover: #3b82f6;
      --color-accent-glow:  rgba(96, 165, 250, 0.18);

      --color-tag-bg:     #1a2438;
      --color-tag-border: #2a3649;
      --color-tag-text:   #cbd5e1;

      --color-surface:         #131c2e;
      --color-surface-raised:  #1a2438;
      --color-surface-sunken:  #0a0f1c;
      --color-surface-overlay: rgba(11, 17, 32, 0.92);
      --color-code-bg:         #0a0f1c;
      --color-code-border:     #2a3649;

      --color-accent-text:       #60a5fa;
      --color-accent-text-hover: #93c5fd;
      --color-accent-fill:       #2563eb;
      --color-accent-fill-hover: #3b82f6;
      --color-on-accent:         #ffffff;
      --color-focus:             #60a5fa;

      --color-status-positive: #4ade80;
      --color-status-warning:  #fbbf24;
      --color-status-danger:   #f87171;
      --color-status-info:     #60a5fa;

      --color-chart-grid:      rgba(148, 163, 184, 0.18);
      --color-chart-axis:      #334155;
      --color-chart-hover-bg:  #1a2438;
      --color-chart-text:      #f1f5f9;
      --color-chart-muted:     #94a3b8;
      --color-chart-reference: #94a3b8;

      --color-blueprint-bg-start: #0d1427;
      --color-blueprint-bg-end:   #13203d;
      --color-blueprint-dot:      rgba(96, 165, 250, 0.22);
      --color-blueprint-border:   rgba(96, 165, 250, 0.25);
      --color-blueprint-glow:     rgba(59, 130, 246, 0.12);
      --color-blueprint-soft:        #1c2a4a;
      --color-blueprint-soft-strong: #24365e;

      --color-text-success: #4ade80;
      --color-text-danger:  #f87171;
      --color-text-violet:  #c4b5fd;

      --color-shadow:        rgba(0, 0, 0, 0.45);
      --color-shadow-strong: rgba(0, 0, 0, 0.6);

      color-scheme: dark;
    }
  }

  /* ── Reset & Base ───────────────────────────────────────────────────────── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-sans);
    background-color: var(--color-bg);
    color: var(--color-text-primary);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100dvh;
    line-height: 1.6;
  }

  /* ── Layout: Sidebar + Main ─────────────────────────────────────────────── */
  .layout {
    display: flex;
    min-height: 100dvh;
  }

  .layout__main {
    flex: 1;
    /* Sin esto el ítem flex crece hasta el min-content de su contenido (p. ej. el
       menú horizontal del Observatorio) y desborda el viewport; `overflow-x: clip`
       no lo evita porque no crea un contenedor de scroll. */
    min-width: 0;
    margin-left: var(--sidebar-width);
    min-height: 100dvh;
    overflow-x: clip;
    transition: margin-left 0.25s ease;
  }

  /* ── Sidebar plegable ───────────────────────────────────────────────────── */
  :root[data-sidebar-collapsed] {
    --sidebar-width: 0px;
    --sidebar-toggle-left: 0.75rem;
  }

  .sidebar {
    transition: transform 0.25s ease, visibility 0.25s;
  }

  :root[data-sidebar-collapsed] .sidebar {
    transform: translateX(-100%);
    /* Saca los enlaces del orden de tabulación mientras está oculto. */
    visibility: hidden;
  }

  .sidebar-toggle {
    position: fixed;
    top: 1.5rem;
    left: var(--sidebar-toggle-left);
    z-index: 101;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-sidebar);
    color: var(--color-text-muted);
    cursor: pointer;
    box-shadow: 0 1px 3px var(--color-shadow);
    transition: left 0.25s ease, background-color 0.15s ease,
      color 0.15s ease, border-color 0.15s ease;
  }

  .sidebar-toggle:hover {
    background: var(--color-hover);
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .sidebar-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .sidebar-toggle__icon--open,
  :root[data-sidebar-collapsed] .sidebar-toggle__icon--close {
    display: none;
  }

  :root[data-sidebar-collapsed] .sidebar-toggle__icon--open {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .layout__main,
    .sidebar,
    .sidebar-toggle {
      transition: none;
    }
  }

  .layout__content {
    width: 100%;
    max-width: var(--content-max-width);
    padding: 3rem 2.5rem;
    margin: 0 auto;
  }
  
  .layout__content--full {
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  /* ── Mobile responsive ──────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .layout {
      flex-direction: column;
    }
    .layout__main {
      margin-left: 0;
    }
    .layout__content {
      padding: 1.5rem 1.25rem;
    }
    /* En móvil el sidebar es una barra superior con la navegación completa:
       ocultarla dejaría al usuario sin menú, así que el toggle no aplica. */
    .sidebar-toggle {
      display: none;
    }
    :root[data-sidebar-collapsed] .sidebar {
      transform: none;
      visibility: visible;
    }
  }

  /* ── Accesibilidad: Skip Link ───────────────────────────────────────────── */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    background: var(--color-accent-fill);
    color: var(--color-on-accent);
    padding: 0.5rem 1rem;
    border-radius: 0 0 0.5rem 0.5rem;
    text-decoration: none;
    font-size: 0.875rem;
    z-index: 9999;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 0;
  }

  /* ── Tipografía global ──────────────────────────────────────────────────── */
  h1, h2, h3, h4, h5, h6 {
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  a {
    color: var(--color-accent-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--color-accent-text-hover);
  }

  code, pre {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  /* ── Tags / Pills reutilizables ─────────────────────────────────────────── */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    background: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
    border-radius: 0.375rem;
    font-size: 0.775rem;
    font-family: var(--font-mono);
    color: var(--color-tag-text);
    font-weight: 500;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .tag:hover {
    border-color: var(--color-accent-text);
    color: var(--color-accent-text);
  }

  /* ── Pill (hero pills) — redondo, fondo blanco, borde azul ─────────────── */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-blueprint-border);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent-text);
    box-shadow: 0 1px 2px var(--color-shadow);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pill:hover {
    border-color: var(--color-accent-text);
    transform: translateY(-2px);
