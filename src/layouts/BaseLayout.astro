---
/**
 * BaseLayout.astro
 * Layout principal: Sidebar fijo izquierdo + área de contenido derecha.
 * Incluye ViewTransitions (ClientRouter) para navegación fluida tipo SPA
 * con arquitectura MPA estática y máxima indexabilidad SEO.
 */
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  fullWidth?: boolean;
  noindex?: boolean;
  keywords?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title, description, image, imageAlt, type,
  fullWidth = false, noindex = false,
  keywords, publishedTime, modifiedTime, articleAuthor, articleSection, articleTags,
} = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      keywords={keywords}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleAuthor={articleAuthor}
      articleSection={articleSection}
      articleTags={articleTags}
    />
    <!-- Google Sans Flex -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@100..900&display=swap" rel="stylesheet" />
    <!-- Google tag (gtag.js) -->
    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-ZFSVVSZG6K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-ZFSVVSZG6K');

      // Monitoreo de navegación fluida (View Transitions)
      document.addEventListener('astro:page-load', () => {
        gtag('config', 'G-ZFSVVSZG6K', {
          page_path: window.location.pathname,
        });
      });
    </script>
    <!-- ── View Transitions: navegación fluida con MPA estático ── -->
    <ClientRouter />
  </head>

  <body>
    <div class="layout">
      <!-- ── Sidebar fijo ─────────────────────────────────────────── -->
      <Sidebar />

      <!-- ── Contenido principal ──────────────────────────────────── -->
      <main id="main-content" class="layout__main" transition:animate="fade">
        <div class={`layout__content ${fullWidth ? 'layout__content--full' : ''}`}>
          <slot />
        </div>
      </main>
    </div>

    <!-- ── Skip to content (accesibilidad) ────────────────────────── -->
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    
    <Footer />
  </body>
</html>

<style is:global>
  /* ── Design Tokens (Light only) ────────────────────────────────────────── */
  :root {
    --color-bg:           #f6f8fa;
    --color-sidebar:      #ffffff;
    --color-border:       #d0d7de;
    --color-hover:        #eaeef2;
    --color-active-bg:    rgba(37, 99, 235, 0.08);

    --color-text-primary:   #1f2328;
    --color-text-secondary: #424a53;
    --color-text-muted:     #636c76;

    --color-accent:       #2563eb;
    --color-accent-hover: #1d4ed8;
    --color-accent-glow:  rgba(37, 99, 235, 0.15);

    --color-tag-bg:     #eaeef2;
    --color-tag-border: #d0d7de;
    --color-tag-text:   #424a53;

    --sidebar-width: 240px;
    --content-max-width: 90%;

    --font-sans: 'Google Sans Flex', 'Google Sans', system-ui, -apple-system, sans-serif;
    --font-serif: 'Google Sans Flex', 'Google Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'Google Sans Flex', 'Google Sans', system-ui, -apple-system, sans-serif;

    color-scheme: light;
  }

  /* ── Reset & Base ───────────────────────────────────────────────────────── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-sans);
    background-color: var(--color-bg);
    color: var(--color-text-primary);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100dvh;
    line-height: 1.6;
  }

  /* ── Layout: Sidebar + Main ─────────────────────────────────────────────── */
  .layout {
    display: flex;
    min-height: 100dvh;
  }

  .layout__main {
    flex: 1;
    margin-left: var(--sidebar-width);
    min-height: 100dvh;
    overflow-x: clip;
  }

  .layout__content {
    width: 100%;
    max-width: var(--content-max-width);
    padding: 3rem 2.5rem;
    margin: 0 auto;
  }
  
  .layout__content--full {
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  /* ── Mobile responsive ──────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .layout {
      flex-direction: column;
    }
    .layout__main {
      margin-left: 0;
    }
    .layout__content {
      padding: 1.5rem 1.25rem;
    }
  }

  /* ── Accesibilidad: Skip Link ───────────────────────────────────────────── */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    background: var(--color-accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0 0 0.5rem 0.5rem;
    text-decoration: none;
    font-size: 0.875rem;
    z-index: 9999;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 0;
  }

  /* ── Tipografía global ──────────────────────────────────────────────────── */
  h1, h2, h3, h4, h5, h6 {
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--color-accent-hover);
  }

  code, pre {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  /* ── Tags / Pills reutilizables ─────────────────────────────────────────── */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    background: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
    border-radius: 0.375rem;
    font-size: 0.775rem;
    font-family: var(--font-mono);
    color: var(--color-tag-text);
    font-weight: 500;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ── Pill (hero pills) — redondo, fondo blanco, borde azul ─────────────── */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: white;
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pill:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px var(--color-accent-glow);
  }

  /* ── Badge (category badges) — variantes de azul por categoría ──────────── */
  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
  }
  .badge--data-analysis    { background: rgba(37, 99, 235, 0.08); color: #2563eb; }
  .badge--ml               { background: rgba(37, 99, 235, 0.12); color: #1d4ed8; }
  .badge--software         { background: rgba(37, 99, 235, 0.06); color: #3b82f6; }
  .badge--data-engineering { background: rgba(37, 99, 235, 0.15); color: #1e40af; }

  /* ── Section label (estilo "TECHNOLOGIES & TOOLS") ──────────────────────── */
  .section-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: block;
  }

  /* ── View Transitions: animación de fade entre páginas ─────────────────── */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.2s;
  }
</style>
